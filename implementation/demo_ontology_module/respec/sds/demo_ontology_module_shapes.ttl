not-shape:epo-not-CompetitionNoticeShape a sh:NodeShape ;
    rdfs:label "Competition Notice" ;
    rdfs:comment "An announcement of the launch of a Procurement Procedure by a Procuring Entity. WG approval 18/05/2018" ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:property not-shape:epo-not-CompetitionNotice-epo-announcesLot,
        not-shape:epo-not-CompetitionNotice-epo-announcesLotGroup,
        not-shape:epo-not-CompetitionNotice-epo-announcesProcedure,
        not-shape:epo-not-CompetitionNotice-epo-announcesRole ;
    sh:targetClass :CompetitionNotice .

not-shape:epo-not-CompletionNoticeShape a sh:NodeShape ;
    rdfs:label "Completion Notice" ;
    rdfs:comment "An announcement of the end of a Procurement by a Buyer." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:property not-shape:epo-not-CompletionNotice-epo-announcesCompletionOfContract,
        not-shape:epo-not-CompletionNotice-epo-announcesReviewObject,
        not-shape:epo-not-CompletionNotice-epo-announcesRole,
        not-shape:epo-not-CompletionNotice-epo-refersToAwardDecision,
        not-shape:epo-not-CompletionNotice-epo-refersToLot,
        not-shape:epo-not-CompletionNotice-epo-refersToLotGroup,
        not-shape:epo-not-CompletionNotice-epo-refersToLotGroupAwardInformation,
        not-shape:epo-not-CompletionNotice-epo-refersToNoticeAwardInformation,
        not-shape:epo-not-CompletionNotice-epo-refersToProcedure,
        not-shape:epo-not-CompletionNotice-epo-refersToRole ;
    sh:targetClass :CompletionNotice .

