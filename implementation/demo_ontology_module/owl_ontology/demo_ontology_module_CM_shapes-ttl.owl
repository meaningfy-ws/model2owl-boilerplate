        core-shape:epo-not-ContractModificationNotice-epo-refersToAwardDecision,
        core-shape:epo-not-ContractModificationNotice-epo-refersToContractToBeModified,
        core-shape:epo-not-ContractModificationNotice-epo-refersToLot,
        core-shape:epo-not-ContractModificationNotice-epo-refersToLotGroup,
        core-shape:epo-not-ContractModificationNotice-epo-refersToLotGroupAwardInformation,
        core-shape:epo-not-ContractModificationNotice-epo-refersToNoticeAwardInformation,
        core-shape:epo-not-ContractModificationNotice-epo-refersToProcedure ;
