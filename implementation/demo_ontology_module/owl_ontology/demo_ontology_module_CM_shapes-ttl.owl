    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:epo-not-PlanningNotice-epo-announcesPlannedProcurementPart,
        core-shape:epo-not-PlanningNotice-epo-announcesRole ;
    sh:targetClass :PlanningNotice .

