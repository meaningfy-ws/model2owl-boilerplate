core-shape:epo-not-CompetitionNotice a owl:NamedIndividual,
        sh:NodeShape ;
    rdfs:label "Competition Notice" ;
    rdfs:comment "An announcement of the launch of a Procurement Procedure by a Procuring Entity. WG approval 18/05/2018" ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:epo-not-CompetitionNotice-epo-announcesLot,
        core-shape:epo-not-CompetitionNotice-epo-announcesLotGroup,
        core-shape:epo-not-CompetitionNotice-epo-announcesProcedure,
        core-shape:epo-not-CompetitionNotice-epo-announcesRole ;
    sh:targetClass :CompetitionNotice .

core-shape:epo-not-CompletionNotice a owl:NamedIndividual,
        sh:NodeShape ;
    rdfs:label "Completion Notice" ;
    rdfs:comment "An announcement of the end of a Procurement by a Buyer." ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:property core-shape:epo-not-CompletionNotice-epo-announcesCompletionOfContract,
        core-shape:epo-not-CompletionNotice-epo-announcesReviewObject,
        core-shape:epo-not-CompletionNotice-epo-announcesRole,
        core-shape:epo-not-CompletionNotice-epo-refersToAwardDecision,
        core-shape:epo-not-CompletionNotice-epo-refersToLot,
        core-shape:epo-not-CompletionNotice-epo-refersToLotGroup,
        core-shape:epo-not-CompletionNotice-epo-refersToLotGroupAwardInformation,
        core-shape:epo-not-CompletionNotice-epo-refersToNoticeAwardInformation,
        core-shape:epo-not-CompletionNotice-epo-refersToProcedure,
        core-shape:epo-not-CompletionNotice-epo-refersToRole ;
    sh:targetClass :CompletionNotice .

