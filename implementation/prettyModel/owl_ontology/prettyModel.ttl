@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AssocClass1 a owl:Class ;
    rdfs:isDefinedBy :prettyModel ;
    skos:prefLabel "Assoc Class1"@en .

:Bicycle a owl:Class ;
