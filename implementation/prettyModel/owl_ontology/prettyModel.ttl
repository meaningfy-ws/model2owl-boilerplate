:prettyModel a owl:Ontology ;
    rdfs:label "prettyModel — core"@en ;
    dcterms:created "2024-01-01"^^xsd:date ;
    dcterms:description """This artefact provides the definitions for the prettyModel demonstration ontology.
        This artefact excludes the restrictions.
        prettyModel is a sample non-ePO UML conceptual model used to exercise the model2owl transformation pipeline in CI."""@en ;
