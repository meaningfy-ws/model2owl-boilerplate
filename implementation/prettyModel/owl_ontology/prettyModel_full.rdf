    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-01</dcterms:created>
    <dcterms:description xml:lang="en">This artefact consolidates both the definitions (OWL core) and the restrictions and inference-related specifications (OWL restrictions) of the prettyModel demonstration ontology into a single self-contained ontology.
        prettyModel is a sample non-ePO UML conceptual model used to exercise the model2owl transformation pipeline in CI.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-29</dcterms:issued>
