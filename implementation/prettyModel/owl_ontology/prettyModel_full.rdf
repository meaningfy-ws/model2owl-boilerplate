    <dcterms:publisher>https://example.com/publisher</dcterms:publisher>
    <dcterms:title xml:lang="en">prettyModel full</dcterms:title>
    <vann:preferredNamespacePrefix>ex</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://example.com/ex#</vann:preferredNamespaceUri>
