<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.com/ex#prettyModel-restriction#"
     xml:base="http://example.com/ex#prettyModel-restriction"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:org="http://www.w3.org/ns/org#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:adms="http://www.w3.org/ns/adms#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:locn="http://www.w3.org/ns/locn#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:legal="http://www.w3.org/ns/legal-entity#"
     xmlns:person="http://www.w3.org/ns/person#"
     xmlns:schema="http://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:geosparql="http://www.opengis.net/ont/geosparql#"
     xmlns:prettyModel-res="http://example.com/ex#"
     xmlns:prettyModel-shape="http://example.com/ex-shape#">
    <owl:Ontology rdf:about="http://example.com/ex#prettyModel-restriction">
        <owl:versionIRI rdf:resource="http://example.com/ex#prettyModel-restriction-1.0.0"/>
        <owl:imports rdf:resource="http://example.com/ex#prettyModel"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-01</dcterms:created>
        <dcterms:description xml:lang="en">This artefact provides the restrictions and inference-related specifications for the prettyModel demonstration ontology.
        This artefact excludes the definitions of concepts.
        prettyModel is a sample non-ePO UML conceptual model used to exercise the model2owl transformation pipeline in CI.</dcterms:description>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-30</dcterms:issued>
        <dcterms:license>CC BY 4.0</dcterms:license>
        <dcterms:publisher>https://example.com/publisher</dcterms:publisher>
        <dcterms:title xml:lang="en">prettyModel restrictions</dcterms:title>
        <vann:preferredNamespacePrefix>ex</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://example.com/ex#</vann:preferredNamespaceUri>
        <rdfs:comment>This version is automatically generated from prettyModel.xml on 
                2026-06-30</rdfs:comment>
        <rdfs:label xml:lang="en">prettyModel — restrictions</rdfs:label>
        <owl:incompatibleWith></owl:incompatibleWith>
        <owl:priorVersion>http://example.com/ex#prettyModel-restriction-</owl:priorVersion>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2002/07/owl#qualifiedCardinality -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#qualifiedCardinality"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.com/ex#for -->

    <rdf:Description rdf:about="http://example.com/ex#for">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.com/ex#SomeOtherClass"/>
                    <rdf:Description rdf:about="http://example.com/ex#Vehicle"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </rdf:Description>
    


    <!-- http://example.com/ex#forSub -->

    <rdf:Description rdf:about="http://example.com/ex#forSub">
        <rdfs:domain rdf:resource="http://example.com/ex#Insurance"/>
        <rdfs:range rdf:resource="http://example.com/ex#Boat"/>
    </rdf:Description>
    


    <!-- http://example.com/ex#hasIns -->

    <rdf:Description rdf:about="http://example.com/ex#hasIns">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.com/ex#SomeOtherClass"/>
                    <rdf:Description rdf:about="http://example.com/ex#Vehicle"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.com/ex#Insurance"/>
    </rdf:Description>
    


    <!-- http://example.com/ex#hasInsSub -->

    <rdf:Description rdf:about="http://example.com/ex#hasInsSub">
        <rdfs:domain rdf:resource="http://example.com/ex#Boat"/>
        <rdfs:range rdf:resource="http://example.com/ex#Insurance"/>
    </rdf:Description>
    


    <!-- http://example.com/ex#lends -->

    <rdf:Description rdf:about="http://example.com/ex#lends">
        <rdfs:domain rdf:resource="http://example.com/ex#RentalCompany"/>
        <rdfs:range rdf:resource="http://example.com/ex#Vehicle"/>
    </rdf:Description>
    


    <!-- http://example.com/ex#name -->

    <owl:ObjectProperty rdf:about="http://example.com/ex#name">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.com/ex#AssocClass1"/>
                    <rdf:Description rdf:about="http://example.com/ex#RentalCompany"/>
                    <rdf:Description rdf:about="http://example.com/ex#Vehicle"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.com/ex#long"/>
                    <rdf:Description rdf:about="http://example.com/ex#short"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://example.com/ex#ownedby -->

    <rdf:Description rdf:about="http://example.com/ex#ownedby">
        <rdfs:domain rdf:resource="http://example.com/ex#Vehicle"/>
        <rdfs:range rdf:resource="http://example.com/ex#RentalCompany"/>
    </rdf:Description>
    


    <!-- http://example.com/ex#source -->

    <rdf:Description rdf:about="http://example.com/ex#source">
        <rdfs:domain rdf:resource="http://example.com/ex#SomeOtherClass"/>
        <rdfs:range rdf:resource="http://example.com/ex#ClassForQualAssoc"/>
    </rdf:Description>
    


    <!-- http://example.com/ex#target -->

    <rdf:Description rdf:about="http://example.com/ex#target">
        <rdfs:domain rdf:resource="http://example.com/ex#ClassForQualAssoc"/>
        <rdfs:range rdf:resource="http://example.com/ex#SomeOtherClass"/>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.com/ex#colour -->

    <owl:DatatypeProperty rdf:about="http://example.com/ex#colour">
        <rdfs:domain rdf:resource="http://example.com/ex#Cycle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.com/ex#date -->

    <owl:DatatypeProperty rdf:about="http://example.com/ex#date">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.com/ex#AssocClass1"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.com/ex#engravedID -->

    <owl:DatatypeProperty rdf:about="http://example.com/ex#engravedID">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.com/ex#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.com/ex#nickName -->

    <owl:DatatypeProperty rdf:about="http://example.com/ex#nickName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.com/ex#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#long"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.com/ex#AssocClass1 -->

    <rdf:Description rdf:about="http://example.com/ex#AssocClass1">
        <rdfs:subClassOf rdf:resource="http://org.semanticweb.owlapi/error#Error3"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ex#date"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://example.com/ex#Boat -->

    <rdf:Description rdf:about="http://example.com/ex#Boat">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ex#hasInsSub"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.com/ex#Insurance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://example.com/ex#Cycle -->

    <rdf:Description rdf:about="http://example.com/ex#Cycle">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ex#colour"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ex#colour"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://example.com/ex#Insurance -->

    <rdf:Description rdf:about="http://example.com/ex#Insurance">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ex#for"/>
                <owl:someValuesFrom rdf:resource="http://example.com/ex#Vehicle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://example.com/ex#RentalCompany -->

    <rdf:Description rdf:about="http://example.com/ex#RentalCompany">
        <rdfs:subClassOf rdf:resource="http://org.semanticweb.owlapi/error#Error2"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ex#lends"/>
                <owl:someValuesFrom rdf:resource="http://example.com/ex#Vehicle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://example.com/ex#Vehicle -->

    <rdf:Description rdf:about="http://example.com/ex#Vehicle">
        <rdfs:subClassOf rdf:resource="http://org.semanticweb.owlapi/error#Error1"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ex#engravedID"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ex#nickName"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#long"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://example.com/ex#long -->

    <owl:Class rdf:about="http://example.com/ex#long"/>
    


    <!-- http://example.com/ex#short -->

    <owl:Class rdf:about="http://example.com/ex#short"/>
    


    <!-- http://org.semanticweb.owlapi/error#Error1 -->

    <owl:Class rdf:about="http://org.semanticweb.owlapi/error#Error1"/>
    


    <!-- http://org.semanticweb.owlapi/error#Error2 -->

    <owl:Class rdf:about="http://org.semanticweb.owlapi/error#Error2"/>
    


    <!-- http://org.semanticweb.owlapi/error#Error3 -->

    <owl:Class rdf:about="http://org.semanticweb.owlapi/error#Error3"/>
    <rdf:Description>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:qualifiedCardinality>
    </rdf:Description>
    <rdf:Description>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:qualifiedCardinality>
    </rdf:Description>
    <rdf:Description>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:qualifiedCardinality>
    </rdf:Description>
</rdf:RDF>



