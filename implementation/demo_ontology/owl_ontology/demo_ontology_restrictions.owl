        <rdfs:comment xml:lang="en">The sequence position of the Public Event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">event number</rdfs:label>
        <skos:scopeNote xml:lang="en">Examples could be the &apos;&apos;4th&quot; or &quot;2022&quot;.</skos:scopeNote>
