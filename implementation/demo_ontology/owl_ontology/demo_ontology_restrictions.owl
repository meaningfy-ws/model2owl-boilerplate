    </rdf:Description>
    


    <!-- http://data.europa.eu/a4g/ontology#summarisesInformationForAwardOutcome -->

    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#summarisesInformationForAwardOutcome">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#SubmissionStatisticalInformation"/>
        <rdfs:range rdf:resource="http://data.europa.eu/a4g/ontology#AwardOutcome"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/a4g/ontology#updatesContractValue -->

    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#updatesContractValue">
        <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#ContractAmendment"/>
        <rdfs:range rdf:resource="http://data.europa.eu/a4g/ontology#MonetaryValue"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/a4g/ontology#usesChannel -->

    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#usesChannel">
        <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/Channel"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/a4g/ontology#usesEvaluationFormula -->

    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#usesEvaluationFormula">
        <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#EvaluationReport"/>
        <rdfs:range rdf:resource="http://data.europa.eu/a4g/ontology#AwardEvaluationTerm"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/a4g/ontology#usesTechnique -->

    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#usesTechnique">
        <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementObject"/>
        <rdfs:range rdf:resource="http://data.europa.eu/a4g/ontology#Technique"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/eli/ontology#uri_schema -->

    <rdf:Description rdf:about="http://data.europa.eu/eli/ontology#uri_schema">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://data.europa.eu/eli/ontology#LegalExpression"/>
                    <rdf:Description rdf:about="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/ns/adms#Identifier"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/m8g/audience -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/audience">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/PublicEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The target group of people for whom the Public Event is created.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">audience</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/birthDate -->

    <rdf:Description rdf:about="http://data.europa.eu/m8g/birthDate">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/person#Person"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/GenericDate"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/m8g/code -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/code">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/AdminUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The classification of the administrative unit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">code</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/confidentialityLevelType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/confidentialityLevelType">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Evidence"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Response"/>
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/Evidence"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Security classification assigned to an Evidence e.g. classified, sensitive, public.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">confidentiality level type</rdfs:label>
        <skos:scopeNote xml:lang="en">Classifications should be defined by an organisation/country as an outcome of a security assessment.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/constrains -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/constrains">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Constraint"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/InformationConcept"/>
        <rdfs:comment xml:lang="en">Information Concept about which a Constraint expresses a limitation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">constrains</rdfs:label>
        <skos:scopeNote xml:lang="en">Information Concepts are tools to make Requirements more machine processable: they allow to provide more detail about a Requirement. This way, Constraints can be made very precise, namely the limit that must be achieved, is a limit on the value for the associated Information Concept. For example, the Information Concept would be the age of a person and the Constraint would be the required age in the context of a specific evaluation.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/contactPage -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/contactPage">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/ContactPoint"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <rdfs:comment xml:lang="en">A web page that could be used to reach out the Contact Point.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">contact page</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/contactPoint -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/contactPoint">
        <rdfs:comment xml:lang="en">The main contact information of the resource.</rdfs:comment>
        <rdfs:label xml:lang="en">contact point</rdfs:label>
        <skos:scopeNote xml:lang="en">Note that the contact information should be relevant to the Public Service which may not be the same as contact information for the Competent Authority or any Participant.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/currency -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/currency">
        <rdfs:comment xml:lang="en">The currency in which the Cost needs to be paid and the value of the Cost is expressed.</rdfs:comment>
        <rdfs:label xml:lang="en">currency</rdfs:label>
        <skos:scopeNote xml:lang="en">The possible values for this property are described in the controlled vocabulary 
&lt;a href=&quot;https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/currency&quot;&gt;Currency&lt;/a&gt; Authority Table of Publications Office.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/deathDate -->

    <rdf:Description rdf:about="http://data.europa.eu/m8g/deathDate">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/person#Person"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/GenericDate"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/m8g/establishedUnder -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/establishedUnder">
        <rdfs:comment xml:lang="en">It links a Service Concession Contract to relevant legislation or policy documents i.e.
the Legal Resource under which the Service Concession Contracts are being defined.</rdfs:comment>
        <rdfs:label xml:lang="en">established under</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/eventStatus -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/eventStatus">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/PublicEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en"> This property defines the overall status of the event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">event status</rdfs:label>
        <skos:scopeNote xml:lang="en">The recomended code list is the &lt;a href=&quot;https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/event-status&quot;&gt;  Event Status Controlled vocabulary &lt;/a&gt; maintained by the Publications Office of the EU.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/evidenceTypeClassification -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/evidenceTypeClassification">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/EvidenceType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Category to which the Evidence Type belongs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">evidence type classification</rdfs:label>
        <skos:scopeNote xml:lang="en">The categories agreed are left open but could for example specify the layout and content expected for an Evidence.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The categories agreed are left open but could for example specify the layout and content expected for an Evidence. An example could be id cards.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/format -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/format">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/PublicEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A plan of organisation or arrangement of the Public Event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">format</rdfs:label>
        <skos:scopeNote xml:lang="en">Examples include conference call, physical meeting or hybrid.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/frequency -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/frequency">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The recurrence of an instant or period.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">frequency</rdfs:label>
        <skos:scopeNote xml:lang="en">It is recommended to use the frequency from an existing vocabulary like the &lt;a href=&quot;https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/frequency&quot;&gt;Frequency&lt;/a&gt; from the Publications Office.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/fulfils -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/fulfils">
        <rdfs:comment xml:lang="en">The Rules that the requiremens fulfils.</rdfs:comment>
        <rdfs:label xml:lang="en">fulfils</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/gender -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/gender">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/person#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The identities, expressions and societal roles of the Person.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">gender</rdfs:label>
        <skos:scopeNote xml:lang="en">The gender of an individual should be recorded using a controlled vocabulary that is appropriate for the specific context. In some cases, the chromosomal or physical state of an individual will be more important than the gender that they express, in others the reverse will be true. What is always important is that the controlled vocabulary used to describe an individual&apos;s gender is stated explicitly.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/geometryType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/geometryType">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/locn#Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The classification of the Geometry.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">geometry type</rdfs:label>
        <skos:scopeNote xml:lang="en">Can be a point, line or polygon.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasChannel -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasChannel">
        <rdfs:comment xml:lang="en">It links the Public Service to any Channel through which an Agent provides, uses or otherwise interacts with the Public Service, such as an online service, phone number or office.</rdfs:comment>
        <rdfs:label xml:lang="en">has channel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasCompetentAuthority -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasCompetentAuthority">
        <rdfs:comment xml:lang="en">It links a Public Service to a Public Organization, which is the responsible Agent for the delivery of the Public Service.</rdfs:comment>
        <rdfs:label xml:lang="en">has competent authority</rdfs:label>
        <skos:scopeNote xml:lang="en">Whether the particular Public Organization provides the public service directly or outsources it is not relevant. The Public Organization that is the Competent Authority of the service is the one that is ultimately responsible for managing and providing the public service. The term Competent Authority is defined in the Services Directive (2006/123/EC) in the following way: &quot;Any body or authority which has a supervisory or regulatory role in a Member State in relation to service activities, including, in particular, administrative authorities, including courts acting as such, professional bodies, and those professional associations or other professional organisations which, in the exercise of their legal autonomy, regulate in a collective manner access to service activities or the exercise thereof&quot;.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasConcept -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasConcept">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/InformationConcept"/>
        <rdfs:comment xml:lang="en">Information Concept for which a value is expected by the Requirement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">has concept</rdfs:label>
        <skos:scopeNote xml:lang="en">Information Concepts defined for specific Requirements also represent the basis for specifying the Supported Value an Evidence should provide.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasContractingAuthority -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasContractingAuthority">
        <rdfs:comment xml:lang="en">It links a Service Concession Contract with the Contracting Authority which is ultimately responsible for a public service.</rdfs:comment>
        <rdfs:label xml:lang="en">has contracting authority</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasCost -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasCost">
        <rdfs:comment xml:lang="en">It indicates the costs related to the execution of a Public Service for the citizen or business related to the execution of the particular Public Service.</rdfs:comment>
        <rdfs:label xml:lang="en">has cost</rdfs:label>
        <skos:scopeNote xml:lang="en">Where the cost varies depending on the channel through which the service is accessed, it can be linked to the channel using the If Accessed Through relationship.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasEconomicOperator -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasEconomicOperator">
        <rdfs:comment xml:lang="en">It links a Service Concession Contract with the Economic Operator in charge for the provision and the management of public services.</rdfs:comment>
        <rdfs:label xml:lang="en">has economic operator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasEvidenceTypeList -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasEvidenceTypeList">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/EvidenceTypeList"/>
        <rdfs:comment xml:lang="en">Evidence Type List that specifies the Evidence Types that are needed to meet the Requirement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">has evidence type list</rdfs:label>
        <skos:scopeNote xml:lang="en">One or several Lists of Evidence Types can support a Requirement. At least  one of them must be satisfied by the response to the Requirement.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasInputType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasInputType">
        <rdfs:comment xml:lang="en">It links a Public Service to one or more instances of the EvidenceType class.</rdfs:comment>
        <rdfs:label xml:lang="en">has input type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasLegalResource -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasLegalResource">
        <rdfs:comment xml:lang="en">It indicates the Legal Resource (e.g. legislation) to which the Public Service relates, operates or has its legal basis.</rdfs:comment>
        <rdfs:label xml:lang="en">has legal resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasParticipant -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasParticipant">
        <rdfs:comment xml:lang="en">The Agent involved in the Participation.</rdfs:comment>
        <rdfs:label xml:lang="en">has participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasParticipation -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasParticipation">
        <rdfs:comment xml:lang="en">The way how a resource is organized.</rdfs:comment>
        <rdfs:label xml:lang="en">has participation</rdfs:label>
        <skos:scopeNote xml:lang="en">The Participation class facilitates the detailed description of how an Agent participates in or interacts with a Public Service and may include temporal and spatial information.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasQualifiedRelation -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasQualifiedRelation">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:comment xml:lang="en">Described and/or categorised relation to another Requirement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">has qualified relation</rdfs:label>
        <skos:scopeNote xml:lang="en">This property leaves the possiblity to define a qualified relation from Requirement to Information Requirement or Constraint as well as a qualified relation from Requirement to Requirement.  A use case would be to specialize an EU requirement in Member States&apos; specific requirements.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasRelatedService -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasRelatedService">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:comment xml:lang="en">The Public Service related to the Event.</rdfs:comment>
        <rdfs:label xml:lang="en">has related service</rdfs:label>
        <skos:scopeNote xml:lang="en">This property is a sub-property of dct:relation.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasRequirement -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasRequirement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TenderClarificationRequest"/>
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/Requirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/InformationRequirement"/>
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/Requirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A more specific Requirement that is part of the Requirement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">has requirement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/hasSupportingEvidence -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/hasSupportingEvidence">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/Evidence"/>
        <rdfs:comment xml:lang="en">Evidence that supplies information, proof or support for the Requirement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">has supporting evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/holdsRequirement -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/holdsRequirement">
        <rdfs:comment xml:lang="en">It links a Public Service to a class that describes the Requirement.</rdfs:comment>
        <rdfs:label xml:lang="en">holds requirement</rdfs:label>
        <skos:scopeNote xml:lang="en">Usage: It describes the needing or using the service, such as residency in a given location, being over a certain age etc. The Requirement class is defined in the Core Criterion and Core Evidence Vocabulary.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/ifAccessedThrough -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/ifAccessedThrough">
        <rdfs:comment xml:lang="en">The costs created by the use of different Channels.</rdfs:comment>
        <rdfs:label xml:lang="en">if accessed through</rdfs:label>
        <skos:scopeNote xml:lang="en">For example, if accessed through an online service cf. accessed at a physical location, the cost can be linked to the channel using the If Accessed Through property.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/isClassifiedBy -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/isClassifiedBy">
        <rdfs:comment xml:lang="en">It allows to classify the Public Service with any Concept other than those already foreseen and defined explicitly in the CPSV-AP (Thematic Area, Sector, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">is classified by</rdfs:label>
        <skos:scopeNote xml:lang="en">It is a generic property which can be further specialised to make the classification explicit, for instance for classifying public services according level of digitisation,
type of audience, etc. The Concept is at its turn related to a Collection, which groups the different concepts into a controlled vocabulary.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/isDefinedBy -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/isDefinedBy">
        <rdfs:comment xml:lang="en">It links the Cost class to one or more instances of the Public Organization class.</rdfs:comment>
        <rdfs:label xml:lang="en">is defined by</rdfs:label>
        <skos:scopeNote xml:lang="en">This property indicates which Public Organization is the Competent Authority for defining the costs associated with the delivery of a particular Public Service.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/isDerivedFrom -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/isDerivedFrom">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:range rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/ReferenceFramework"/>
        <rdfs:comment xml:lang="en">Reference Framework on which the Requirement is based, such as a law or regulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">is derived from</rdfs:label>
        <skos:scopeNote xml:lang="en">Note that a Requirement can have several Reference Frameworks from which it is derived.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/isGroupedBy -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/isGroupedBy">
        <rdfs:comment xml:lang="en">It links the Public Service to the Event class.</rdfs:comment>
        <rdfs:label xml:lang="en">is grouped by</rdfs:label>
        <skos:scopeNote xml:lang="en">Several Public Services may be associated with a particular Event and, likewise, the same Public Service may be associated with several different Events.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/isRequirementOf -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/isRequirementOf">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:comment xml:lang="en">A reference between a sub-Requirement and its parent Requirement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">is requirement of</rdfs:label>
        <skos:scopeNote xml:lang="en">The relation between a parent Requirement and a sub-Requirement can be complex. Therefore, qualified relations (see hasQualifiedRelation) can be used to represent this relationship on its own and qualify it with additional information such as a date, a place. This is left to implementers.

In the case where the purpose is to link the two Requirements without additional information, the simple relationship as proposed here can be directly used.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/isSpecifiedIn -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/isSpecifiedIn">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/EvidenceType"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/EvidenceTypeList"/>
        <rdfs:comment xml:lang="en">Evidence Type List in which the Evidence Type is included.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">is specified in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/level -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/level">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/AdminUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The level of the administrative unit in the hierarchy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">level</rdfs:label>
        <skos:scopeNote xml:lang="en">The recommended code list to indicate the level of an Admin Unit is the &lt;a href=https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/atu-type&gt;Administrative territorial unit type&lt;/a&gt; Controlled Vocabulary maintained by the Publications Office of the EU. </skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/openingHours -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/openingHours">
        <rdfs:comment xml:lang="en">A time at which the resource is normally available.</rdfs:comment>
        <rdfs:comment xml:lang="en">The time at which the Contact Point is normally available.</rdfs:comment>
        <rdfs:label xml:lang="en">opening hours</rdfs:label>
        <skos:scopeNote xml:lang="en">For a simple description of the time use the description property of TemporalEntity.

For more structured data use the model in Time Ontology, see an &lt;a href=&quot;https://www.w3.org/TR/owl-time/#dtd-vs-dt&quot;&gt;example&lt;/a&gt;. This relation can be used to indicate exceptional closures such as being closed on public holidays.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Like the Contact Point, a Channel may be available at a certain time.
&lt;br/&gt;&lt;br/&gt;
For a simple description of the time use the description property of TemporalEntity.
&lt;br/&gt;&lt;br/&gt;
For more structured data use the model in Time Ontology, see an &lt;a href=&quot;https://www.w3.org/TR/owl-time/#dtd-vs-dt&quot;&gt;example&lt;/a&gt;.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/ownedBy -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/ownedBy">
        <rdfs:comment xml:lang="en">The owner of a specific Channel through which a Public Service is being delivered.</rdfs:comment>
        <rdfs:label xml:lang="en">owned by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/participates -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/participates">
        <rdfs:comment xml:lang="en">The participation in which an Agent is involved.</rdfs:comment>
        <rdfs:label xml:lang="en">participates</rdfs:label>
        <skos:scopeNote xml:lang="en">The Participation class facilitates the detailed description of how an Agent participates in or interacts with a Public Service and may include temporal and spatial information.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/providesValueFor -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/providesValueFor">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/SupportedValue"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/InformationConcept"/>
        <rdfs:comment xml:lang="en">Information Concept for which the Supported Value provides a value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">provides value for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/registeredAddress -->

    <rdf:Description rdf:about="http://data.europa.eu/m8g/registeredAddress">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/org#Organization"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/person#Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/ns/locn#Address"/>
    </rdf:Description>
    


    <!-- http://data.europa.eu/m8g/registrationPage -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/registrationPage">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/PublicEvent"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <rdfs:comment xml:lang="en">A web page that provides means to attend the Public Event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">registration page</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/relatedService -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/relatedService">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:comment xml:lang="en">A Public Service related to the particular instance of the Public Service class.</rdfs:comment>
        <rdfs:label xml:lang="en">related service</rdfs:label>
        <skos:scopeNote xml:lang="en">This property is a sub-property of dct:relation.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/role -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/role">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Participation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The function of an Agent within a Participation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:scopeNote xml:lang="en">This should be provided using a controlled vocabulary.
Since this is an extension mechanism for the CSPV-AP, the controlled vocabulary should be decided to suit local implementations.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/sector -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/sector">
        <rdfs:comment xml:lang="en">The industry or sector a Public Service relates to, or is intended for.</rdfs:comment>
        <rdfs:label xml:lang="en">sector</rdfs:label>
        <skos:scopeNote xml:lang="en">For example: environment, safety, housing. Note that a single Public Service may relate to multiple sectors. The possible values for this property are provided as a controlled vocabulary. The possible values for this property are described in the controlled vocabulary &lt;a href=&quot; https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/data-theme&quot;&gt;Data theme&lt;/a&gt; Authority Table of the Publications Office.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/sex -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/sex">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/person#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The organism&apos;s biological sex.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">sex</rdfs:label>
        <skos:scopeNote xml:lang="en">The recommended controlled vocabulary for this property is &lt;a href=&quot;https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/human-sex&quot;&gt;the sex authority table of the Publications Office.&lt;/a&gt;</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/specialOpeningHoursSpecification -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/specialOpeningHoursSpecification">
        <rdfs:comment xml:lang="en">A time during which the resource is not available.</rdfs:comment>
        <rdfs:label xml:lang="en">availability restriction</rdfs:label>
        <skos:scopeNote xml:lang="en">For a simple description of the time use the description property of TemporalEntity.

For more structured data use the model in Time Ontology, see an &lt;a href=&quot;https://www.w3.org/TR/owl-time/#dtd-vs-dt&quot;&gt;example&lt;/a&gt;.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Like the Contact Point, a Channel may not be available at a certain time.
&lt;br/&gt;&lt;br/&gt;
For a simple description of the time use the description property of TemporalEntity.
&lt;br/&gt;&lt;br/&gt;
For more structured data use the model in Time Ontology, see an &lt;a href=&quot;https://www.w3.org/TR/owl-time/#dtd-vs-dt&quot;&gt;example&lt;/a&gt;.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/specifiesEvidenceType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/specifiesEvidenceType">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/EvidenceTypeList"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/EvidenceType"/>
        <rdfs:comment xml:lang="en">Evidence Type included in this Evidence Type List.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">specifies evidence type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/supportsConcept -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/supportsConcept">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Evidence"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/InformationConcept"/>
        <rdfs:comment xml:lang="en">Information Concept providing facts found/inferred from the Evidence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">supports concept</rdfs:label>
        <skos:scopeNote xml:lang="en">Examples of Information Concepts are values found explictly in the evidence such as a birth date or information derived from the Evidence such as &quot;I am older that 18 years&quot;.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/supportsRequirement -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/supportsRequirement">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Evidence"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:comment xml:lang="en">Requirement for which the Evidence provides proof.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">supports requirement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/supportsValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/supportsValue">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Evidence"/>
        <rdfs:range rdf:resource="http://data.europa.eu/m8g/SupportedValue"/>
        <rdfs:comment xml:lang="en">Supported Value that the Evidence contains.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">supports value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/thematicArea -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/thematicArea">
        <rdfs:comment xml:lang="en">The Thematic Area of a Public Service.</rdfs:comment>
        <rdfs:label xml:lang="en">thematic area</rdfs:label>
        <skos:scopeNote xml:lang="en">For example: social protection, health, recreation, culture and religion, family, traveling economic affairs, tax, staff, environment, etc.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/validityPeriod -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/validityPeriod">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Evidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:comment xml:lang="en">Period of Time during which the Evidence holds true or has force.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">validity period</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/validityPeriodConstraint -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/validityPeriodConstraint">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/EvidenceType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:comment xml:lang="en">Temporal condition on the validity period of the Evidence Type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">validity period constraint</rdfs:label>
        <skos:scopeNote xml:lang="en">E.g. A Belgian birth evidence is valid for X months after emission. To express constraints on the validity period that must hold when assessing the evidence (e.g. the certificate of good conduct cannot be issued more than 3 months ago), we refer to the Constraint class.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/m8g/weightingType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/m8g/weightingType">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Criterion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Indication of how the weight should be interpreted in a complex evaluation expression, e.g. as a percentage in an evaluation expression.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">weighting type</rdfs:label>
        <skos:scopeNote xml:lang="en">An existing codelist which can be used is &lt;a href=&quot;https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/number-weight&quot; &gt;OP&apos;s Number weigth controlled vocabulary&lt;/a&gt;</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/conformsTo -->

    <rdf:Description rdf:about="http://purl.org/dc/terms/conformsTo">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    </rdf:Description>
    


    <!-- http://purl.org/dc/terms/language -->

    <rdf:Description rdf:about="http://purl.org/dc/terms/language">
        <rdfs:domain rdf:resource="http://data.europa.eu/eli/ontology#LegalExpression"/>
    </rdf:Description>
    


    <!-- http://purl.org/dc/terms/type -->

    <rdf:Description rdf:about="http://purl.org/dc/terms/type">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Criterion"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->

    <rdf:Description rdf:about="http://www.w3.org/2006/time#hasBeginning">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/2006/time#hasDuration -->

    <rdf:Description rdf:about="http://www.w3.org/2006/time#hasDuration">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalDuration"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->

    <rdf:Description rdf:about="http://www.w3.org/2006/time#hasEnd">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/2006/time#hasTemporalDuration -->

    <rdf:Description rdf:about="http://www.w3.org/2006/time#hasTemporalDuration">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalDuration"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/2006/time#unitType -->

    <rdf:Description rdf:about="http://www.w3.org/2006/time#unitType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Duration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/adms#identifier -->

    <rdf:Description rdf:about="http://www.w3.org/ns/adms#identifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#AbstractContainer"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Consignment"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Document"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Fund"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ItemProperty"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Line"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#LotGroup"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Project"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ShipmentInformation"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ShipmentStage"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TenderGroup"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TransportEquipment"/>
                    <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TransportEquipmentSeal"/>
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/Evidence"/>
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/EvidenceType"/>
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/EvidenceTypeList"/>
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/InformationConcept"/>
                    <rdf:Description rdf:about="http://data.europa.eu/m8g/Requirement"/>
                    <rdf:Description rdf:about="http://purl.org/dc/terms/Location"/>
                    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Agent"/>
                </owl:unionOf>
