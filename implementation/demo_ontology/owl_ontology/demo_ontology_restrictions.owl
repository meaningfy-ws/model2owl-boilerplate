    <!-- http://data.europa.eu/m8g/accessibility -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/m8g/accessibility">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/PublicEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Information about how the Public Event can be approached, reached or entered, in particular for people with special needs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">accessibility</rdfs:label>
        <skos:scopeNote xml:lang="en">This property may be provided in multiple languages with multiple instances of the accessibility property.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/m8g/bias -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/m8g/bias">
        <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Criterion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Parameter used to adjust the evaluation of the Criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">bias</rdfs:label>
        <skos:scopeNote xml:lang="en">The bias parameter tries to correct a systematic error. For example in procurement, a home bias corresponds to the &quot;presence of local preferences distorting international specialisation and resource allocation&quot;. When quantified, this systematic error can be removed.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/m8g/birthDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/m8g/birthDate">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/m8g/coordinates -->

