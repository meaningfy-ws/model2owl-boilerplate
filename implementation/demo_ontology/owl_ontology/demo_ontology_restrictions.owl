        <rdfs:domain rdf:resource="http://www.w3.org/ns/locn#Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">	A list of geographic coordinates that define the extent of the Geometry.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">coordinates</rdfs:label>
        <skos:scopeNote xml:lang="en">Can be expressed as longitude, latitude, elevation.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/m8g/crs -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/m8g/crs">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/locn#Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">An identifier for the coordinate reference system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">crs</rdfs:label>
        <skos:scopeNote xml:lang="en">Can be a coordinate-based local, regional or global system used to locate geographical entities.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/m8g/deathDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/m8g/deathDate"/>
    


