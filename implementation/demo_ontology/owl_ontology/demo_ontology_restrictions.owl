    <!-- http://purl.org/dc/terms/instructionalMethod -->

    <rdf:Description rdf:about="http://purl.org/dc/terms/instructionalMethod">
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-06-13</dct:issued>
        <dcam:rangeIncludes rdf:resource="http://purl.org/dc/terms/MethodOfInstruction"/>
        <dct:description xml:lang="en">Instructional Method typically includes ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured.  Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback.</dct:description>
        <rdfs:comment xml:lang="en">A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
        <rdfs:label xml:lang="en">Instructional Method</rdfs:label>
    </rdf:Description>
    


