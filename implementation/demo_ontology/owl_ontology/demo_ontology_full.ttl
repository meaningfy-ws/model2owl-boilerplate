@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix at-voc: <http://publications.europa.eu/resource/authority/> .
@prefix at-voc-new: <http://publications.europa.eu/resource/authority/new/> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix cfg: <http://www.example.org#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix person: <http://www.w3.org/ns/person#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AcquiringCentralPurchasingBody a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :CentralPurchasingBody ;
    skos:definition "Role of an Agent procuring activities conducted on a permanent basis in the form of the acquisition of supplies and/or services intended for other Buyers. Additional Information: In Public Procurement the Role of Acquiring Central Purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities."@en ;
    skos:historyNote "WG approval 05/08/2021"@en ;
    skos:prefLabel "Acquiring Central Purchasing Body"@en .

:AdHocChannel a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf cccev:Channel ;
    skos:definition "Web page where tools and devices for electronic communication that are not generally available can be downloaded free of charge."@en ;
    skos:editorialNote "Used by eForms BT-724"@en ;
    skos:historyNote "WG Approval 10/01/2023"@en ;
    skos:prefLabel "Ad Hoc Channel"@en .

:AwardCriteriaSummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :ProcurementCriteriaSummary ;
    skos:definition "Overview of the Award Criteria."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Award Criteria Summary"@en .

:Awarder a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent that signs the Award Decision. Additional information: BT-08 can be Awarding CBP; BG-03 is the Buyer. But Awarding CPB is not the same as the Buyer; the organisations may differ for these roles. Having the Awarder Role allows us to specify which Organisation is involved in the Award Decision."@en ;
    skos:prefLabel "Awarder"@en .

:AwardingCentralPurchasingBody a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :CentralPurchasingBody ;
    skos:definition "Role of an Agent procuring activities conducted on a permanent basis in the form of the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for other Buyers. Additional Information: In Public Procurement the Role of Awarding Central purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities."@en ;
    skos:historyNote "WG approval 05/08/2021"@en ;
    skos:prefLabel "Awarding Central Purchasing Body"@en .

:EAuctionTechnique a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Technique ;
    skos:definition "A repetitive Technique in which new Prices, revised downwards, and/or new values concerning certain elements of Tenders are bid on-line."@en ;
    skos:editorialNote "Used by eForms BT-767"@en ;
    skos:historyNote "WG approval 20/07/2018"@en ;
    skos:prefLabel "E Auction Technique"@en .

:EconomicStandingSummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :SelectionCriteriaSummary ;
    skos:definition "Overview of the financial viability of the economic operator."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Economic Standing Summary"@en .

:EmploymentDocumentation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Documentation ;
    skos:prefLabel "Employment Documentation"@en .

:EmploymentInformationProvider a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "A Role of an Agent responsible for providing information concerning the general regulatory framework for employment protection and working conditions."@en ;
    skos:prefLabel "Employment Information Provider"@en .

:EnvironmentalDocumentation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Documentation ;
    skos:prefLabel "Environmental Documentation"@en .

:EnvironmentalProtectionInformationProvider a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "A Role of an Agent responsible for providing information concerning the general regulatory framework for Environmental Protection."@en ;
    skos:prefLabel "Environmental Protection Information Provider"@en .

:ExclusionGroundsSummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :QualificationCriteriaSummary ;
    skos:definition "Overview of the Exclusion Grounds."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Exclusion Grounds Summary"@en .

:FrameworkAgreementTechnique a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Technique ;
    skos:definition "Technique that establishes the terms governing Contracts to be awarded during a given Period, in particular with regard to Price and, where appropriate, the Quantity envisaged."@en ;
    skos:historyNote "WG approval 18/05/2021"@en ;
    skos:prefLabel "Framework Agreement Technique"@en .

:LeadBuyer a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Buyer ;
    skos:definition "A Role of an Agent who is a Buyer and takes the administrative lead of the Procedure."@en ;
    skos:historyNote "WG Approval 22/11/2022"@en ;
    skos:prefLabel "Lead Buyer"@en .

:ReliedUponEntity a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :OfferingParty ;
    skos:definition "Economic Operator (who is not a Subcontractor) on which the Tenderer relies upon, to meet Selection Criteria."@en ;
    skos:prefLabel "Relied Upon Entity"@en .

:SelectionEvaluationTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :EvaluationTerm ;
    skos:definition "Conditions and stipulations defining particularities of the evaluation of Selection Criteria."@en ;
    skos:prefLabel "Selection Evaluation Term"@en .

:TaxDocumentation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Documentation ;
    skos:prefLabel "Tax Documentation"@en .

:TaxInformationProvider a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "A Role of an Agent responsible for providing information concerning the general regulatory framework for taxes."@en ;
    skos:prefLabel "Tax Information Provider"@en .

:TechnicalAbilitySummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :SelectionCriteriaSummary ;
    skos:definition "Overview of the expertise required for the economic operator to execute the contract."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Technical Ability Summary"@en .

:TechnicalSpecification a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "A set of documented Requirements applicable to the object of the Procurement. Additional Information: A specification often includes technical standards."@en ;
    skos:historyNote "WG approval 20/04/2021"@en ;
    skos:prefLabel "Technical Specification"@en .

:announcesAwardDecision a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DirectAwardPrenotificationNotice :ResultNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :AwardDecision ;
    skos:prefLabel "announces Award Decision"@en .

:announcesContract a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DirectAwardPrenotificationNotice :ResultNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Contract ;
    skos:prefLabel "announces Contract"@en .

:announcesLotGroup a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CompetitionNotice :DirectAwardPrenotificationNotice :PlanningNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :LotGroup ;
    skos:prefLabel "announces Lot Group"@en .

:announcesLotGroupAwardInformation a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DirectAwardPrenotificationNotice :ResultNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :LotGroupAwardInformation ;
    skos:prefLabel "announces Lot Group Award Information"@en .

:announcesPlannedProcurementPart a owl:ObjectProperty ;
    rdfs:domain :PlanningNotice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :PlannedProcurementPart ;
    skos:prefLabel "announces Planned Procurement Part"@en .

:announcesReviewRequest a owl:ObjectProperty ;
    rdfs:domain :ResultNotice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ReviewRequest ;
    skos:prefLabel "announces Review Request"@en .

:answersQuestion a owl:ObjectProperty ;
    rdfs:domain :Response ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range cccev:InformationRequirement ;
    skos:definition "Relation indicating that the Response replies to a question."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "answers Question"@en .

:answersReviewRequest a owl:ObjectProperty ;
    rdfs:domain :ReviewDecision ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ReviewRequest ;
    skos:prefLabel "answers Review Request"@en .

:associatedWith a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Document ;
    skos:definition "The document to which a document is associated."@en ;
    skos:historyNote "WG Approval 01/03/2022"@en ;
    skos:prefLabel "associated With"@en .

:bindsBuyer a owl:ObjectProperty ;
    rdfs:domain :Contract ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Buyer ;
    skos:definition "Provides legal constraint on the Buyer."@en ;
    skos:prefLabel "binds Buyer"@en .

:bindsContractor a owl:ObjectProperty ;
    rdfs:domain :Contract ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Contractor ;
    skos:definition "Provides legal constraint on the Contractor."@en ;
    skos:prefLabel "binds Contractor"@en .

:canProvideEvidence a owl:ObjectProperty ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range cccev:Evidence ;
    skos:definition "Relation showing that an Organization can supply an Evidence with regard to the payment of social security contributions and taxes."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "can Provide Evidence"@en .

:canProvideNonDiscriminatoryEvidence a owl:ObjectProperty ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range cccev:Evidence ;
    skos:definition "Relation showing that an Organization can supply an Evidence with regard to the fulfilment of non-discriminatory criteria or the rules applied in order to reduce the number of participants."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "can Provide Non Discriminatory Evidence"@en .

:comprisesAwardOutcome a owl:ObjectProperty ;
    rdfs:domain :AwardDecision ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :AwardOutcome ;
    skos:definition "Incorporates AwardOutcome."@en ;
    skos:prefLabel "comprises Award Outcome"@en .

:comprisesTenderAwardOutcome a owl:ObjectProperty ;
    rdfs:domain :AwardOutcome ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :TenderAwardOutcome ;
    skos:definition "Incorporates TenderAwardOutcome."@en ;
    skos:prefLabel "comprises Tender Award Outcome"@en .

:concernsEnergyEfficiencyItemCategory a owl:ObjectProperty ;
    rdfs:domain :EnergyEfficiencyInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "concerns Energy Efficiency Item Category"@en .

:concernsInternationalProcurementInstrumentMeasure a owl:ObjectProperty ;
    rdfs:domain :InternationalProcurementInstrumentMeasuresInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "concerns International Procurement Instrument Measure"@en .

:concernsLotAwardOutcome a owl:ObjectProperty ;
    rdfs:domain :InternationalProcurementInstrumentMeasuresInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :LotAwardOutcome ;
    skos:prefLabel "concerns Lot Award Outcome"@en .

:conformsToLegalBasis a owl:ObjectProperty ;
    rdfs:domain :Notice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The Notice was designed in accordance with the given legal basis. Additional Information: This Notice can be used for Procedures which do not have the same legal basis. This holds for standard forms."@en ;
    skos:prefLabel "conforms To Legal Basis"@en .

:containsCandidate a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ExcludedCandidateList :SelectedCandidateList ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Candidate ;
    skos:definition "Includes Candidate."@en ;
    skos:historyNote "WG Approval 14/05/2024"@en ;
    skos:prefLabel "contains Candidate"@en .

:contextualisedBy a owl:ObjectProperty ;
    rdfs:domain :AgentInRole ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ProcurementElement ;
    skos:definition "The place of the AgentInRole in the procurement is expressed by a ProcurementObject."@en ;
    skos:prefLabel "contextualised By"@en .

:definesCatalogueProvider a owl:ObjectProperty ;
    rdfs:domain :AccessTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :CatalogueProvider ;
    skos:definition "Relation indicating an AccessTerm has a CatalogueProvider."@en ;
    skos:prefLabel "defines Catalogue Provider"@en .

:definesCatalogueReceiver a owl:ObjectProperty ;
    rdfs:domain :AccessTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :CatalogueReceiver ;
    skos:definition "Relation indicating an AccessTerm has a CatalogueReceiver."@en ;
    skos:prefLabel "defines Catalogue Receiver"@en .

:definesInformationProvider a owl:ObjectProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :AuxiliaryParty ;
    skos:definition "Relation indicating a ProcedureTerm has an information provider."@en ;
    skos:prefLabel "defines Information Provider"@en .

:definesLotGroup a owl:ObjectProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :LotGroup ;
    skos:definition "Relation indicating a ProcedureTerm has a LotGroup."@en ;
    skos:prefLabel "defines Lot Group"@en .

:definesPrize a owl:ObjectProperty ;
    rdfs:domain :DesignContestRegimeTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Prize ;
    skos:definition "Relation indicating a DesignContestRegimeTerm has a Prize."@en ;
    skos:prefLabel "defines Prize"@en .

:definesReviewer a owl:ObjectProperty ;
    rdfs:domain :ReviewTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Reviewer ;
    skos:definition "Relation indicating a ReviewTerm has a Reviewer."@en ;
    skos:prefLabel "defines Reviewer"@en .

:definesSpecificPlaceOfPerformance a owl:ObjectProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range dcterms:Location ;
    skos:definition "Relation indicating a ContractTerm has a specific place of performance."@en ;
    skos:prefLabel "defines Specific Place Of Performance"@en .

:delegatesAncillaryActivitiesTo a owl:ObjectProperty ;
    rdfs:domain :Buyer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ProcurementServiceProvider ;
    skos:definition "Entrusts ancillary purchasing activities to ProcurementServiceProvider."@en ;
    skos:prefLabel "delegates Ancillary Activities To"@en .

:distributesOffer a owl:ObjectProperty ;
    rdfs:domain :OfferIssuer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Offer ;
    skos:prefLabel "distributes Offer"@en .

:doesNotRequireSelectionCriterionType a owl:ObjectProperty ;
    rdfs:domain :ProcurementElement ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "does Not Require Selection Criterion Type"@en .

:exposesChannel a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AgentInRole org:Organization ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range cccev:Channel ;
    skos:prefLabel "exposes Channel"@en .

:foreseesSubcontracting a owl:ObjectProperty ;
    rdfs:domain :Tender ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :SubcontractingEstimate ;
    skos:prefLabel "foresees Subcontracting"@en .

:foreseesTechnique a owl:ObjectProperty ;
    rdfs:domain :PlannedProcurementPart ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Technique ;
    skos:prefLabel "foresees Technique"@en .

:foreseesTerm a owl:ObjectProperty ;
    rdfs:domain :ProcurementElement ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Term ;
    skos:prefLabel "foresees Term"@en .

:fulfillsRequirement a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :GreenProcurement :InnovativeProcurement :SocialProcurement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The requirement to which the concept meets."@en ;
    skos:prefLabel "fulfills Requirement"@en .

:fulfillsStrategicProcurement a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LotAwardOutcome :ProcurementObject ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :StrategicProcurement ;
    skos:prefLabel "fulfills Strategic Procurement"@en .

:hasAcceleratedProcedureJustification a owl:DatatypeProperty ;
    rdfs:domain :Procedure ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The reasons why the procedure is accelerated. Additional Information: A procedure is accelerated to cover needs of extraordinary circumstances ie earthquake relief. (epo:Procedure)"@en ;
    skos:historyNote "WG Approval 09/06/2020"@en ;
    skos:prefLabel "has Accelerated Procedure Justification"@en .

:hasAccessURL a owl:DatatypeProperty ;
    rdfs:domain :Document ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Location where the resource can be accessed. (epo:Document)"@en ;
    skos:historyNote "WG approval 07/04/2022"@en ;
    skos:prefLabel "has Access URL"@en .

:hasActivityDescription a owl:DatatypeProperty ;
    rdfs:domain :Buyer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "In the ePO ontology a taxonomy with all activities, based on different classifications (COFOG, UTILITIES, NACE), will be provided. In ePO this field is to be used exclusively to complement the definition attached to the MainActivityCode. However, in eForms there is the code \"other\" to cover undefined activities. For mapping to this eForms feature one could also use this property. (epo:Buyer)"@en ;
    skos:prefLabel "has Activity Description"@en .

:hasAdditionalClassification a owl:ObjectProperty ;
    rdfs:domain :Purpose ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Additional Classification"@en .

:hasAdditionalContractNature a owl:ObjectProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Additional type of acquisition taken into consideration in the contract."@en ;
    skos:prefLabel "has Additional Contract Nature"@en .

:hasAlias a owl:DatatypeProperty ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Acronym or alternative name of the Agent. (foaf:Agent)"@en ;
    skos:historyNote "WG Approval 25/03/2021"@en ;
    skos:prefLabel "has Alias"@en .

:hasAllegedIrregularityType a owl:ObjectProperty ;
    rdfs:domain :ReviewRequest ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Alleged Irregularity Type"@en .

:hasAwardCriteriaEvaluationFormula a owl:DatatypeProperty ;
    rdfs:domain :AwardEvaluationTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion. (epo:AwardEvaluationTerm)"@en ;
    skos:editorialNote "Used by eForms BT-543"@en ;
    skos:prefLabel "has Award Criteria Evaluation Formula"@en .

:hasAwardCriterionType a owl:ObjectProperty ;
    rdfs:domain :AwardCriterion ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Category of award criterion."@en ;
    skos:prefLabel "has Award Criterion Type"@en .

:hasAwardStatus a owl:ObjectProperty ;
    rdfs:domain :AwardOutcome ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Indicates whether the lot is awarded, not awarded or still open."@en ;
    skos:prefLabel "has Award Status"@en .

:hasBeneficialOwner a owl:ObjectProperty ;
    rdfs:domain :Business ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range person:Person ;
    owl:inverseOf :isBeneficialOwnerOf ;
    skos:definition "A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it's beyond the scope for public eProcurement domain."@en ;
    skos:historyNote "WG Approval 14/09/2021"@en ;
    skos:prefLabel "has Beneficial Owner"@en .

:hasBroadPlaceOfPerformance a owl:ObjectProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Geopolitical zone where the contract can be executed. Additional Information Used for setting restrictions that cannot be established with one country code or a geographical zone identifier (like NUTS), because they have a broader scope (geographical, economic, political, other)."@en ;
    skos:prefLabel "has Broad Place Of Performance"@en .

:hasBusinessSize a owl:ObjectProperty ;
    rdfs:domain :Business ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The category of the business depending on number of employees and turnover. Additional information: See Commission Recommendation of 6 May 2003 concerning the definition of micro, small and medium-sized enterprises."@en ;
    skos:prefLabel "has Business Size"@en .

:hasBuyerCategoryDescription a owl:DatatypeProperty ;
    rdfs:domain :FrameworkAgreementTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "A classification of buyers participating in a framework agreement. Additional Information: Buyers that can use the Framework Agreement not mentioned by name. For example, the classification \"all hospitals in the Tuscany region\" is used instead of naming each individual buyer. (epo:FrameworkAgreementTerm)"@en ;
    skos:editorialNote "Used by eForms BT-111"@en ;
    skos:historyNote "WG Approval 06/05/2019"@en ;
    skos:prefLabel "has Buyer Category Description"@en .

:hasBuyerLegalType a owl:ObjectProperty ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "A category that indicates the right of an Organisation to play the role of a buyer. Additional Information: The category also effects the rules that the buyer has to abide to within the public procurement procedure."@en ;
    skos:prefLabel "has Buyer Legal Type"@en .

:hasCalculationBasedOn a owl:ObjectProperty ;
    rdfs:domain :EnergyEfficiencyInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Calculation Based On"@en .

:hasCertification a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractItem foaf:Agent ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Certificate ;
    skos:definition "Relation to the proof of conformance."@en ;
    skos:historyNote "WG Approval 30/05/2023"@en ;
    skos:prefLabel "has Certification"@en .

:hasChangeDescription a owl:DatatypeProperty ;
    rdfs:domain :ChangeInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Explanatory text about the instance of the concept. (epo:ChangeInformation)"@en ;
    skos:historyNote "WG Approval 30/09/2019"@en ;
    skos:prefLabel "has Change Description"@en .

:hasChangeJustification a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :ChangeInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Code explaining the change."@en ;
    skos:prefLabel "has Change Justification"@en .

:hasChangeReasonDescription a owl:DatatypeProperty ;
    rdfs:domain :ChangeInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Explanatory text about why the element is altered. (epo:ChangeInformation)"@en ;
    skos:editorialNote "Used by eForms BT-762"@en ;
    skos:prefLabel "has Change Reason Description"@en .

:hasConditionVerificationMethod a owl:DatatypeProperty ;
    rdfs:domain :QualificationCriteriaSummary ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Means used to validate the qualification requirements. (epo:QualificationCriteriaSummary)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Condition Verification Method"@en .

:hasConfirmedIrregularityType a owl:ObjectProperty ;
    rdfs:domain :ReviewDecision ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Confirmed Irregularity Type"@en .

:hasConstraint a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ProcurementCriterion cccev:InformationRequirement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range cccev:Constraint ;
    skos:prefLabel "has Constraint"@en .

:hasContactPointInRole a owl:ObjectProperty ;
    rdfs:domain :AgentInRole ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range cccev:ContactPoint ;
    skos:prefLabel "has Contact Point In Role"@en .

:hasContractNatureType a owl:ObjectProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Subject of the acquisition."@en ;
    skos:prefLabel "has Contract Nature Type"@en .

:hasCountryCode a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dcterms:Location locn:Address ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Country Code"@en .

:hasCountryOfBirth a owl:ObjectProperty ;
    rdfs:domain person:Person ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The country in which the Person was born."@en ;
    skos:prefLabel "has Country Of Birth"@en .

:hasCountryOfOrigin a owl:ObjectProperty ;
    rdfs:domain :AbstractItem ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The source country of the product or service. Additional Information: The country of origin can be provided by the buyer as a requirement or by the tenderer information of the item to be provided."@en ;
    skos:prefLabel "has Country Of Origin"@en .

:hasCrossBorderLaw a owl:DatatypeProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
