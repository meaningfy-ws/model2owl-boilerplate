    skos:editorialNote "Used by eForms BT-09"@en ;
    skos:prefLabel "has Cross Border Law"@en .

:hasCurrency a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :MonetaryValue ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The identifier of the currency as in the standard code list used."@en ;
    skos:prefLabel "has Currency"@en .

:hasCurrencyCodeListAgencyID a owl:DatatypeProperty ;
    rdfs:domain :MonetaryValue ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Identifier of the agency that maintains the currency code list used. (epo:MonetaryValue)"@en ;
    skos:historyNote "WG Approval 13/04/2021"@en ;
    skos:prefLabel "has Currency Code List Agency ID"@en .

:hasCurrencyCodeListAgencyName a owl:DatatypeProperty ;
    rdfs:domain :MonetaryValue ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Name of the agency that maintains the currency code list used. (epo:MonetaryValue)"@en ;
    skos:historyNote "WG Approval 13/04/2021"@en ;
    skos:prefLabel "has Currency Code List Agency Name"@en .

:hasCurrencyCodeListID a owl:DatatypeProperty ;
    rdfs:domain :MonetaryValue ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Concept scheme URI used for the currency code list. (epo:MonetaryValue)"@en ;
    skos:historyNote "WG Approval 13/04/2021"@en ;
    skos:prefLabel "has Currency Code List ID"@en .

:hasDPSScope a owl:ObjectProperty ;
    rdfs:domain :DynamicPurchaseSystemTechnique ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Explanation as to whether a dps is used and by whom. The codelist to be used is at-voc:dps-usage which is available at http://publications.europa.eu/resource/dataset/dps-usage"@en ;
    skos:prefLabel "has DPS Scope"@en .

:hasDeliveryLocation a owl:ObjectProperty ;
    rdfs:domain :Price ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range dcterms:Location ;
    skos:definition "Location delivery area where the Item can be ordered to the given price."@en ;
    skos:prefLabel "has Delivery Location"@en .

:hasDestinationCountryCode a owl:ObjectProperty ;
    rdfs:domain :RequestForOffer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Destination Country Code"@en .

:hasDirectAwardJustification a owl:ObjectProperty ;
    rdfs:domain :DirectAwardTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "List of reasons for using a procedure which allows awarding contracts directly without publishing a notice."@en ;
    skos:prefLabel "has Direct Award Justification"@en .

:hasDocumentRestrictionJustification a owl:ObjectProperty ;
    rdfs:domain :AccessTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "An explanation about the reasons why some procurement documents are restricted."@en ;
    skos:prefLabel "has Document Restriction Justification"@en .

:hasDocumentType a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Document Type"@en .

:hasECataloguePermission a owl:ObjectProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The extent to which electronic catalogues may be used in tenders."@en ;
    skos:prefLabel "has E Catalogue Permission"@en .

:hasEInvoicingPermission a owl:ObjectProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has E Invoicing Permission"@en .

:hasESubmissionPermission a owl:ObjectProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The requirements as to what extent electronic submission is allowed."@en ;
    skos:prefLabel "has E Submission Permission"@en .

:hasElectronicDigest a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Document ;
    skos:prefLabel "has Electronic Digest"@en .

:hasElectronicSignature a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ElectronicSignature ;
    skos:prefLabel "has Electronic Signature"@en .

:hasElementReference a owl:DatatypeProperty ;
    rdfs:domain :ReviewInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Reference to the class instance in the current notice. (epo:ReviewInformation)"@en ;
    skos:editorialNote "Used by eForms BT-13716, eForms BT-786, eForms BT-1501"@en ;
    skos:prefLabel "has Element Reference"@en .

:hasEndpointIdentifier a owl:ObjectProperty ;
    rdfs:domain cccev:Channel ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:prefLabel "has Endpoint Identifier"@en .

:hasEnergyEfficiencyLabel a owl:ObjectProperty ;
    rdfs:domain :EnergyEfficiencyInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Energy Efficiency Label"@en .

:hasExclusionGroundType a owl:ObjectProperty ;
    rdfs:domain :ExclusionGround ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Exclusion Ground Type"@en .

:hasFax a owl:DatatypeProperty ;
    rdfs:domain cccev:ContactPoint ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The fax number used to reach a person or an organisation. (cpov:ContactPoint)"@en ;
    skos:prefLabel "has Fax"@en .

:hasFixedValueType a owl:ObjectProperty ;
    rdfs:domain :AwardCriterion ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The method to interpret the fixed value as pertaining to a total or unit."@en ;
    skos:prefLabel "has Fixed Value Type"@en .

:hasFollowupContractInformation a owl:DatatypeProperty ;
    rdfs:domain :DesignContestRegimeTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Further information about follow-up contracts, prizes and payments (for example non-monetary prizes, payments given for participation). (epo:DesignContestRegimeTerm)"@en ;
    skos:historyNote "WG Approval 03/09/2019"@en ;
    skos:prefLabel "has Followup Contract Information"@en .

:hasFormType a owl:ObjectProperty ;
    rdfs:domain :Notice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "A categorisation of the steps in which the Notice is used."@en ;
    skos:prefLabel "has Form Type"@en .

:hasFrameworkAgreementType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :FrameworkAgreementTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The form of framework agreement used in a procurement procedure. Addition information: A concept to distinguish the different types of framework agreement, which are: 1. Framework agreement without reopening of competition, 2. Framework agreement with reopening of competition, or 3. Framework agreement partly without reopening of competition."@en ;
    skos:prefLabel "has Framework Agreement Type"@en .

:hasFundProgramme a owl:ObjectProperty ;
    rdfs:domain :Fund ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Fund Programme"@en .

:hasGroupLotEvaluationMethod a owl:DatatypeProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Description of how lots and groups of lots are evaluated against one another in the procedure. (epo:ProcedureTerm)"@en ;
    skos:prefLabel "has Group Lot Evaluation Method"@en .

:hasGroupType a owl:DatatypeProperty ;
    rdfs:domain :OrganisationGroup ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Form of collaboration agreement between organisations. Additional Information: This is not a legal type; not to be mistaken with epo:hasLegalFormType which may also be used for Organisation Groups. (epo:OrganisationGroup)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Group Type"@en .

:hasGuaranteeDescription a owl:DatatypeProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Information on the financial commitment required from the economic operator. Additional Information: 1. This information may include the amount and the way of delivering of the guarantee 2. The financial commitment may be retained by the buyer in the case the tenderer withdraws the submitted information (i.e. tender, expression of interest and request for participation, but not request for clarifications) before the award of the contract or does not sign the contract. 3. Usual modalities are bonds, cheques, loans, other. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 21/07/20"@en ;
    skos:prefLabel "has Guarantee Description"@en .

:hasHazardousClassID a owl:ObjectProperty ;
    rdfs:domain :AbstractItem ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "Specification of the hazardous nature of an item according to a classification schema. Provides detail of the classification and nature of a hazardous item."@en ;
    skos:prefLabel "has Hazardous Class ID"@en .

:hasInternalIdentifier a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LotGroup :ProcurementElement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:editorialNote "Used by eForms BT-22"@en ;
    skos:prefLabel "has Internal Identifier"@en .

:hasInternationalProcurementInstrumentExceptionInformation a owl:ObjectProperty ;
    rdfs:domain :InternationalProcurementInstrumentMeasuresInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has International Procurement Instrument Exception Information"@en .

:hasIrregularityType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :ReviewIrregularitySummary ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Irregularity Type"@en .

:hasItemClassificationIdentifier a owl:ObjectProperty ;
    rdfs:domain :AbstractItem ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:prefLabel "has Item Classification Identifier"@en .

:hasItemCountryOfOrigin a owl:ObjectProperty ;
    rdfs:domain :Tender ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The source country of the product or service. Additional Information: The country of origin can be provided by the buyer as a requirement or by the tenderer information of the item to be provided. The codelist to be used is at-voc:country which is available at http://publications.europa.eu/resource/dataset/country"@en ;
    skos:prefLabel "has Item Country Of Origin"@en .

:hasItemStandardID a owl:ObjectProperty ;
    rdfs:domain :AbstractItem ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "The general identifier assigned to the concept based on a standard scheme.​ Additional information: For example the GTIN scheme (Global Trade Item Number)."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Item Standard ID"@en .

:hasJuryMember a owl:ObjectProperty ;
    rdfs:domain :EvaluationBoard ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :JuryMember ;
    skos:definition "An agent involved in an evaluation board."@en ;
    skos:historyNote "WG Approval 14/09/2021"@en ;
    skos:prefLabel "has Jury Member"@en .

:hasJustification a owl:DatatypeProperty ;
    rdfs:domain :DirectAwardTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "An explanation about the reasons for using the concept. (epo:DirectAwardTerm)"@en ;
    skos:historyNote "WG Approval 05/11/2019"@en ;
    skos:prefLabel "has Justification"@en .

:hasLabelType a owl:ObjectProperty ;
    rdfs:domain :CertificationLabel ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The label type such environmental, quality, social etc."@en ;
    skos:prefLabel "has Label Type"@en .

:hasLanguage a owl:ObjectProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Language in which the submitted information is to be expressed."@en ;
    skos:prefLabel "has Language"@en .

:hasLateSubmissionInformationDescription a owl:DatatypeProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "A narrative text explaining the content of the economic operator information that can be submitted late. Additional Information This does not apply to requests for clarifications. (epo:SubmissionTerm)"@en ;
    skos:prefLabel "has Late Submission Information Description"@en .

:hasLateSubmissionPermission a owl:ObjectProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "Whether economic operator-related information can be supplemented even after the submission deadline. Additional Information This is specific to the information on the economic operator and not the actual offer. This does not apply to the requests for clarification."@en ;
    skos:prefLabel "has Late Submission Permission"@en .

:hasLegalBasis a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LocalLegalBasisInformation :ProcurementElement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The legal basis under which the procurement procedure takes place. Additional Information: For example European Directives or Regulations, national laws etc. The recommended code list is the example for the legal basis at the European level."@en ;
    skos:prefLabel "has Legal Basis"@en .

:hasLegalBasisDescription a owl:DatatypeProperty ;
    rdfs:domain :ProcurementElement ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Explanatory text about the legal basis. (epo:ProcurementElement)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Legal Basis Description"@en .

:hasLegalIdentifier a owl:ObjectProperty ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:prefLabel "has Legal Identifier"@en .

:hasLegalName a owl:DatatypeProperty ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The officially registered name of an organisation. (org:Organization)"@en ;
    skos:historyNote "WG Approval 10/01/2023"@en ;
    skos:prefLabel "has Legal Name"@en .

:hasMainActivity a owl:ObjectProperty ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:definition "The principal sectoral area in which an organisation operates. Additional information: The activities associated with buyers are derived from the top level of the Classification of the functions of the government (COFOG) from the United Nations Statistics Division. The activities associated with buyer are derived from sectors explicitly falling within the sectoral directive (2014/25/EU Art. 8 - Art. 14)."@en ;
    skos:prefLabel "has Main Activity"@en .

:hasMainClassification a owl:ObjectProperty ;
    rdfs:domain :Purpose ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range skos:Concept ;
    skos:prefLabel "has Main Classification"@en .

:hasMainFeature a owl:DatatypeProperty ;
    rdfs:domain :Procedure ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Main features of the procedure and information about where the full rules for the procedure can be found. Additional Information: This information should be given when the procedure is not one of those mentioned in the procurement directives. This can be the case for example for concessions, for social and other specific services, and in case of voluntary publication of procurement procedures below the EU procurement thresholds. (epo:Procedure)"@en ;
    skos:prefLabel "has Main Feature"@en .

:hasModificationJustification a owl:FunctionalProperty,
