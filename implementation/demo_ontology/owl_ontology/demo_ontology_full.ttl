:Tender a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasElectronicSubmission ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ConcessionEstimate ;
            owl:onProperty :foreseesConcession ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Offer ;
            owl:onProperty :isSupportedBy ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Tenderer ;
            owl:onProperty :isSubmittedBy ],
        [ a owl:Restriction ;
            owl:onClass :Lot ;
            owl:onProperty :isSubmittedForLot ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasFinancialOfferValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isVariant ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :LotGroup ;
            owl:onProperty :isSubjectToGrouping ],
        :MaskableObject ;
    skos:definition "Information submitted by the Economic Operator to specify its Offer regarding a specific Lot, in response to the call for Tender."@en ;
    skos:historyNote "WG approval 03/05/2022"@en ;
    skos:prefLabel "Tender"@en .

dcterms:Location a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Location"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A spatial region or named place."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty locn:geographicName ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty locn:geographicIdentifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass locn:Address ;
            owl:onProperty locn:address ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass locn:Geometry ;
            owl:onProperty locn:geometry ],
        dcterms:LocationPeriodOrJurisdiction ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/Location\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/Location</u></foreign></xref>"@en ;
    skos:prefLabel "Location"@en .

:Notice a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Procedure ;
            owl:onProperty :refersToProcedure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Notice ;
            owl:onProperty :refersToNotice ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasNoticePublicationNumber ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasOJSIssueNumber ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasESenderDispatchDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasFormNumber ] ;
    skos:definition "Document published by the Buyer about market opportunities and results."@en ;
    skos:historyNote "WG Approval 23/05/2019"@en ;
    skos:prefLabel "Notice"@en .

:Term a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "A governing condition or stipulation."@en ;
    skos:prefLabel "Term"@en .

adms:identifier a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment :Document :Fund :ItemProperty :Line :LotGroup :ProcurementElement :Project :ShipmentInformation :ShipmentStage :TenderGroup :TransportEquipment :TransportEquipmentSeal cccev:Evidence cccev:EvidenceType cccev:EvidenceTypeList cccev:InformationConcept cccev:Requirement dcterms:Location foaf:Agent ) ] ;
    rdfs:range adms:Identifier ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/ADMS/releases/2.00/#identifier\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/ADMS/releases/2.00/#identifier</u></foreign></xref> External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/ADMS/releases/2.00/#identifier\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/ADMS/releases/2.00/#identifier</u></foreign></xref>"@en ;
    skos:historyNote "WG Approval 12/11/2019"@en ;
    skos:prefLabel "identifier"@en .

:LotGroup a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isSMESuitable ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:onProperty :setsGroupingContextForLot ;
            owl:someValuesFrom :Lot ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasLaunchFrameworkAgreementMaximumValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasEstimatedValue ] ;
    skos:definition "Combination of several Lots to conduct comparative assessment of the Tenders. Additional Information: The comparative assessment may refer to the Selection Criteria, Award and Value that apply to several Lots. Pending of discussion with eForms Member States may provide that, where more than one lot may be awarded to the same tenderer, contracting authorities may award contracts combining several or all lots where they have specified in the contract notice or in the invitation to confirm interest that they reserve the possibility of doing so and indicate the lots or groups of lots that may be combined."@en ;
    skos:prefLabel "Lot Group"@en .

cccev:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:comment "Condition or prerequisite that is to be proven by Evidence."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty skos:prefLabel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ] ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/Requirement\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/Requirement</u></foreign></xref> Additional Information: To stay consistent to how identification is realised in the eProcurement ontology, we switch to using `adms:identifier` instead of `dct:identifier` as per CCCEV specification."@en ;
    skos:prefLabel "Requirement"@en ;
    skos:scopeNote """Not all public services are needed or are used by everyone. For example, the visa service operated by European countries is not needed by European citizens but is needed by some citizens from elsewhere, or public services offering unemployment benefits and grants are targeting specific societal groups. The CPSV-AP reuses the Core Criterion and Core Evidence Vocabulary for this class.

Requirement is a generic class representing any type of prerequisite that may be desired, needed or imposed as an obligation. CCCEV recommends to not use the Requirement class directly, but rather a more semantically-enriched subclass such as Criterion, Information Requirement or Constraint. Also note that the Requirement class is specified at a more abstract level and is not to be used as the instantiation of a Requirement for a specific Agent.
To illustrate the notion: the European Directive on services in the internal market defines requirement as any obligation, prohibition, condition or limit provided for in the laws, regulations or administrative provisions of the Member States or in consequence of case-law, administrative practice, the rules of professional bodies, or the collective rules of professional associations or other professional organisations, adopted in the exercise of their legal autonomy."""@en,
        "Requirement is a generic class representing any type of prerequisite that may be desired, needed or imposed as an obligation. CCCEV recommends to not use the Requirement class directly, but rather a more semantically-enriched subclass such as Criterion, Information Requirement or Constraint. Also note that the Requirement class is specified at a more abstract level and is not to be used as the instantiation of a Requirement for a specific Agent.   The European Directive on services in the internal market  defines requirement as any obligation, prohibition, condition or limit provided for in the laws, regulations or administrative provisions of the Member States or in consequence of case-law, administrative practice, the rules of professional bodies, or the collective rules of professional associations or other professional organisations, adopted in the exercise of their legal autonomy."@en .

person:Person a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty cccev:birthDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass locn:Address ;
            owl:onProperty cccev:registeredAddress ],
        foaf:Person ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Person-Vocabulary/releases/2.1.1/#Person\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Person-Vocabulary/releases/2.1.1/#Person</u></foreign></xref>"@en ;
    skos:prefLabel "Person"@en .

:SubmissionStatisticalInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasSMEReceivedTendersExcludingSubcontractors ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasEstimatedTotalSubcontracts ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasEUReceivedTenders ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasNonEEAReceivedTenders ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasOtherCountriesReceivedTenders ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasLowestReceivedTenderValue ],
        [ a owl:Restriction ;
            owl:onClass :AwardOutcome ;
            owl:onProperty :summarisesInformationForAwardOutcome ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
