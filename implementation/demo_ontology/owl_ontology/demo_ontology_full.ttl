    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Deadline"@en .

:hasDebitAmount a owl:ObjectProperty ;
    rdfs:domain :RemittanceAdviceLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Debit Amount"@en .

:hasDebitedAccountIdentifier a owl:ObjectProperty ;
    rdfs:domain :PaymentInstructionsInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "An identifier for the account to be debited by the direct debit."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Debited Account Identifier"@en .

:hasDeclaredStatisticalValue a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Consignment :GoodsItem ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The Monetary Value declared for statistical purposes."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Declared Statistical Value"@en .

:hasDeliveryPeriod a owl:ObjectProperty ;
