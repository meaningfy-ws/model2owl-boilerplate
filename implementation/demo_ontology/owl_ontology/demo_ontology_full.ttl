    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "has Expected Delivery Time"@en .

:hasExtension a owl:DatatypeProperty ;
    rdfs:domain adms:Identifier ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "has Extension"@en .

:hasFinancialOfferValue a owl:ObjectProperty ;
