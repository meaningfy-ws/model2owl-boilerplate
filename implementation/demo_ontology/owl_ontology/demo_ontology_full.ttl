    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Contract Value"@en .

:hasCreditAmount a owl:ObjectProperty ;
    rdfs:domain :RemittanceAdviceLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Credit Amount"@en .

:hasCustomerReference a owl:ObjectProperty ;
    rdfs:domain :PostAwardDocument ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "An identifier assigned by the Buyer used for internal routing purposes."@en ;
    skos:historyNote "WG Approval 04/03/2025"@en ;
    skos:prefLabel "has Customer Reference"@en .

:hasDeadline a owl:DatatypeProperty ;
