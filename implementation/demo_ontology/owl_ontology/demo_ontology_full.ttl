    skos:historyNote "WG Approval 16/07/2024"@en ;
    skos:prefLabel "has Despatch Period"@en .

:hasDespatchedQuantity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :DespatchLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The Quantity that has been sent."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Despatched Quantity"@en .

:hasDespatcherConsignmentID a owl:ObjectProperty ;
    rdfs:domain :Consignment ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "The identifier of the the Consignment given by the Despatcher."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Despatcher Consignment ID"@en .

:hasDispatchDate a owl:DatatypeProperty ;
    rdfs:domain :Document ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time of transmission of a record to an Organization. (epo:Document)"@en ;
    skos:historyNote "WG Approval 31/08/2023"@en ;
    skos:prefLabel "has Dispatch Date"@en .

:hasDurationExtensionJustification a owl:DatatypeProperty ;
    rdfs:domain :FrameworkAgreementTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The explanation of the reason why the framework agreement has an extended duration. Additional Information: The justification for exceptional cases when the duration of the framework agreement exceeds the legal limits. Four years in the case of the general procurement Directive, seven years in the case of the defence Directive, and eight years in the case of the sectoral Directive. (epo:FrameworkAgreementTerm)"@en ;
    skos:editorialNote "Used by eForms BT-109"@en ;
    skos:historyNote "WG Approval 26/09/2019"@en ;
    skos:prefLabel "has Duration Extension Justification"@en .

:hasEAuctionURL a owl:DatatypeProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:anyURI ;
    skos:definition "The internet address of the electronic auction. (epo:SubmissionTerm)"@en ;
    skos:editorialNote "Used by eForms BT-123"@en ;
    skos:prefLabel "has E Auction URL"@en .

:hasEEAReceivedTenders a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The amount of tenders received from economic operators in other EEA countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has EEA Received Tenders"@en .

:hasEInvoicing a owl:DatatypeProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Electronic means will be used for invoicing in the post-award process. Additional Information: This attribute is used for standard form mappings. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 12/09/2019"@en ;
    skos:prefLabel "has E Invoicing"@en .

:hasEOrdering a owl:DatatypeProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Electronic means will be used for requesting and purchasing in the post-award process. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 12/09/2019"@en ;
    skos:prefLabel "has E Ordering"@en .

:hasEPayment a owl:DatatypeProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Electronic means must be used for paying. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has E Payment"@en .

:hasESenderDispatchDate a owl:DatatypeProperty ;
    rdfs:domain :Notice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time the notice was transmitted electronically by the eSender to the Publications Office of the European Union. Additional Information: Typically, eSenders include national Official Journals, Buyers sending a large number of electronic Notices, public or private bodies acting on behalf of Buyers and eProcurement software developers. (epo:Notice)"@en ;
    skos:historyNote "WG approval 20/06/2023"@en ;
    skos:prefLabel "has E Sender Dispatch Date"@en .

:hasEUReceivedTenders a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The amount of tenders received from economic operators in other EU countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)"@en ;
    skos:prefLabel "has EU Received Tenders"@en .

:hasElectronicSubmission a owl:DatatypeProperty ;
    rdfs:domain :Tender ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Transmission of tenders is possible by electronic means of communication. (epo:Tender)"@en ;
    skos:prefLabel "has Electronic Submission"@en .

:hasElectronicTenders a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "Electronic Tender Lots received. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 28/07/2020"@en ;
    skos:prefLabel "has Electronic Tenders"@en .

:hasEntryIntoForceDate a owl:DatatypeProperty ;
    rdfs:domain :Contract ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the contract enters into force. Additional information: This is generally the date on which the fulfillment of the contract begins. (epo:Contract)"@en ;
    skos:historyNote "WG Approval 05/11/2019"@en ;
    skos:prefLabel "has Entry Into Force Date"@en .

:hasEstimatedBuyerConcessionRevenue a owl:ObjectProperty ;
    rdfs:domain :ConcessionEstimate ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The expected payments made by the buyer to the economic operator awarded the concession that are not directly related to the use of the concession. <u>Additional Information:</u> For example the public buyer pays a yearly fee to provide a ticketing solution to the public. The fee the public pays for every ticket sold through the solution is not included in this estimation but in the estimation of the user concession revenue."@en ;
    skos:editorialNote "Used by eForms BT-160"@en ;
    skos:historyNote "WG Approval 07/01/2020"@en ;
    skos:prefLabel "has Estimated Buyer Concession Revenue"@en .

:hasEstimatedContractNoticePublicationDate a owl:DatatypeProperty ;
    rdfs:domain :ProcessPlanningTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:date ;
    skos:definition "Foreseen date for publication of Contract Notice. (epo:ProcessPlanningTerm)"@en ;
    skos:editorialNote "Used by eForms BT-127"@en ;
    skos:prefLabel "has Estimated Contract Notice Publication Date"@en .

:hasEstimatedDeliveryPeriod a owl:ObjectProperty ;
    rdfs:domain :ShipmentInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Interval ;
    skos:definition "The forecasted time period given by the Despatcher to provide the goods and services."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Estimated Delivery Period"@en .

:hasEstimatedDuration a owl:ObjectProperty ;
