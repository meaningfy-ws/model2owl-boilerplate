:MonetaryValue a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasAmountValue ;
