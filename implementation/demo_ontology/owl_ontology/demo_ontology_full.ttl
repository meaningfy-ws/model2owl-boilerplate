    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The estimated amount of work to be subcontracted in the contract resulting from the lot. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Estimated Total Subcontracts"@en .

:hasEstimatedUserConcessionRevenue a owl:ObjectProperty ;
    rdfs:domain :ConcessionEstimate ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The estimated revenue coming from the use of the concession. Additional Information: Revenues are for example fees and fines. For example, the fees and fines coming from the cars using a motorway."@en ;
    skos:editorialNote "Used by eForms BT-162"@en ;
    skos:prefLabel "has Estimated User Concession Revenue"@en .

:hasEstimatedValidityPeriod a owl:ObjectProperty ;
