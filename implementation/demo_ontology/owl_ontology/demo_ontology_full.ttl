cccev:Participation a owl:Class ;
    rdfs:label "Participation"@en ;
    rdfs:comment "The Participation class allows to define roles within a certain context."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:scopeNote """The CPSV-AP recognises a common role connected with public services, i.e. the Competent Authority.
<br/><br/>
This simple structure does not allow statements to be made about those participants, such as the start and end date of a contract, nor does it support the inclusion of other roles. The Participation class supports this extra complexity if required, for instance, the description of a service user or a service provider. The model is consistent with the CPOV which in turn is based on the W3C Organization Ontology that supports the common cases simply but allows the complex cases where necessary. The Participation class can be mapped to the Organization Ontology&#39;s Membership class that allows more complex relationships and richer metadata to be applied to a role filled by a given Agent."""@en .

cccev:ReferenceFramework a owl:Class ;
    rdfs:label "Reference Framework"@en ;
    rdfs:comment "Legislation or official policy from which Requirements are derived."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:scopeNote "Usual Reference Frameworks are legal and non-legal specifications. Examples include procedures, tendering legislation, etc."@en .

cccev:bias a owl:DatatypeProperty ;
    rdfs:label "bias"@en ;
    rdfs:comment "Parameter used to adjust the evaluation of the Criterion."@en ;
    rdfs:domain cccev:Criterion ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/bias\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/bias</u></foreign></xref> (cccev:Criterion)"@en ;
    skos:prefLabel "bias"@en ;
    skos:scopeNote "The bias parameter tries to correct a systematic error. For example in procurement, a home bias corresponds to the \"presence of local preferences distorting international specialisation and resource allocation\". When quantified, this systematic error can be removed."@en .

cccev:birthDate a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "date of birth"@en ;
    rdfs:comment "The point in time on which the Person was born."@en ;
    rdfs:domain person:Person ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range cccev:GenericDate,
        xsd:date ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/birthDate\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/birthDate</u></foreign></xref> (person:Person)"@en ;
    skos:prefLabel "birth Date"@en ;
    skos:scopeNote """The date of birth could be expressed as date, gYearMonth or gYear, example:
<ul>
<li>- 1980-09-16^^xs:date</li>
<li>- 1980-09^^xs:gYearMonth</li>
<li>- 1980^^xs:gYear</li>
</ul>"""@en .

cccev:hasRequirement a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "has requirement"@en ;
    rdfs:comment "A more specific Requirement that is part of the Requirement."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :TenderClarificationRequest cccev:Requirement ) ],
        cccev:Requirement ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( cccev:InformationRequirement cccev:Requirement ) ],
        cccev:Requirement ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/hasRequirement\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/hasRequirement</u></foreign></xref>"@en ;
    skos:prefLabel "has Requirement"@en .

cccev:weight a owl:DatatypeProperty ;
    rdfs:label "weight"@en ;
    rdfs:comment "Relative importance of the Criterion."@en ;
    rdfs:domain cccev:Criterion ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/weight\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/weight</u></foreign></xref> (cccev:Criterion)"@en ;
    skos:prefLabel "weight"@en ;
    skos:scopeNote "The weight must be between 0 and 1. Usually, all Criteria can be integrated within a weighted sum equal to 1."@en .

cccev:weightingConsiderationDescription a owl:DatatypeProperty ;
    rdfs:label "weighting consideration description"@en ;
    rdfs:comment "Explanation of how the weighting of a Criterion is to be used."@en ;
    rdfs:domain cccev:Criterion ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral,
        xsd:string ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/weightingConsiderationDescription\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/weightingConsiderationDescription</u></foreign></xref> (cccev:Criterion)"@en ;
    skos:prefLabel "weighting Consideration Description"@en ;
    skos:scopeNote "This description gives the view of the creator of the Criterion weights on how to interpret and use them during the evaluation process."@en .

at-voc:EU-programme a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:EU-programme ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The EU programme authority table (AT) is a controlled vocabulary providing the list of programmes created and coordinated by the European Union and financially supported by the European Union or, in a few cases, by the contributions from the Member States. It has been developed specifically for the EU Budget as open linked data project. It indicates the authority code and start-use date of each concept and gives labels in all official EU languages."@en ;
    skos:prefLabel "E U-programme"@en .

at-voc:access-rights a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:access-rights ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The access-right authority table is a controlled vocabulary listing the access rights or restrictions to resources. It is designed for but not limited to DCAT descriptions of datasets. This authority table is maintained by the Publications Office of the European Union on the EU Vocabularies website."@en ;
    skos:prefLabel "access-rights"@en .

at-voc:accessibility a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:accessibility ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides a list of options for the use of accessibility Criteria for Person with disabilities in the technical specifications within the domain of Public Procurement."@en ;
    skos:prefLabel "accessibility"@en .

at-voc:applicability a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:applicability ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides a list of the options pertinent to be chosen for a matter concerning the applicability of predefined fields. It is designed for but not restricted to the context of public procurement."@en ;
    skos:prefLabel "applicability"@en .

at-voc:award-criterion-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:award-criterion-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of rules to be taken into account for the Award Decisions within the in public Procurement Procedures. The initial values are those foreseen in the public procurement directives of 2014 (Directives 2014/23/EU, 2014/24/EU and 2014/25/EU)."@en ;
    skos:prefLabel "award-criterion-type"@en .

at-voc:buyer-legal-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:buyer-legal-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides a list of the type of Procuring Authorities within the domain of public procurement according to legislation."@en ;
    skos:prefLabel "buyer-legal-type"@en .

at-voc:change-corrig-justification a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:change-corrig-justification ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the codes and values used in case of justification of corrections applied to a Notice within the context of Public Procurement."@en ;
    skos:prefLabel "change-corrig-justification"@en .

at-voc:communication-justification a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:communication-justification ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the justification for restricting access rights to resources within the context of Public Procurement."@en ;
    skos:prefLabel "communication-justification"@en .

at-voc:contract-nature a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:contract-nature ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides a list of different types of subjects and goods that can be acquired by means of a public Contract such as works, supplies and services by one or more Contracting Authorities from Economic Operators."@en ;
    skos:prefLabel "contract-nature"@en .

at-voc:country a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:country ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The Country authority table is a controlled vocabulary that lists concepts associated with names of countries and territories. Its main scope is to support documentary metadata activities. The concepts included are correlated with the ISO 3166 international standard. ISO 3166-1 contains a two-letter code which is recommended as the general purpose code, a three-letter code which has better mnenomic properties and a numeric-3 code which can be useful if script independence of the codes is important. The authority code relies on the ISO 3166-1/alpha-3 positions. If an authority code is needed for a country without assigned ISO code, an alphanumeric code is created in order to not confuse with ISO codes that are strictly alphabetic or numeric. A country code comparison is provided between ISO codes, IANA codes (Internet Country-code Top-level Domains) and TIR (Transport International par la Route) Vehicle system codes."@en ;
    skos:prefLabel "country"@en .

at-voc:cpv a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:cpv ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "To support an effective Single Market, the Commission encourages suppliers and Contracting Authorities/Entities to adopt best practice and use electronic communication and information technology to provide all the relevant information, so as to ensure best value for money in Public Procurement."@en ;
    skos:prefLabel "cpv"@en .

at-voc:criterion a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:criterion ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides Criteria used for Public Procurement Procedures."@en ;
    skos:prefLabel "criterion"@en .

at-voc:cvd-contract-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:cvd-contract-type ;
            owl:onProperty skos:inScheme ] ;
    skos:prefLabel "cvd-contract-type"@en .

at-voc:direct-award-justification a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:direct-award-justification ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of reasons for using a Procedure which allows awarding Contracts directly without the Requirement of publishing a call for competition in the Official Journal of the European Union."@en ;
    skos:prefLabel "direct-award-justification"@en .

at-voc:dps-usage a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:dps-usage ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides a list wether a dynamic purchasing system is involved in a Procurement and, in case of central purchasing bodies, whether it can be used by buyers not listed in the Notice of the Official Journal of the European Union."@en ;
    skos:prefLabel "dps-usage"@en .

at-voc:economic-operator-size a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:economic-operator-size ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the different categories in which the Tenderers to whom a Contract can be awarded are classified, according to their size (using as Criteria the number of employees)."@en ;
    skos:prefLabel "economic-operator-size"@en .

at-voc:energy-efficiency-basis a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:energy-efficiency-basis ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The Energy efficiency basis table is a controlled vocabulary that lists the basis on which energy efficiency is calculated."@en ;
    skos:prefLabel "energy-efficiency-basis"@en .

at-voc:energy-efficiency-item a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:energy-efficiency-item ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The Energy efficiency item table is a controlled vocabulary that lists the products, works and services covered by any of the following: - The Ecodesign Directive - European Union green public procurement criteria - Regulation 2020/740 - Buildings covered by the obligation in Article 7 EED"@en ;
    skos:prefLabel "energy-efficiency-item"@en .

at-voc:energy-efficiency-label a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:energy-efficiency-label ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The Energy efficiency label table is a controlled vocabulary that lists the rank of appliances on an energy scale according to how much energy they consume."@en ;
    skos:prefLabel "energy-efficiency-label"@en .

at-voc:environmental-impact a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:environmental-impact ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the information about whether a Procurement includes a process to procure goods, services and works with a reduced Environmental Impact throughout their life cycle."@en ;
    skos:prefLabel "environmental-impact"@en .

at-voc:exclusion-ground a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:exclusion-ground ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "Exclusion grounds in public procurement refer to the criteria that prevent certain entities from participating in public contracts due to criminal offenses, tax breaches, or other specified misconduct, aiming to ensure fairness and integrity in public procurement processes."@en ;
    skos:prefLabel "exclusion-ground"@en .

at-voc:foreign-subsidy-measure-conclusion a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:foreign-subsidy-measure-conclusion ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "On 12 July 2023, the Foreign Subsidies Regulation (FSR) (Regulation (EU) 2022/2560) entered into force. The FSR introduces a new set of rules that enables the Commission to address distortions caused by foreign subsidies. This allows the EU to ensure a level of playing field for all companies operating in the Single Market, while remaining open to trade and investment. This code list is about the situation of Measures applied under the Foreign Subsidies Regulation (EU) 2022/2560. Economic operators bidding in large public procurement procedures must submit a notification or declaration pursuant to Article 28(1) FSR with their tender, which is assessed by the Commission. The economic operators either provide a notification or a declaration under the FSR, depending on the amount of foreign financial contribution received. The contract award notice must acknowledge the Commissionï¿½s assessment, based on the situations described in the code list."@en ;
    skos:prefLabel "foreign-subsidy-measure-conclusion"@en .

at-voc:form-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:form-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the codes and values used for the type of forms published on TED."@en ;
    skos:prefLabel "form-type"@en .

at-voc:framework-agreement a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:framework-agreement ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of codes to distinguish the different type Framework Agreement involved in a Tender."@en ;
    skos:prefLabel "framework-agreement"@en .

at-voc:green-public-procurement-criteria a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:green-public-procurement-criteria ;
            owl:onProperty skos:inScheme ] ;
    skos:prefLabel "green-public-procurement-criteria"@en .

at-voc:innovative-acquisition a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:innovative-acquisition ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the codes and values used for innovative works, supplies or services being bought."@en ;
    skos:prefLabel "innovative-acquisition"@en .

at-voc:international-procurement-instrument-application a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:international-procurement-instrument-application ;
            owl:onProperty skos:inScheme ] ;
    skos:prefLabel "international-procurement-instrument-application"@en .

at-voc:international-procurement-instrument-measure a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:international-procurement-instrument-measure ;
            owl:onProperty skos:inScheme ] ;
    skos:prefLabel "international-procurement-instrument-measure"@en .

at-voc:irregularity-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:irregularity-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This code list refers generally to the types of irregularities described in Section 2 of the Annex to the Commission Decision C(2019) 3452."@en ;
    skos:prefLabel "irregularity-type"@en .

at-voc:language a owl:Class,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:language ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The Language authority table is a controlled vocabulary that lists concepts associated with languages. Its main scope is to support activities associated with publication process. The concepts included are correlated with the ISO 639 international standard. This standard is issued in several parts: ISO 639-1 contains strictly two alphabetic letters (alpha-2), ISO 639-2/B (B = bibliographic) is used for bibliographic purpose (alpha-3), ISO 639-2/T (T = terminology) is used for technical purpose (alpha-3), ISO 639-3 covers all the languages and macro-languages of the world (alpha-3); the values are compliant with ISO 639-2/T. If an authority code is needed for a language without assigned ISO code, an alphanumeric code is created in order to not confuse with ISO codes that are strictly alphabetic."@en ;
    skos:prefLabel "language"@en .

at-voc:legal-basis a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:legal-basis ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the legal basis based on the legal acts used for a given Public Procurement Procedure. The table is provided by the Publications Office."@en ;
    skos:prefLabel "legal-basis"@en .

at-voc:main-activity a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:main-activity ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of main activities of the Buyers. The codes associated with Contracting Authorities are derived from the top level of the Classification of the functions of the government (COFOG) from the United Nations Statistics Division. The codes associated with contracting entities are derived from sectors explicitly falling within the sectoral directive (2014/25/EU Art. 8 - Art. 14)."@en ;
    skos:prefLabel "main-activity"@en .

at-voc:measurement-unit a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:measurement-unit ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The Measurement unit authority table is a controlled vocabulary listing units of measurement with their authority codes. The labels and symbols are given in all official EU languages. If available, the codes are based on the code list recommendation N&#176;. 20 \"Codes for Units of Measure Used in International Trade\" (as revised periodically) maintained and published by UNECE through its Center for Trade Facilitation and Electronic Business (UN/CEFACT). The Measurement unit authority table is maintained by the Publications Office of the European Union on the EU Vocabularies website."@en ;
    skos:prefLabel "measurement-unit"@en .

at-voc:missing-info-submission a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:missing-info-submission ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of codes indicating wether Tenderer-related information (complete or partial) can be supplemented even after the submission deadline."@en ;
    skos:prefLabel "missing-info-submission"@en .

at-voc:modification-justification a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:modification-justification ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the main reasons for modifying a Contract within the domain of Public Procurement."@en ;
    skos:prefLabel "modification-justification"@en .

at-voc-new:certification-label-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc-new:certification-label-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "* environmental/ecological/green, * quality, * social, etc."@en ;
    skos:prefLabel "certification-label-type"@en .

at-voc:non-award-justification a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:non-award-justification ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of reasons of the Buyer for not choosing a Winner in the Procurement Procedure."@en ;
    skos:prefLabel "non-award-justification"@en .

at-voc:non-publication-justification a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:non-publication-justification ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides codes and values for the main reasons for not immediately publishing a Notice within the context of Public Procurement."@en ;
    skos:prefLabel "non-publication-justification"@en .

at-voc:notice-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:notice-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides a list of Public Procurement Notices according to procurement legislation published once a project is approved."@en ;
    skos:prefLabel "notice-type"@en .

at-voc:number-fixed a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:number-fixed ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the codes linked to fix values within the context of Public Procurement."@en ;
    skos:prefLabel "number-fixed"@en .

at-voc:number-threshold a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:number-threshold ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the codes linked to the type of threshold values within the context of Public Procurement."@en ;
    skos:prefLabel "number-threshold"@en .

at-voc:number-weight a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:number-weight ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the codes linked to the type of weight values used in Award Criteria within the context of Public Procurement."@en ;
    skos:prefLabel "number-weight"@en .

at-voc:nuts a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:nuts ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The NUTS classification (Nomenclature of territorial units for statistics) is a hierarchical system for dividing up the economic territory of the EU and the UK. The NUTS 2021 compiles the versions 2010, 2013, 2016 and 2021 of the NUTS classification as well as the Statistical Regions for countries that do not belong to the EU such as candidate countries, potential candidates or countries belonging to the EFTA (European Free Trade Association)."@en ;
    skos:prefLabel "nuts"@en .

at-voc:other-place-service a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:other-place-service ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the broad geopolitical areas linked to the Location of works and the place of performance or delivery within the context of Public Procurement."@en ;
    skos:prefLabel "other-place-service"@en .

at-voc:permission a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:permission ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the codes linked to the different values of permission and/or obligation."@en ;
    skos:prefLabel "permission"@en .

at-voc:procurement-procedure-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:procurement-procedure-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides a list of activities leading to the conclusion of public Contracts used in Public Procurement according to the legislation."@en ;
    skos:prefLabel "procurement-procedure-type"@en .

at-voc:remedy-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:remedy-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table describes the measures taken following a Review."@en ;
    skos:prefLabel "remedy-type"@en .

at-voc:requirement-stage a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:requirement-stage ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table describes when and whether a given Requirement must be provided in a Procedure."@en ;
    skos:prefLabel "requirement-stage"@en .

at-voc:reserved-procurement a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:reserved-procurement ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the values used to indicate wether the participation in the Procurement is reserved for specific Organisations."@en ;
    skos:prefLabel "reserved-procurement"@en .

at-voc:review-body-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:review-body-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table covers the list of organisations providing the review of a given procedure."@en ;
    skos:prefLabel "review-body-type"@en .

at-voc:review-decision-type a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:review-decision-type ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table describes the decision made a review body."@en ;
    skos:prefLabel "review-decision-type"@en .

at-voc:selection-criterion a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:selection-criterion ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of conditions that are concerned for evaluation purposes. In the domain of Public Procurement, Selection Criteria are normally based on a specific legal framework. This codelist is a subset of the ESPD codelist CriterionTaxonomy."@en ;
    skos:prefLabel "selection-criterion"@en .

at-voc:social-objective a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:social-objective ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the values linked to any social objective promoted by the technical specifications, Award Criteria, Selection Criteria or Contract performance conditions included in a Procurement."@en ;
    skos:prefLabel "social-objective"@en .

at-voc:subcontracting-indication a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:subcontracting-indication ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of codes and values used to indicate information regarding the share of parts of a Contract to third parties. The share may refer to the portion of work, services or supplies and/or to the subject matter being subcontracted."@en ;
    skos:prefLabel "subcontracting-indication"@en .

at-voc:subcontracting-obligation a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:subcontracting-obligation ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of codes and values used for the obligation of the Economic Operator of sharing parts of the original Contract to third parties. The share may refer to the portion of work, services or supplies."@en ;
    skos:prefLabel "subcontracting-obligation"@en .

at-voc:vehicle-category a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:vehicle-category ;
            owl:onProperty skos:inScheme ] ;
    skos:prefLabel "vehicle-category"@en .

at-voc:winner-selection-status a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:winner-selection-status ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "This table provides the list of codes and values used to indicate whether a tenderer was chosen to be awarded with a Contract and wether the competition is open."@en ;
    skos:prefLabel "winner-selection-status"@en .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:source a owl:AnnotationProperty .

dc:subject a owl:AnnotationProperty .

dc:type a owl:AnnotationProperty .

dcterms:Frequency a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Frequency"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A rate at which something recurs."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:Jurisdiction a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Jurisdiction"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "The extent or range of judicial, law enforcement, or other authority."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf dcterms:LocationPeriodOrJurisdiction .

dcterms:LicenseDocument a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "License Document"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A legal document giving official permission to do something with a resource."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf dcterms:RightsStatement .

dcterms:LinguisticSystem a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Linguistic System"@en ;
    dcterms:description "Written, spoken, sign, and computer languages are linguistic systems."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A system of signs, symbols, sounds, gestures, or rules used in communication."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:MethodOfAccrual a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Method of Accrual"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A method by which resources are added to a collection."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:MethodOfInstruction a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Method of Instruction"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A process that is used to engender knowledge, attitudes, and skills."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:Period a rdfs:Datatype,
        owl:NamedIndividual ;
    rdfs:label "DCMI Period"@en ;
    dcterms:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "The set of time intervals defined by their limits according to the DCMI Period Encoding Scheme."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-period/> .

dcterms:PeriodOfTime a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Period of Time"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An interval of time that is named or defined by its start and end dates."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf dcterms:LocationPeriodOrJurisdiction .

dcterms:PhysicalMedium a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Physical Medium"@en ;
    dcterms:description "Examples include paper, canvas, or DVD."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A physical material or carrier."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf dcterms:MediaType .

dcterms:PhysicalResource a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Physical Resource"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A material thing."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:Policy a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Policy"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A plan or course of action by an authority, intended to influence and determine decisions, actions, and other matters."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:ProvenanceStatement a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Provenance Statement"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "Any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:SizeOrDuration a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Size or Duration"@en ;
    dcterms:description "Examples include a number of pages, a specification of length, width, and breadth, or a period in hours, minutes, and seconds."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A dimension or extent, or a time taken to play or execute."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf dcterms:MediaTypeOrExtent .

dcterms:Standard a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Standard"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A reference point against which other things can be evaluated or compared."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:contributor a owl:NamedIndividual ;
    rdfs:label "Contributor"@en ;
    dcam:rangeIncludes dcterms:Agent ;
    dcterms:description "The guidelines for using names of persons or organizations as creators apply to contributors."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity responsible for making contributions to the resource."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subPropertyOf dc:contributor .

dcterms:identifier a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "Identifier"@en ;
    dcterms:description "Recommended practice is to identify the resource by means of a string conforming to an identification system. Examples include International Standard Book Number (ISBN), Digital Object Identifier (DOI), and Uniform Resource Name (URN).  Persistent identifiers should be provided as HTTP URIs."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An unambiguous reference to the resource within a given context."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

dcterms:issued a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "Date Issued"@en ;
    dcterms:description "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en ;
    dcterms:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "Date of formal issuance of the resource."@en ;
    rdfs:domain :Document ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdfs:Literal,
        xsd:dateTime ;
    rdfs:subPropertyOf dc:date,
        dcterms:date ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/issued\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/issued</u></foreign></xref> (epo:Document)"@en ;
    skos:historyNote "WG approval 26/01/2023"@en ;
    skos:prefLabel "issued"@en .

rdfs:Class a owl:Class .

skos:notation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain adms:Identifier ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/2009/08/skos-reference/skos.html#notation\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/2009/08/skos-reference/skos.html#notation</u></foreign></xref> (adms:Identifier)"@en ;
    skos:prefLabel "notation"@en .

skos:prefLabel a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cccev:InformationConcept cccev:Requirement ) ] ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/2009/08/skos-reference/skos.html#prefLabel\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/2009/08/skos-reference/skos.html#prefLabel</u></foreign></xref> (cccev:InformationConcept) External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/2009/08/skos-reference/skos.html#prefLabel\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/2009/08/skos-reference/skos.html#prefLabel</u></foreign></xref> (cccev:Requirement)"@en ;
    skos:historyNote "WG Approval 30/05/2023"@en ;
    skos:prefLabel "pref Label"@en .

time:TemporalUnit a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue time:TemporalUnit ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:TemporalUnit\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:TemporalUnit</u></foreign></xref>"@en ;
    skos:prefLabel "Temporal Unit"@en .

time:hasBeginning a owl:ObjectProperty ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:Instant ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:hasBeginning\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:hasBeginning</u></foreign></xref>"@en ;
    skos:prefLabel "has Beginning"@en .

time:hasDuration a owl:ObjectProperty ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:TemporalDuration ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:hasDuration\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:hasDuration</u></foreign></xref>"@en ;
    skos:prefLabel "has Duration"@en .

time:hasEnd a owl:ObjectProperty ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:Instant ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:hasEnd\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:hasEnd</u></foreign></xref>"@en ;
    skos:prefLabel "has End"@en .

time:hasTemporalDuration a owl:ObjectProperty ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:TemporalDuration ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:hasTemporalDuration\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:hasTemporalDuration</u></foreign></xref>"@en ;
    skos:prefLabel "has Temporal Duration"@en .

time:inXSDDate a owl:DatatypeProperty ;
    rdfs:domain time:Instant ;
    rdfs:range xsd:date ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:inXSDDate\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:inXSDDate</u></foreign></xref> (time:Instant)"@en ;
    skos:prefLabel "in XSD Date"@en .

time:inXSDDateTimeStamp a owl:DatatypeProperty ;
    rdfs:domain time:Instant ;
    rdfs:range xsd:dateTime ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:inXSDDateTimeStamp\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:inXSDDateTimeStamp</u></foreign></xref> (time:Instant)"@en ;
    skos:prefLabel "in XSD Date Time Stamp"@en .

time:numericDuration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain time:Duration ;
    rdfs:range xsd:decimal ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:numericDuration\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:numericDuration</u></foreign></xref> (time:Duration)"@en ;
    skos:prefLabel "numeric Duration"@en .

<http://www.w3.org/ns/legal#LegalEntity> a owl:Class .

locn:addressArea a owl:DatatypeProperty ;
    rdfs:domain locn:Address ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.addressarea\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.addressarea</u></foreign></xref> (locn:Address)"@en ;
    skos:prefLabel "address Area"@en .

locn:addressID a owl:ObjectProperty ;
    rdfs:domain locn:Address ;
    rdfs:range adms:Identifier ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.addressID\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.addressID</u></foreign></xref>"@en ;
    skos:prefLabel "address ID"@en .

locn:fullAddress a owl:DatatypeProperty ;
    rdfs:domain locn:Address ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.fulladdress\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.fulladdress</u></foreign></xref> (locn:Address)"@en ;
    skos:prefLabel "full Address"@en .

locn:geographicIdentifier a owl:ObjectProperty ;
    rdfs:domain dcterms:Location ;
    rdfs:range adms:Identifier ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Location.geographicidentifier\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Location.geographicidentifier</u></foreign></xref>"@en ;
    skos:prefLabel "geographic Identifier"@en .

locn:geographicName a owl:DatatypeProperty ;
    rdfs:domain dcterms:Location ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Location.geographicname\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Location.geographicname</u></foreign></xref> (dct:Location)"@en ;
    skos:prefLabel "geographic Name"@en .

locn:geometry a owl:ObjectProperty ;
    rdfs:domain dcterms:Location ;
    rdfs:range locn:Geometry ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Resource.geometry\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Resource.geometry</u></foreign></xref>"@en ;
    skos:prefLabel "geometry"@en .

locn:locatorDesignator a owl:DatatypeProperty ;
    rdfs:domain locn:Address ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.haslocatordesignator\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.haslocatordesignator</u></foreign></xref> (locn:Address)"@en ;
    skos:prefLabel "locator Designator"@en .

locn:locatorName a owl:DatatypeProperty ;
    rdfs:domain locn:Address ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.locatorname\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.locatorname</u></foreign></xref> (locn:Address)"@en ;
    skos:prefLabel "locator Name"@en .

locn:postCode a owl:DatatypeProperty ;
    rdfs:domain locn:Address ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.postcode\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.postcode</u></foreign></xref> (locn:Address)"@en ;
    skos:prefLabel "post Code"@en .

locn:postName a owl:DatatypeProperty ;
    rdfs:domain locn:Address ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.postname\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.postname</u></foreign></xref> (locn:Address)"@en ;
    skos:prefLabel "post Name"@en .

locn:thoroughfare a owl:DatatypeProperty ;
    rdfs:domain locn:Address ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.thoroughfare\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.thoroughfare</u></foreign></xref> (locn:Address)"@en ;
    skos:prefLabel "thoroughfare"@en .

org:OrganizationalUnit a owl:Class ;
    rdfs:subClassOf org:Organization ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/vocab-org/#org:OrganizationalUnit\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/vocab-org/#org:OrganizationalUnit</u></foreign></xref>"@en ;
    skos:historyNote "WG Approval 12/12/2024"@en ;
    skos:prefLabel "Organizational Unit"@en .

:AllowanceChargeInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :isCalculatedOn ] .

:AuxiliaryParty a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AgentInRole ;
    skos:definition "Role of an Agent who may be mentioned in the information exchanged during the Procurement Process but who does not play an active part in it."@en ;
    skos:prefLabel "Auxiliary Party"@en .

:BudgetProvider a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A role of an agent whose Budget is used to pay for the Contract."@en ;
    skos:prefLabel "Budget Provider"@en .

:CatalogueResponse a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :CatalogueProvider ;
            owl:onProperty :specifiesCatalogueProvider ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :CatalogueReceiver ;
            owl:onProperty :specifiesCatalogueReceiver ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:CentralPurchasingBody a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Buyer ;
    skos:definition "Role of an Agent that provides centralised purchasing activities and, possibly, ancillary purchasing activities for other Buyers. Additional Information: In Public Procurement the Role of Central Purchasing Body is carried out by a Contracting Authority for other Contracting Authorities. Contracting Authority procuring activities conducted on a permanent basis, in one of the following forms:[...](b) the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for Contracting Authorities;"@en ;
    skos:historyNote "WG approval 05/08/2021"@en ;
    skos:prefLabel "Central Purchasing Body"@en .

:Certifier a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "The role of an agent who issues a certificate. Additional Information: The certifier is responsible for verifying and confirming the conformance of the instance of the concept to a defined set of criteria."@en ;
    skos:historyNote "WG approval 16/05/2023"@en ;
    skos:prefLabel "Certifier"@en .

:ConcessionContract a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Contract ;
    skos:definition "A Contract between one or more Buyers and one or more Economic Operators giving the right to the Economic Operators to exploit the rights foreseen in the Contract which may include the receipt of Payments."@en ;
    skos:historyNote "WG Approval 24/05/2022"@en ;
    skos:prefLabel "Concession Contract"@en .

:ContextualProjection a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "Projection of an Entity and all of its properties that hold in a given Situation Context. Additional Information: The contextual projection does not have its own identity (-I), is dependent (+D) on the described Entity, and is anti-rigid (~R) We say that ContextualProjection *describes* an Entity. Adaptation of ContextSlices pattern encoding a 4D view. http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices"@en ;
    skos:prefLabel "Contextual Projection"@en .

:ContractAmendment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :updatesContractValue ],
        [ a owl:Restriction ;
            owl:onClass :Contract ;
            owl:onProperty :amendsContract ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:ContractModificationInformation a owl:Class .

:CreditTransferInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasPaymentAccountIdentifier ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasPaymentServiceProviderIdentifier ] .

:DespatchLine a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Quantity ;
            owl:onProperty :hasDespatchedQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasOutstandingQuantity ] .

:DynamicPurchaseSystemTechnique a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Duration ;
            owl:onProperty :hasEstimatedDuration ],
        :Technique ;
    skos:definition "A Technique that allows the selection of Candidates throughout the Procedure via the Qualification Criteria, followed by individual Mini-Competitions for the Award of Purchase Contracts."@en ;
    skos:historyNote "WG approval 23/05/2023"@en ;
    skos:prefLabel "Dynamic Purchase System Technique"@en .

:ESPD a owl:Class .

:ElectronicSignature a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. Additional information: The definition comes from REGULATION (EU) No 910/2014."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Electronic Signature"@en .

:Estimate a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :ContextDescription ;
    skos:definition "An approximate calculation or a judgement of the value, number, Quantity or extent of something."@en ;
    skos:prefLabel "Estimate"@en .

:EvaluationReport a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AwardEvaluationTerm ;
            owl:onProperty :usesEvaluationFormula ],
        [ a owl:Restriction ;
            owl:onClass :TenderAwardOutcome ;
            owl:onProperty :providesRankToTender ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:EvaluationTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Term ;
    skos:definition "Conditions and stipulations defining particularities of the Tender evaluation."@en ;
    skos:historyNote "WG approval 23/11/2018"@en ;
    skos:prefLabel "Evaluation Term"@en .

:GoodsItem a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasTraceID ] .

:JuryMember a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass person:Person ;
            owl:onProperty :playedBy ],
        :AcquiringParty ;
    skos:definition "Role of an Agent who evaluates a design contest."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Jury Member"@en .

:Line a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Document ;
            owl:onProperty :hasAssociatedDocument ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] .

:Mediator a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent that attempts to resolve a dispute between different Agents and come to an agreement."@en ;
    skos:historyNote "WG approval 20/04/2021"@en ;
    skos:prefLabel "Mediator"@en .

:NonDisclosureAgreementTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isNonDisclosureAgreementRequired ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ],
        :Term ;
    skos:definition "Conditions and stipulations about a non-disclosure agreement. Additional information: A non-disclosure agreement is a Contract between different parties which ensures information is not shared with other parties."@en ;
    skos:historyNote "WG approval 26/03/2024"@en ;
    skos:prefLabel "Non Disclosure Agreement Term"@en .

:OfflineAccessProvider a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent responsible for providing offline access to the Procurement Documents."@en ;
    skos:prefLabel "Offline Access Provider"@en .

:OriginatorRequest a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "Document in which the Originator describes his needs."@en ;
    skos:historyNote "WG approval 09/02/2023"@en ;
    skos:prefLabel "Originator Request"@en .

:ParticipationRequestProcessor a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent responsible for processing Requests To Participate."@en ;
    skos:prefLabel "Participation Request Processor"@en .

:ParticipationRequestReceiver a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent responsible for receiving Requests To Participate."@en ;
    skos:prefLabel "Participation Request Receiver"@en .

:ParticipationRequestTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ParticipationRequestReceiver ;
            owl:onProperty :definesParticipationRequestReceiver ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ParticipationRequestProcessor ;
            owl:onProperty :definesParticipationRequestProcessor ],
        :Term ;
    skos:definition "Conditions and stipulations defining particularities of requesting participation in a Procedure."@en ;
    skos:prefLabel "Participation Request Term"@en .

:PaymentExecutor a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent responsible for executing the Payment."@en ;
    skos:prefLabel "Payment Executor"@en .

:PlannedProcurement a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :ProcurementElement ;
    skos:prefLabel "Planned Procurement"@en .

:PreMarketConsultationNotice a owl:Class .

:ProcurementDocument a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "Document produced or referred to by the Buyer to describe or determine elements of the Procurement. Additional information: Procurement Documents are to be accessible since the date of publication of the Contract Notice or the prior information Notice when used as a call for competition. Examples of Procurement Documents are Technical Specifications, the Descriptive Document, proposed conditions of Contract, formats for the presentation of Documents by Candidates and Tenderers, information on generally applicable obligations. Other Documents related to the Procedure such as Notices are not considered to be Procurement Documents."@en ;
    skos:historyNote "WG Approval 23/05/2019"@en ;
    skos:prefLabel "Procurement Document"@en .

:ProcurementProcedureInformationProvider a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent responsible for providing additional information about the Procurement Procedure."@en ;
    skos:prefLabel "Procurement Procedure Information Provider"@en .

:PurchaseContract a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MiniCompetitionAwardOutcome ;
            owl:onProperty :resultsFromMiniCompetitionAwardOutcome ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :FrameworkAgreement ;
            owl:onProperty :followsRulesSetBy ],
        :Contract ;
    skos:definition "A Contract resulting from using a Dynamic Purchasing System Technique or Framework Agreement Technique."@en ;
    skos:prefLabel "Purchase Contract"@en .

:ReviewProcedureInformationProvider a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent who is providing more information on the time limits for review Procedures."@en ;
    skos:prefLabel "Review Procedure Information Provider"@en .

:SelectionCriterion a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isUsedForCandidateRestriction ],
        :QualificationCriterion ;
    skos:definition "Criterion that describes a capacity Requirement that the Economic Operator needs to fulfill to participate in the procurement. Additional Information: Selection criteria may relate to: (a) suitability to pursue the professional activity; (b) economic and financial standing; (c) technical and professional ability"@en ;
    skos:historyNote "WG approval 31/10/2018"@en ;
    skos:prefLabel "Selection Criterion"@en .

:TemperatureSpecification a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMaximumTemperature ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMinimumTemperature ] .

:TenderClarificationRequest a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty cccev:hasRequirement ;
            owl:someValuesFrom cccev:InformationRequirement ] .

:TenderProcessor a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent responsible for processing Tenders."@en ;
    skos:prefLabel "Tender Processor"@en .

:TenderReceiver a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent responsible for receiving Tenders."@en ;
    skos:prefLabel "Tender Receiver"@en .

:TransportMeans a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasVehicleID ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasVehicleSegmentID ] .

:actsOnBehalfOf a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LegalRepresentative :ProcurementServiceProvider ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :Buyer :OfferingParty ) ] ;
    skos:definition "Represents."@en ;
    skos:prefLabel "acts On Behalf Of"@en .

:announcesLot a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CompetitionNotice :DirectAwardPrenotificationNotice :PlanningNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Lot ;
    skos:prefLabel "announces Lot"@en .

:announcesNoticeAwardInformation a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DirectAwardPrenotificationNotice :ResultNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :NoticeAwardInformation ;
    skos:prefLabel "announces Notice Award Information"@en .

:concernsGreenProcurement a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CleanVehicleDirectiveInformation :EnergyEfficiencyInformation ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :GreenProcurement ;
    skos:definition "Relates to Green Procurement."@en ;
    skos:historyNote "WG Approval 07/05/2024"@en ;
    skos:prefLabel "concerns Green Procurement"@en .

:concernsNotice a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ChangeInformation :NonPublishedInformation ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Notice ;
    skos:definition "Relates to Notice."@en ;
    skos:historyNote "WG Approval 14/05/2024"@en ;
    skos:prefLabel "concerns Notice"@en .

:foreseesConcession a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ProcurementObject :Tender ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ConcessionEstimate ;
    skos:prefLabel "foresees Concession"@en .

:hasAdditionalInformation a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ChangeInformation :Document :ProcurementCriterion :ProcurementElement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Supplementary data about the instance of the concept. (epo:ProcurementElement) Supplementary data about the instance of the concept. (epo:ProcurementCriterion) Supplementary data about the instance of the concept. (epo:Document) Supplementary data about the instance of the concept. (epo:ChangeInformation)"@en ;
    skos:editorialNote "Used by eforms BT-300"@en ;
    skos:historyNote "WG Approval 15/10/2019"@en ;
    skos:prefLabel "has Additional Information"@en .

:hasAddressURL a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Documentation cccev:Channel ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:anyURI ;
    skos:definition "The resource identifier for a Channel. (cv:Channel)"@en ;
    skos:historyNote "WG Approval 26/03/2024"@en ;
    skos:prefLabel "has Address URL"@en .

:hasAmount a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AllowanceChargeInformation :TaxInformation ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The predetermined monetary value charged in addition to the price."@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "has Amount"@en .

:hasAmountDueForPayment a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Amount Due For Payment"@en .

:hasApproximateFrameworkAgreementValue a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LotAwardOutcome :NoticeAwardInformation ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The estimated value to be spent within the Framework Agreement(s). Additional information: In the case of an Award Decision for a Lot, this relation represents the estimated value for the awarded Framework Agreement. In the case of a Notice, this relation represents the estimated value for all Framework Agreements covered by the Notice."@en ;
    skos:prefLabel "has Approximate Framework Agreement Value"@en .

:hasEstimatedValue a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LotGroup :ProcurementElement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "A forecast of the value of the procurement before competition. Additional Information: Different cases of estimated values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. The forecast is calculated by the buyer and covers all revenues whether coming from the buyer or third parties. See for example recital (19), Article 5 of Directive 2014/24/EU and other articles from the rest of Directives about procurement. In the case of framework agreements and dynamic purchasing systems this refers to the maximum estimated value."@en ;
    skos:editorialNote "Used by eForms BT-27, can be used for BT-157"@en,
        "Used by eForms BT-27,eForms BT-157"@en ;
    skos:historyNote "WG Approval 05/12/2019"@en ;
    skos:prefLabel "has Estimated Value"@en .

:hasGrossVolume a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The amount of space that is required including the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Gross Volume"@en .

:hasGrossWeight a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The total mass of goods including the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Gross Weight"@en .

:hasLaunchFrameworkAgreementMaximumValue a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LotGroup :ProcurementObject ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Launch Framework Agreement Maximum Value"@en .

:hasLotReference a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Contract :Invoice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Lot ;
    skos:prefLabel "has Lot Reference"@en .

:hasMeasure a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DimensionInformation :EnvironmentalEmissionInformation ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Measure"@en .

:hasNetWeight a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The total mass of goods without the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Net Weight"@en .

:hasPurpose a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Contract :ProcurementElement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Purpose ;
    skos:definition "Relation indicating the Purpose of a concept."@en ;
    skos:prefLabel "has Purpose"@en .

:hasRoundingAmount a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Rounding Amount"@en .

:hasTotalGoodsItemQuantity a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "Relation indicating the number of the Goods Items."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Total Goods Item Quantity"@en .

:hasTotalLineAmount a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Line Amount"@en .

:hasTotalTaxExclusiveAmount a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Tax Exclusive Amount"@en .

:hasTotalTaxInclusiveAmount a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Tax Inclusive Amount"@en .

:hasTotalValue a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Deliverable :TenderGroup ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Value"@en .

:hasURL a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Fund cccev:Evidence ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:anyURI ;
    skos:definition "The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (cccev:Evidence) The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (epo:Fund)"@en ;
    skos:historyNote "WG Approval 30/09/2019"@en ;
    skos:prefLabel "has URL"@en .

:hasUUID a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CatalogueResponseLine :Document ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "A universally unique identifier for an instance of this document."@en ;
    skos:historyNote "WG Approval 12/05/2020"@en ;
    skos:prefLabel "has UUID"@en .

:isCalculatedOn a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AllowanceChargeInformation :TaxInformation ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The monetary amount to which the multiplier factor is applied in calculating the amount of this allowance, charge or tax."@en ;
    skos:prefLabel "is Calculated On"@en .

:isSMESuitable a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LotGroup :ProcurementElement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "The procurement is suitable for small and medium enterprises (SMEs). (epo:LotGroup) The procurement is suitable for small and medium enterprises (SMEs). (epo:ProcurementElement)"@en ;
    skos:historyNote "WG Approval 15/10/2024"@en ;
    skos:prefLabel "is SME Suitable"@en .

:refersToContract a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ContractLotCompletionInformation :Invoice :RequestForOffer ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Contract ;
    skos:prefLabel "refers To Contract"@en .

:refersToNoticeAwardInformation a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CompletionNotice :ContractModificationNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :NoticeAwardInformation ;
    skos:prefLabel "refers To Notice Award Information"@en .

:refersToProject a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Project ;
    skos:prefLabel "refers To Project"@en .

:relatesToEFormSectionIdentifier a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ChangeInformation :ContractModificationInformation :ReviewInformation ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:prefLabel "relates To E Form Section Identifier"@en .

:specifiesCatalogueProvider a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Catalogue :CatalogueResponse ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :CatalogueProvider ;
    skos:prefLabel "specifies Catalogue Provider"@en .

:specifiesCatalogueReceiver a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Catalogue :CatalogueResponse ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :CatalogueReceiver ;
    skos:prefLabel "specifies Catalogue Receiver"@en .

:specifiesReviewRequester a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ReviewDecision :ReviewRequest ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ReviewRequester ;
    skos:prefLabel "specifies Review Requester"@en .

cccev:AdminUnit a owl:Class ;
    rdfs:label "Administrative Unit"@en ;
    rdfs:comment "A detailed administrative unit organized in a hierarchy."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:scopeNote "This class should be used whenever a classification mechanism is in place, in alternative to the properties adminUnitL1 and adminUnitL2 of the Address class which allow free text."@en .

cccev:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "This class represents an event that can be of any type that triggers, makes use of, or in some way is related to, a Public Service."@en ;
    skos:scopeNote "It is not expected to be used directly, rather, one or other of its subclasses should be used. The properties of the class are, of course, inherited by those subclasses. The Event class is used as a hook either to a single related Public Service, such as diagnosis of illness being related to application for sickness benefit; or to a group of Public Services, such as all those related to the establishment of a new business."@en .

cccev:GenericDate a owl:Class ;
    rdfs:label "Generic date"@en ;
    rdfs:comment "The date data type is the union of  xs:date, xs:gYearMonth and xs:gYear"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

cccev:registeredAddress a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( org:Organization person:Person ) ] ;
    rdfs:range locn:Address ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/registeredAddress\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/registeredAddress</u></foreign></xref>"@en ;
    skos:prefLabel "registered Address"@en .

at-voc:currency a owl:Class,
        owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue at-voc:currency ;
            owl:onProperty skos:inScheme ] ;
    skos:definition "The Currency authority table is a controlled vocabulary that lists concepts associated with currencies and currency subunits. The concepts included are correlated with the ISO 4217 international standard."@en ;
    skos:prefLabel "currency"@en .

dc:identifier a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:MediaTypeOrExtent a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Media Type or Extent"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A media type or extent."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:audience a owl:AnnotationProperty,
        owl:NamedIndividual ;
    rdfs:label "Audience"@en ;
    dcam:rangeIncludes dcterms:AgentClass ;
    dcterms:description "Recommended practice is to use this property with non-literal values from a vocabulary of audience types."@en ;
    dcterms:issued "2001-05-21"^^xsd:date ;
    rdfs:comment "A class of agents for whom the resource is intended or useful."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:coverage a owl:AnnotationProperty,
        owl:NamedIndividual ;
    rdfs:label "Coverage"@en ;
    dcam:rangeIncludes dcterms:Jurisdiction,
        dcterms:Location,
        dcterms:Period ;
    dcterms:description "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended practice is to use a controlled vocabulary such as the Getty Thesaurus of Geographic Names [[TGN](https://www.getty.edu/research/tools/vocabulary/tgn/index.html)]. Where appropriate, named places or time periods may be used in preference to numeric identifiers such as sets of coordinates or date ranges.  Because coverage is so broadly defined, it is preferable to use the more specific subproperties Temporal Coverage and Spatial Coverage."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "The spatial or temporal topic of the resource, spatial applicability of the resource, or jurisdiction under which the resource is relevant."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subPropertyOf dc:coverage .

dcterms:format a owl:NamedIndividual ;
    rdfs:label "Format"@en ;
    dcam:rangeIncludes dcterms:Extent,
        dcterms:MediaType ;
    dcterms:description "Recommended practice is to use a controlled vocabulary where available. For example, for file formats one could use the list of Internet Media Types [[MIME](https://www.iana.org/assignments/media-types/media-types.xhtml)].  Examples of dimensions include size and duration."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "The file format, physical medium, or dimensions of the resource."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subPropertyOf dc:format .

dcterms:rights a owl:NamedIndividual ;
    rdfs:label "Rights"@en ;
    dcam:rangeIncludes dcterms:RightsStatement ;
    dcterms:description "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights.  Recommended practice is to refer to a rights statement with a URI.  If this is not possible or feasible, a literal value (name, label, or short text) may be provided."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "Information about rights held in and over the resource."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subPropertyOf dc:rights .

time:ProperInterval a owl:Class ;
    rdfs:subClassOf time:Interval ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:ProperInterval\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:ProperInterval</u></foreign></xref>"@en ;
    skos:prefLabel "Proper Interval"@en .

locn:address a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cccev:ContactPoint dcterms:Location org:Organization ) ] ;
    rdfs:range locn:Address ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Resource.address\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Resource.address</u></foreign></xref>"@en ;
    skos:prefLabel "address"@en .

foaf:Document a owl:Class .

:AwardDecisionNotification a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Tenderer ;
            owl:onProperty :specifiesTenderer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :concernsAwardOutcome ;
            owl:someValuesFrom :AwardOutcome ] .

:CatalogueLine a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMaximumOrderQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMinimumQuantityGuaranteedForDelivery ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasCatalogueLineValidity ] .

:Deliverable a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalValue ] .

:DimensionInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMaximumMeasure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMeasure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMinimumMeasure ] .

:ESPDRequest a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :specifiesProcurementCriterion ;
            owl:someValuesFrom :ProcurementCriterion ] .

:EvaluationBoard a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :UniqueResponsibleOfTheProcurement ;
            owl:onProperty :isAppointedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:EvidenceRequest a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :concernsLot ;
            owl:someValuesFrom :Lot ] .

:ExclusionGround a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :QualificationCriterion ;
    skos:definition "Criterion that describes a legal Requirement to be met by the Economic Operator to be a Candidate in the Procurement."@en ;
    skos:editorialNote "Used by eForms BG-701"@en ;
    skos:historyNote "WG Approval 31/10/2018"@en ;
    skos:prefLabel "Exclusion Ground"@en .

:ExpressionOfInterest a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Document presenting an Economic Operator's Request to be considered for Procedures covering a specific domain."@en ;
    skos:historyNote "WG approval 13/04/2021"@en ;
    skos:prefLabel "Expression Of Interest"@en .

:FrameworkAgreement a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :Contract ;
    skos:definition "An agreement between one or more Contracting Authorities and one or more Economic Operators. Additional Information: When a Framework Agreement is concerned, the FA will result from LotAwardOutcome which describes a Lot which specifies the both the Qualification and Award Criteria."@en ;
    skos:historyNote "WG Approval 18/05/2021"@en ;
    skos:prefLabel "Framework Agreement"@en .

:LocalLegalBasisInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ],
        [ a owl:Restriction ;
            owl:onClass :ProcurementElement ;
            owl:onProperty :concernsProcurementElement ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:prefLabel "Local Legal Basis Information"@en .

:MiniCompetitionAwardOutcome a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :SelectedCandidateList ;
            owl:onProperty :resultsFromUsingCandidateList ],
        :AwardOutcome ;
    skos:definition "Result concerning the mini-competition that was attributed by the Awarder. Additional Information: The mini-competition is the process where multiple winners or candidates of previous stages of a procedure bid for a specific procurement. It is typically used in framework agreements where the suppliers have already been pre-selected, and the mini competition is used to determine which supplier is best suited for a particular project or contract. It is also used in a Dynamic Purchasing System where the suppliers come from a list of Candidates."@en ;
    skos:historyNote "WG Approval 19/03/2024"@en ;
    skos:prefLabel "Mini Competition Award Outcome"@en .

:OrganisationGroup a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass org:Organization ;
            owl:onProperty :leadBy ],
        [ a owl:Restriction ;
            owl:onProperty :hasMember ;
            owl:someValuesFrom org:Organization ],
        org:Organization ;
    skos:definition "Agreed collaboration of several Organisations. Additional Information: This concept has been created to fulfill the need to represent a grouping of Organisations that is not necessarily registered i.e, consortia."@en ;
    skos:historyNote "WG approval 15/04/2021"@en ;
    skos:prefLabel "Organisation Group"@en .

:OrganisationInformationSummary a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :providesOrganisationFinancialCapability ],
        [ a owl:Restriction ;
            owl:onClass org:Organization ;
            owl:onProperty :concernsOrganisation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :providesOrganisationEmployeeQuantity ] .

:ParticipationConditionsSummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :describesVerificationMethod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :describesObjectiveParticipationRules ],
        :ProcurementCriteriaSummary ;
    skos:definition "Overview of the Participation Conditions."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Participation Conditions Summary"@en .

:PaymentInstructionsInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasBankingIdentifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasDebitedAccountIdentifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasMandateIdentifier ] .

:Prize a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasPrizeRank ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasPrizeValue ] ;
    skos:definition "A reward given in a Contest."@en ;
    skos:historyNote "WG approval: 15/04/2021"@en ;
    skos:prefLabel "Prize"@en .

:ProcessPlanningTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasEstimatedContractNoticePublicationDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasAwardDateScheduled ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasEstimatedTenderInvitationDate ],
        :Term ;
    skos:definition "Conditions and stipulations defining particularities of the unfolding of the Procurement Process."@en ;
    skos:prefLabel "Process Planning Term"@en .

:ProfessionalSuitabilitySummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :describesProfession ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :describesProfessionRelevantLaw ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasServiceReservedToParticularProfession ],
        :SelectionCriteriaSummary ;
    skos:definition "Overview of the professional ability required for the economic operator to execute the contract."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Professional Suitability Summary"@en .

:RemittanceAdviceLine a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasDebitAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasCreditAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasBalanceAmount ] .

:ReviewIrregularitySummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasReviewIrregularityCount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :MaskableObject,
        :StatisticalInformation ;
    skos:definition "Overview of the number and type of requests the Buyer received to review any of its decisions (e.g. the Technical Specifications, Award Decision)."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Review Irregularity Summary"@en .

:ReviewRequester a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :OfferingParty ;
    skos:definition "Role of an Agent who requests the review of a (Procurement) Procedure."@en ;
    skos:historyNote "WG Approval 23/10/2021"@en ;
    skos:prefLabel "Review Requester"@en .

:SecurityClearanceTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasDeadline ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isSecurityClearanceRequired ],
        :Term ;
    skos:definition "Conditions and stipulations about the status requested of individuals allowing them access to classified information (state or organisational secrets) or to restricted areas, after completion of a thorough background check."@en ;
    skos:editorialNote "Used by eForms BT-578, eForms BT-78, eForms BT-732"@en ;
    skos:historyNote "WG Approval 20/06/2023"@en ;
    skos:prefLabel "Security Clearance Term"@en .

:SocialProcurement a owl:Class ;
    dcterms:source """Buying Social - A Guide to Taking Account of Social Considerations in Public Procurement (Publications Office of the European Union, 2011) https://op.europa.eu/en/publication-detail/-/publication/cb70c481-0e29-4040-9be2-c408cddf081f/language-en
"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :StrategicProcurement ;
    skos:definition "Approach whereby Buyers seek to procure by fulfilling social objectives. Additional Information: Socially Responsible Public Procurement (SRPP) - ï¿½SRPPï¿½ means Procurement Operations that take into account one or more of the following social considerations: employment opportunities, decent work, compliance with social and labour rights, social inclusion (including persons with disabilities), equal opportunities, accessibility design for all, taking account of sustainability criteria, including ethical trade issues and wider voluntary compliance with corporate social responsibility (CSR), while observing the principles enshrined in the Treaty for the European Union (TFEU) and the Procurement Directives. See Article 18 and Annex X Directive 2014/24."@en ;
    skos:prefLabel "Social Procurement"@en .

:StatisticalInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :ContextDescription ;
    skos:definition "Statistical data on the Procedure and the Lot. Additional Information At the present time Procurement Procedures are not fully electronic. At a later date, information on the Tenders received could be inferred by the data in the eProcurement System. Therefore this class is temporal and should cease to exist in fully electronic Procurement. The need for its presence responds also to the alignment with the Regulation (EU) 2019/1780 (eForms). Attention will have to be paid in the future to possible inconsistencies derived from data placed in other classes and data held in the Statistical Information class; e.g. the TenderEvaluation class (see eEvaluation diagram) has the attribute admissibileTender indicator, which in case of being false, may enter in contradiction with the highest or lowest Tender value for that very same inadmissible Tender."@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "Statistical Information"@en .

:System a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass foaf:Agent ;
            owl:onProperty :isOwnedByAgent ],
        foaf:Agent ;
    skos:definition "Software application used for performing Procurement activities."@en ;
    skos:historyNote "WG Approval 28/04/2020"@en ;
    skos:prefLabel "System"@en .

:announcesProcedure a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CompetitionNotice :DirectAwardPrenotificationNotice :PlanningNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Procedure ;
    skos:prefLabel "announces Procedure"@en .

:announcesRole a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CompetitionNotice :CompletionNotice :DirectAwardPrenotificationNotice :PlanningNotice :ResultNotice ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :AgentInRole ;
    skos:prefLabel "announces Role"@en .

:hasQuantity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Deliverable :InvoiceLine :OrderLine ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Quantity"@en .

:specifiesEconomicOperator a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EvidenceRequest :EvidenceSubmission :ExpressionOfInterest :TenderClarificationRequest ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :OfferingParty ;
    skos:prefLabel "specifies Economic Operator"@en .

dc:coverage a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:format a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dcterms:LocationPeriodOrJurisdiction a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Location, Period, or Jurisdiction"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A location, period of time, or jurisdiction."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:MediaType a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Media Type"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A file format or physical medium."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf dcterms:MediaTypeOrExtent .

dcterms:RightsStatement a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rights Statement"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:title a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "Title"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A name given to the resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AgentInRole :Document :Fund :LotGroup :ProcurementElement :TenderGroup cccev:Evidence foaf:Agent ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral,
        rdfs:Literal ;
    rdfs:subPropertyOf dc:title ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title</u></foreign></xref> (epo:LotGroup) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title</u></foreign></xref> (epo:ProcurementElement) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title</u></foreign></xref> (epo:TenderGroup) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title</u></foreign></xref> (foaf:Agent) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title</u></foreign></xref> (epo:AgentInRole) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title</u></foreign></xref> (epo:Document) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/title</u></foreign></xref> (epo:Fund)"@en ;
    skos:historyNote "WG approval 30/05/2023"@en ;
    skos:prefLabel "title"@en .

foaf:Person a owl:Class ;
    rdfs:subClassOf foaf:Agent ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://xmlns.com/foaf/spec/#term_Person\"><foreign otherprops=\"#0000ff\"><u>http://xmlns.com/foaf/spec/#term_Person</u></foreign></xref>"@en ;
    skos:prefLabel "Person"@en .

:AwardCriterion a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasFixedValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasAwardCriteriaStatedInProcurementDocuments ],
        :MaskableObject,
        :ProcurementCriterion ;
    skos:definition "Criterion that describes a Requirement that the Tender needs to resolve and on which the Tender is evaluated and ranked."@en ;
    skos:historyNote "WG Approval 05/11/2018"@en ;
    skos:prefLabel "Award Criterion"@en .

:Business a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isListedCompany ],
        org:Organization ;
    skos:definition "A private law company registered in a national registry."@en ;
    skos:historyNote "WG Approval 28/04/2020"@en ;
    skos:prefLabel "Business"@en .

:Catalogue a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasValidityPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :CatalogueProvider ;
            owl:onProperty :specifiesCatalogueProvider ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :CatalogueReceiver ;
            owl:onProperty :specifiesCatalogueReceiver ] .

:CatalogueProvider a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :OfferingParty ;
    skos:definition "A Role of an Agent compiling and supplying a Catalogue. Additional Information: The Catalogue Provider Role is usually played by the Agent that acts as a Seller, or by another Agent that acts on behalf of the Seller."@en ;
    skos:historyNote "WG Approval 28/01/2021"@en ;
    skos:prefLabel "Catalogue Provider"@en .

:CatalogueReceiver a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent processing a Catalogue. Additional Information: The Catalogue Receiver may not only receive it but also validate it, process it, etc. The Catalogue Receiver role is usually played by the agent that acts as a Buyer, or by another Agent that acts on behalf of the Buyer."@en ;
    skos:historyNote "WG Approval 28/01/2021"@en ;
    skos:prefLabel "Catalogue Receiver"@en .

:Certificate a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasCertificationNumber ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :CertificationLabel ;
            owl:onProperty :attestedByLabel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Certifier ;
            owl:onProperty :issuedByCertifier ],
        cccev:Evidence ;
    skos:definition "Proof of conformance of the instance of the concept to a defined set of criteria. Additional Information: Certificates provide assurance of credibility, trust, and transparency in the procurement process."@en ;
    skos:historyNote "WG approval 16/05/2023"@en ;
    skos:prefLabel "Certificate"@en .

:CertificationLabel a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasReferenceURI ],
        cccev:InformationConcept ;
    skos:definition "Concept that stands for a set of norms, expectations, standards and policies. Additional Information: Such standards may relate to social, ethical and quality etc."@en ;
    skos:historyNote "WG approval 26/07/2022"@en ;
    skos:prefLabel "Certification Label"@en .

:CompetitionNotice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :announcesLot ;
            owl:someValuesFrom :Lot ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :announcesProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :announcesRole ;
            owl:someValuesFrom :AgentInRole ] .

:DeliveryInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasDeliveryPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasTrackingID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass dcterms:Location ;
            owl:onProperty :specifiesPlaceOfDelivery ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasRequestedDeliveryPeriod ] .

:DirectAwardTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Procedure ;
            owl:onProperty :refersToPreviousProcedure ],
        :MaskableObject,
        :Term ;
    skos:definition "Conditions and stipulations defining particularities of the award of a Contract without prior publication. Addtional Information: Direct award may refer to a previous Procedure and/or specific Lot(s). It may also refer to other justified situations whereby there is no previous Procedure. See Directive 2014/24/EU Article 32."@en ;
    skos:historyNote "WG Approval 22/11/2019"@en ;
    skos:prefLabel "Direct Award Term"@en .

:EvidenceSubmission a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :concernsLot ;
            owl:someValuesFrom :Lot ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:FrameworkAgreementTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasDurationExtensionJustification ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasMaximumParticipantsNumber ],
        :Term ;
    skos:definition "Conditions and stipulations defining particularities in a Framework Agreement."@en ;
    skos:prefLabel "Framework Agreement Term"@en .

:InvoiceLine a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasInvoiceLinePeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasInvoiceLineObjectIdentifier ],
        [ a owl:Restriction ;
            owl:onClass :Quantity ;
            owl:onProperty :hasQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasNetAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:ItemProperty a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMaximumValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMinimumValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasQualifiedValue ] .

:Offer a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cccev:Evidence ;
            owl:onProperty :providesEvidence ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Document providing the Monetary Value and the details to fulfill the Requirements set out in the Procurement Documents or Request for Offer. Additional information: A quotation is considered to be an Offer in the eProcurement Ontology."@en ;
    skos:historyNote "WG approval 09/02/2023"@en ;
    skos:prefLabel "Offer"@en .

:OpeningTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasOpeningURL ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasOpeningPlace ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasOpeningDateTime ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :Term ;
    skos:definition "Conditions and stipulations defining particularities of the opening of Tenders. Additional Information: The opening of Tenders is the event when Tenders are made accessible for evaluation, it is generally the same date and time for all Tenders."@en ;
    skos:historyNote "WG Approval 15/04/2021"@en ;
    skos:prefLabel "Opening Term"@en .

:ProcurementServiceProvider a owl:Class ;
    dcterms:source "Directive 2014/24/EU, Article 2, paragraphs 17 and 15."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :actsOnBehalfOf ;
            owl:someValuesFrom :Buyer ],
        :AcquiringParty ;
    skos:definition "Role of a public or private body which offers ancillary purchasing activities on the market. Additional information: \"Ancillary Purchasing Activities\" means activities consisting in the provision of support to purchasing activities, in particular in the following forms: (a) technical infrastructure enabling Contracting Authorities to award Public Contracts or to conclude Framework Agreements for works, supplies or services; (b) advice on the conduct or design of public Procurement Procedures; (c) preparation and management of Procurement Procedures on behalf and for the account of the Contracting Authority concerned; This would be equivalent to the concept of 'ProcuringEntity' in OCDS: 'The Entity managing the Procurement, which may be different from the Buyer who is paying / using the items being procured'."@en ;
    skos:historyNote "WG Approval 24/03/2020"@en ;
    skos:prefLabel "Procurement Service Provider"@en .

:Project a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] ;
    skos:definition "A collaborative enterprise that is carefully planned to achieve a particular aim."@en ;
    skos:prefLabel "Project"@en .

:QualificationCriteriaSummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :ProcurementCriteriaSummary ;
    skos:definition "Overview of the Qualification Criteria."@en ;
    skos:historyNote "WG Approval 19/03/2024"@en ;
    skos:prefLabel "Qualification Criteria Summary"@en .

:ReceiptAdviceLine a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasRejectedQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasOversupplyQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasShortQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasReceivedQuantity ] .

:RemittanceAdvice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalCreditAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalPaymentAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalDebitAmount ],
        [ a owl:Restriction ;
            owl:onClass :Buyer ;
            owl:onProperty :specifiesBuyer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:Response a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :refersToApplicablePeriod ] .

:ReviewInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :relatesToEFormSectionIdentifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ReviewDecision ;
            owl:onProperty :concernsReviewDecision ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ReviewRequest ;
            owl:onProperty :concernsReviewRequest ] ;
    skos:prefLabel "Review Information"@en .

:ReviewRequestSummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasTotalNumberOfComplainants ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasNumberOfReviewRequests ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Lot ;
            owl:onProperty :concernsReviewSummaryForLot ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :MaskableObject,
        :StatisticalInformation ;
    skos:definition "Overview of the requests received by the Buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC, and about the complainants that submitted the requests."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Review Request Summary"@en .

:Reviewer a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "Role of an Agent who investigates the overall correctness of a Procurement Procedure, producing a related report. Additional Information: Any Organisation or Person may request a review of a Procurement Procedure."@en ;
    skos:historyNote "WG approval 20/04/2021"@en ;
    skos:prefLabel "Reviewer"@en .

:SelectedCandidateList a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasStartDate ] ;
    skos:definition "Record of Candidates admitted to take part in award phases of procurements."@en ;
    skos:historyNote "WG approval 30/05/2023"@en ;
    skos:prefLabel "Selected Candidate List"@en .

:ShipmentInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasDespatchPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasEstimatedDeliveryPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass dcterms:Location ;
            owl:onProperty :specifiesPlaceOfDespatch ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] .

:SpecificationInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasSourceSpecificationCustomisation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :isUsedInProfile ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasSourceVersionSpecification ] ;
    skos:prefLabel "Specification Information"@en .

:Subcontractor a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :OfferingParty ;
    skos:definition "A Role of an Agent that has an agreement to perform part or all of the obligations of another Agents's Contract. Additional information For some Procedures, the Subcontractor signs as well the Contract between the Buyer and the Contractor. At tendering time, entities relied upon by the Economic Operators can be Subcontractors or not. When modelling ESPD we will analyze whether we need or not a Role named \"relied upon\"."@en ;
    skos:historyNote "WG approval 05/08/2021"@en ;
    skos:prefLabel "Subcontractor"@en .

:TaxInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :isCalculatedOn ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasAmount ] .

:UniqueResponsibleOfTheProcurement a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass person:Person ;
            owl:onProperty :playedBy ],
        :AcquiringParty ;
    skos:prefLabel "Unique Responsible Of The Procurement"@en .

:hasValidityPeriod a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Catalogue :Order :Technique cccev:Evidence ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Interval ;
    skos:definition "The relation indicating until when a given instance of a concept is applicable."@en ;
    skos:historyNote "WG Approval 30/05/2023"@en ;
    skos:prefLabel "has Validity Period"@en .

cccev:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "Limitation applied to an Information Concept."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasThresholdValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :MaskableObject,
        cccev:Requirement ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/Constraint\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/Constraint</u></foreign></xref>"@en ;
    skos:prefLabel "Constraint"@en ;
    skos:scopeNote "Constraints are requirements in themselves, since they impose prerequisites which influence the definition, use and/or fulfilment of the requirement. They represent hard conditions such as minimum or maximum expressions which can be used to evaluate pieces of information, the required age, income, involvement in activities, etc. An example from the eProcurement domain is a threshold as the minimum turnover required by the buying organisation to select the candidates. Note that CCCEV does not provide any specific guidance on when which kind of Requirement should be used. Users of this vocabulary should make decisions on this topic in their specific context."@en .

cccev:EvidenceTypeList a owl:Class ;
    rdfs:label "Evidence Type List"@en ;
    rdfs:comment "Group of Evidence Types for conforming to a Requirement."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] ;
    skos:scopeNote """An Evidence Type List is satisfied, if and only if, for all included Evidence Types in this List, corresponding conformant Evidence(s) are supporting the Requirement having this List. 

The Evidence Type List describes thus an AND condition on the different Evidence Types within the list and an OR condition between two or more Evidence Type Lists. Combinations of alternative Lists can be provided for a respondent of a Requirement to choose amongst them."""@en .

cccev:SupportedValue a owl:Class ;
    rdfs:label "Supported Value"@en ;
    rdfs:comment "Value for an Information Concept that is provided by an Evidence."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:scopeNote """The notion of Supported Value is closely related to actual data exchange between two parties: 
(a) the Requirement processor, i.e. the Agent setting out Requirements for an objective and processing the supplied Evidences in the context of the Requirements, and 
(b) the Evidence provider, i.e. the Agent supplying information to an information request expressed as Requirements.

The Requirement processor has expressed its expectations (both business as technical) for the information it wants to recieve as an Information Concept. The Evidence provider is able to supply information for that Information Concept, but its native data representation might not be coherent with the expectations set by the Requirement processor. The Supported Value is bridging both. 

The Evidence provider can either provide a derived value (fact) from its native data representation that complies with the Information Concept expectations. Or it can provide a query in an agreed language between Evidence provider and Requirement processor that allows the Requirement processor to retrieve the value from the native data representation.

Implementers are free to choose their language. It is recommended to document the made agreements well.
"""@en .

dcterms:Agent a dcterms:AgentClass,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Agent"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A resource that acts or has the power to act."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

dcterms:AgentClass a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Agent Class"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A group of agents."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf rdfs:Class .

:AwardDecision a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasAwardDecisionDate ] ;
    skos:definition "Resolution of the Buyer as to the result of the Procurement Procedure."@en ;
    skos:historyNote "WG Approval 14/11/2018"@en ;
    skos:prefLabel "Award Decision"@en .

:Documentation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasAddressURL ] ;
    skos:prefLabel "Documentation"@en .

:GreenProcurement a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :usesCleanVehicleDirective ],
        :StrategicProcurement ;
    skos:definition "Approach whereby Buyers seek to procure with a reduced Environmental Impact. Additional Information: The approach may apply to the complete life cycle. The reduced Environmental Impact is in comparison to goods, services and works with the same primary function that would otherwise be procured. Tightly related are article 68 - Life-cycle costing and article 67 - most economically advantageous Tender (see GPP handbook) https://ec.europa.eu/environment/gpp/pdf/Buying-Green-Handbook-3rd-Edition.pdf An instance of the class GreenProcurement is represented in eForms with the code \"env-imp\" defined in the codelist Strategic-Procurement.Paragraphs) https://ec.europa.eu/environment/gpp/pdf/Buying-Green-Handbook-3rd-Edition.pdf"@en ;
    skos:prefLabel "Green Procurement"@en .

:InternationalProcurementInstrumentMeasuresInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasPublicInterestExceptionJustification ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasNumberOfTendersConcerned ],
        :ContextDescription ;
    skos:prefLabel "International Procurement Instrument Measures Information"@en .

:LotGroupAwardInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasApproximateGroupFrameworkAgreementValue ],
        [ a owl:Restriction ;
            owl:onClass :LotGroup ;
            owl:onProperty :describesLotGroup ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasGroupFrameworkAgreementMaximumValue ],
        :ContextDescription ;
    skos:definition "Award information related to a given Group of Lots."@en ;
    skos:prefLabel "Lot Group Award Information"@en .

:ProcurementCriteriaSummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :indicatesPerformingStaffInformationRequirement ],
        cccev:Requirement ;
    skos:definition "Overview of the Procurement Criteria."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Procurement Criteria Summary"@en .

:ProcurementProcessInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isDPSTerminated ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Lot ;
            owl:onProperty :concernsLot ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isCompetitionTerminated ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isToBeRelaunched ],
        :ContextDescription ;
    skos:definition "Information about the temporal unfolding or succession of Procurement Objects."@en ;
    skos:prefLabel "Procurement Process Information"@en .

:ReviewTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ReviewProcedureInformationProvider ;
            owl:onProperty :definesReviewProcedureInformationProvider ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasReviewDeadline ],
        :Term ;
    skos:definition "Conditions and stipulations defining particularities of the review."@en ;
    skos:historyNote "WG approval 23/11/2018"@en ;
    skos:prefLabel "Review Term"@en .

:SelectionCriteriaSummary a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasSelectionCriteriaStatedInProcurementDocuments ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :describesMinimumLevelOfStandards ],
        :QualificationCriteriaSummary ;
    skos:definition "Overview of the Selection Criteria."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Selection Criteria Summary"@en .

:StrategicProcurement a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "Public Procurement that contributes to achieving pressing policy goals. Additional Information: Specific strategic goals could be, for example, Environmental Protection, innovation, job creation and the development of small and medium enterprises. The subclasses are given by the choices in BT-06 Strategic Procurement. Based on https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0411 (see paragraph on \"background information\"."@en ;
    skos:editorialNote "Used by eForms BG-713"@en ;
    skos:historyNote "WG Approval 10/03/2020"@en ;
    skos:prefLabel "Strategic Procurement"@en .

:Winner a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Tenderer ;
            owl:onProperty :needsToBeATenderer ],
        :OfferingParty ;
    skos:definition "A Role of an Agent to whom a Lot is awarded."@en ;
    skos:historyNote "WG Approval 26/10/2021"@en ;
    skos:prefLabel "Winner"@en .

:playedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AgentInRole :Evaluator :JuryMember :TransportMeansOperator :UniqueResponsibleOfTheProcurement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( person:Person foaf:Agent foaf:Person ) ] ;
    skos:prefLabel "played By"@en .

time:TemporalDuration a owl:Class ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:hasTemporalDuration\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:hasTemporalDuration</u></foreign></xref>"@en ;
    skos:prefLabel "Temporal Duration"@en .

:CleanVehicleDirectiveInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasTotalVehicles ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasZeroEmissionVehicles ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasCleanVehicles ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :GreenProcurement ;
            owl:onProperty :concernsGreenProcurement ],
        :ContextDescription ;
    skos:definition "Information related to clean vehicles legislation. Additional information: In the European Union, the legislation concerned is the European Parliament and Council 2009/33/EC (Clean Vehicles Directive ï¿½ CVD)."@en ;
    skos:historyNote "WG approval 07/05/2024"@en ;
    skos:prefLabel "Clean Vehicle Directive Information"@en .

:ContractLotCompletionInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasPaymentValueDiscrepancyJustification ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :LotGroup ;
            owl:onProperty :concernsLotGroup ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Lot ;
            owl:onProperty :concernsLot ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :providesContractTotalPaymentValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :providesContractTotalPenaltyValue ],
        [ a owl:Restriction ;
            owl:onClass :Contract ;
            owl:onProperty :refersToContract ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :ContextDescription ;
    skos:definition "Information related to a given Lot at the end of the procurement."@en ;
    skos:prefLabel "Contract Lot Completion Information"@en .

:DesignContestRegimeTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasParticipationPayment ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasDescriptionOfPrizes ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasFollowupContract ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isJuryDecisionBinding ],
        :Term ;
    skos:definition "Conditions and stipulations defining particularities of a Design Contest."@en ;
    skos:historyNote "WG approval 04/02/2021"@en ;
    skos:prefLabel "Design Contest Regime Term"@en .

:Fund a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasURL ] ;
    skos:definition "A financial resource used to support the Procurement. Additional Information: In the context of EU, Funds can be divided into programmes, actions and projects. Examples of EU funds are: the European Structural and Investment Funds, European Social Fund (ESF), the Connecting Europe Facility (CEF) programme, or the ISA2 programme and its actions (e.g. Action 2016.05 European Public Procurement Initiative, which supports the eProcurement Ontology under sub-action 3). Funds may change between the lot and the contract, for example in the case of an emergency crisis, a contract may be financed by a budget that was not foreseen in the call."@en ;
    skos:historyNote "WG Approval 14/05/2019"@en ;
    skos:prefLabel "Fund"@en .

:NonPublishedInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasAccessibilityDate ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasMaskableProperty ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasConfidentialityJustification ],
        [ a owl:Restriction ;
            owl:onClass :MaskableObject ;
            owl:onProperty :concernsMaskedObject ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Notice ;
            owl:onProperty :concernsNotice ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :ContextDescription ;
    skos:definition "Information about fields not published in this Notice. Additional Information: The non-published information may become available at a later date and may differ from one element to another within a given Document. Examples of fields that may not be immediately published are Winner, Tender and Procedure Lot Result, etc., e.g. for security reasons."@en ;
    skos:prefLabel "Non Published Information"@en .

:PlannedProcurementPart a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Duration ;
            owl:onProperty :hasPlannedDuration ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasPlannedPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ProcurementObject ;
            owl:onProperty :foreseesProcurementObject ],
        :ProcurementElement ;
    skos:definition "A subdivision of a Planned Procurement that may later become one or more Lots or a self-standing Procedure. A Lot or a Procedure can also cover one or more parts of the Planned Procurement."@en ;
    skos:historyNote "WG Approval 20/06/2019"@en ;
    skos:prefLabel "Planned Procurement Part"@en .

:PlanningNotice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :announcesRole ;
            owl:someValuesFrom :AgentInRole ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Procedure ;
            owl:onProperty :announcesProcedure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :PlannedProcurement ;
            owl:onProperty :announcesPlannedProcurement ] .

:Purpose a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasTotalQuantity ] ;
    skos:definition "The description of the objectives related to a Procurement. Additional information: The description of the objectives includes the Subject Matter and Quantities. The quantification of the objectives related to a procurement. To be re-reviewed by the WG the soonest. (WG to be discussed, this was pointed out on the 09/04/2019 14:38:25 WG Meeting) The old definition read as follows: The description of the objectives related to a procurement."@en ;
    skos:historyNote "WG approval 05/12/2018"@en ;
    skos:prefLabel "Purpose"@en .

:RequestForOffer a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Contractor ;
            owl:onProperty :specifiesContractor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Buyer ;
            owl:onProperty :specifiesBuyer ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :specifiesOfferValidityPeriod ] .

:TenderGroup a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :LotGroup ;
            owl:onProperty :isSubmittedForLotGroup ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :comprisesTender ;
            owl:someValuesFrom :Tender ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] ;
    skos:definition "Specific Offer in response to a Lot Group. Additional Information: This class is generally used to provide the Monetary Value in response to a Lot Group."@en ;
    skos:prefLabel "Tender Group"@en .

cccev:Channel a owl:Class ;
    rdfs:label "Channel"@en ;
    rdfs:comment "A medium through which an Agent provides, uses or interacts in another way with a Public Service."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasAddressURL ] ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/Channel\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/Channel</u></foreign></xref> Additional Information Software solutions and electronic devices for communication and exchange of information between Buyers and economic Operators. Lots may use ad-hoc electronic means of communication that are not generally available such as specific solutions for secure and dedicated communication or non-standard eCatalogues. See also Directive recitals 53 to 56."@en ;
    skos:historyNote "WG Approval 14/02/2023"@en ;
    skos:prefLabel "Channel"@en ;
    skos:scopeNote "Typical examples include online services, phone, walk-in centres etc."@en .

cccev:Criterion a owl:Class ;
    rdfs:label "Criterion"@en ;
    rdfs:comment "Condition for evaluation or assessment."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty cccev:weight ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty cccev:weightingConsiderationDescription ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty cccev:bias ],
        cccev:Requirement ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/Criterion\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/Criterion</u></foreign></xref>"@en ;
    skos:prefLabel "Criterion"@en ;
    skos:scopeNote """In general, Criteria are used for comparison, filtering or selection purposes. Criteria usually set minimum conditions (e.g. limits, intervals, thresholds, etc.) that need to be met in order to pass the requirements or to fulfil them to a certain degree or quality. The concept of Criteria is broader than the concept of Constraint since it covers more usages. The evaluation of the fulfilment is usually supported by the provision of Evidence. 
For example in the eProcurement domain, the eProcurement Ontology defines different subclasses of Criterion such as exclusion grounds, selection criteria or award criteria. A concrete example of a Criterion is 'participation in a criminal organisation' which could also be considered as an exclusion ground criterion in the procurement domain or for requiring a public service."""@en .

cccev:EvidenceType a owl:Class ;
    rdfs:label "Evidence Type"@en ;
    rdfs:comment "Information about the characteristics of an Evidence."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] ;
    skos:scopeNote "The Evidence Type and the characteristics it describes are not concrete individual responses to a Requirement (i.e. Evidence), but descriptions about the desired form, content, source and/or other characteristics that an actual response should have and provide (e.g. membership of a class of Evidences)."@en .

time:Instant a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty time:inXSDDateTimeStamp ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty time:inXSDDate ],
        time:TemporalEntity ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:Instant\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:Instant</u></foreign></xref>"@en ;
    skos:prefLabel "Instant"@en .

:AwardEvaluationTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasAwardCriteriaOrderJustification ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasOverallCostAwardCriteriaPonderation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasOverallPriceAwardCriteriaPonderation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasOverallQualityAwardCriteriaPonderation ],
        :EvaluationTerm,
        :MaskableObject ;
    skos:definition "Conditions and stipulations defining particularities of the evaluation of Award Criteria."@en ;
    skos:prefLabel "Award Evaluation Term"@en .

:ConcessionEstimate a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasCalculationMethod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasEstimatedUserConcessionRevenue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasConcessionEstimatedValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasEstimatedBuyerConcessionRevenue ],
        :Estimate,
        :MaskableObject ;
    skos:definition "Approximation concerning the foreseen Concession Contract."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Concession Estimate"@en .

:Contractor a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Subcontractor ;
            owl:onProperty :foreseesSubcontractor ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Winner ;
            owl:onProperty :needsToBeAWinner ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Subcontractor ;
            owl:onProperty :hasSubcontractor ],
        :OfferingParty ;
    skos:definition "The Role of an Agent that has signed a Contract with a Buyer."@en ;
    skos:historyNote "WG approval 08/11/2022"@en ;
    skos:prefLabel "Contractor"@en .

:EnergyEfficiencyInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasItemConsumptionSavings ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasItemConsumption ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :concernsTotalItems ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :GreenProcurement ;
            owl:onProperty :concernsGreenProcurement ],
        :ContextDescription ;
    skos:prefLabel "Energy Efficiency Information"@en .

:QualificationCriterion a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasQualificationCriteriaStatedInESPDRequest ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasQualificationCriteriaStatedInNotice ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasQualificationCriteriaStatedInProcurementDocuments ],
        :ProcurementCriterion ;
    skos:definition "Criterion used in the first stage of procurement."@en ;
    skos:historyNote "WG approval 30/05/2023"@en ;
    skos:prefLabel "Qualification Criterion"@en .

:SubcontractingEstimate a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasEstimatedPercentage ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isSubcontractingPercentageKnown ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isSubcontractingValueKnown ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasSubcontractingEstimatedValue ],
        :Estimate,
        :MaskableObject ;
    skos:definition "Approximation concerning the foreseen Subcontracting."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Subcontracting Estimate"@en .

:TenderAwardOutcome a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Tender ;
            owl:onProperty :concernsTender ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasAwardRank ],
        [ a owl:Restriction ;
