            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty locn:postCode ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty locn:locatorDesignator ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty locn:addressArea ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty locn:postName ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty locn:locatorName ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty locn:fullAddress ] ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address</u></foreign></xref>"@en ;
    skos:historyNote "WG Approval 28/04/2020"@en ;
    skos:prefLabel "Address"@en .

:AcquiringParty a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AgentInRole ;
    skos:definition "The Role of an Agent that acts on the buying side of a Procurement Process."@en ;
