    rdfs:range xsd:anyURI ;
    skos:definition "The main web page used by the instance of the concept. (org:Organization) The main web page used by the instance of the concept. (cpov:ContactPoint)"@en ;
    skos:historyNote "WG Approval 01/06/2023"@en ;
    skos:prefLabel "has Internet Address"@en .

:hasInvoiceLineObjectIdentifier a owl:ObjectProperty ;
    rdfs:domain :InvoiceLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "An identifier for an object on which the invoice line is based, given by the Seller. Additional Information: It may be a subscription number, telephone number, meter point etc., as applicable."@en ;
    skos:historyNote "WG Approval 26/06/2024"@en ;
    skos:prefLabel "has Invoice Line Object Identifier"@en .

:hasInvoiceLinePeriod a owl:ObjectProperty ;
    rdfs:domain :InvoiceLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Interval ;
    skos:prefLabel "has Invoice Line Period"@en .

:hasInvoicedObjectIdentifier a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "An identifier for an object on which the invoice is based, given by the Seller."@en ;
    skos:prefLabel "has Invoiced Object Identifier"@en .

:hasInvoicingPeriod a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Interval ;
    skos:prefLabel "has Invoicing Period"@en .

:hasItemConsumption a owl:ObjectProperty ;
    rdfs:domain :EnergyEfficiencyInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Item Consumption"@en .

:hasItemConsumptionSavings a owl:ObjectProperty ;
    rdfs:domain :EnergyEfficiencyInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Item Consumption Savings"@en .

:hasLegalFormRequirement a owl:DatatypeProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The legal form to be taken by a Contractor. Additional Information: Generally, this is defined to cover the case where an Organisation Group is involved. Note that the codelist provided at national level should be used. (epo:ContractTerm)"@en ;
    skos:prefLabel "has Legal Form Requirement"@en .

:hasLegalFormType a owl:DatatypeProperty ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The classification of an Organisation according to legislation. Additional Information: Generally, this is defined for Tenderers who want to submit as an Organisation Group. Note that the codelist provided at national level should be used. (org:Organization)"@en ;
    skos:prefLabel "has Legal Form Type"@en .

:hasLength a owl:ObjectProperty ;
    rdfs:domain :AbstractContainer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The horizontal measurement. Additional Information: The length is the longer side between the length and the width."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Length"@en .

:hasLoadingMeter a owl:ObjectProperty ;
    rdfs:domain :Consignment ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The area of the Consignment in meters divided by the width of the truck, which is considered to be 2.4 meters."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Loading Meter"@en .

:hasLotAwardCombination a owl:DatatypeProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The contracting authority reserves the right to award contracts combining lots or groups of lots. Additional Information: This property contains information about the Lots concerned. This property is required by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 23/08/2022"@en ;
    skos:prefLabel "has Lot Award Combination"@en .

:hasLowestReceivedTenderValue a owl:ObjectProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "Amount of the Tender with the lowest value. Additional Information The value must correspond to an admissible tender. For example, tenders compliant with the procurement document requirements, not having an abnormally low price or cost, etc."@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has Lowest Received Tender Value"@en .

:hasMainActivityDescription a owl:DatatypeProperty ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Self-explanatory text about the Main Activity . Additional information: This field is used when the Main Activity is not available in the controlled list at-voc:main-activity-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future. (org:Organization)"@en ;
    skos:historyNote "WG Approval 06/09/2022"@en ;
    skos:prefLabel "has Main Activity Description"@en .

:hasMandateIdentifier a owl:ObjectProperty ;
    rdfs:domain :PaymentInstructionsInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "An unique identifier for referencing the direct debit mandate, assigned by the Payee."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Mandate Identifier"@en .

:hasManufacturerID a owl:ObjectProperty ;
    rdfs:domain :Manufacturer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "The manufacturer's identifier for the item."@en ;
    skos:prefLabel "has Manufacturer ID"@en .

:hasManufacturerItemID a owl:ObjectProperty ;
    rdfs:domain :AbstractItem ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "The general identifier assigned to the concept as defined by the Manufacturer. ​"@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Manufacturer Item ID"@en .

:hasMaskableProperty a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :NonPublishedInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:anyURI ;
    skos:prefLabel "has Maskable Property"@en .

:hasMaximumFrameworkAgreementAwardedValue a owl:ObjectProperty ;
    rdfs:domain :NoticeAwardInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The maximum value which can be spent through all the framework agreements announced in this notice, including options and renewals of contracts. Additional information: The value provided is a threshold value that implicity means that it cannot be exceeded however it may not be reached during the execution of a contract. The Framework Agreements in a CAN are to be traced back and added to provide this value."@en ;
    skos:editorialNote "Used by eForms BT-118"@en ;
    skos:historyNote "WG Approval 03/12/2019"@en ;
    skos:prefLabel "has Maximum Framework Agreement Awarded Value"@en .

:hasMaximumLotSubmissionAllowed a owl:DatatypeProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The total number of lots for which one Tenderer can submit Tenders. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 12/12/2018"@en ;
    skos:prefLabel "has Maximum Lot Submission Allowed"@en .

:hasMaximumMeasure a owl:ObjectProperty ;
    rdfs:domain :DimensionInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Maximum Measure"@en .

:hasMaximumNumberOfCandidates a owl:DatatypeProperty ;
    rdfs:domain :MultipleStageProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "Maximum number of candidates to be invited for the second stage of the procedure. (epo:MultipleStageProcedureTerm)"@en ;
    skos:historyNote "WG Approval 22/08/2019"@en ;
    skos:prefLabel "has Maximum Number Of Candidates"@en .

:hasMaximumNumberOfLotsToBeAwarded a owl:DatatypeProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum number of lots for which contract(s) can be awarded to one tenderer. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 22/08/2019"@en ;
    skos:prefLabel "has Maximum Number Of Lots To Be Awarded"@en .

:hasMaximumNumberOfRenewals a owl:DatatypeProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum number of times the contract can be renewed. Additional Information By renewing, the buyer reserves the right (i.e. not an obligation) to renew the contract (i.e. extend its duration) without a new procurement procedure. For example, a contract may be valid for one year and the buyer may keep a possibility to renew it (e.g. once, twice) for another three months, if he is content with the services he received. PLEASE REVIEW THIS DEFINITION AGAIN WITH THE WORKING GROUP. It was originally taken from eForms. (epo:ContractTerm)"@en ;
    skos:prefLabel "has Maximum Number Of Renewals"@en .

:hasMaximumOrderQuantity a owl:ObjectProperty ;
    rdfs:domain :CatalogueLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The maximum number of orderable units that can be ordered according to details provided in the catalogue line, such as price."@en ;
    skos:prefLabel "has Maximum Order Quantity"@en .

:hasMaximumParticipantsNumber a owl:DatatypeProperty ;
    rdfs:domain :FrameworkAgreementTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum number of participants in the framework agreement. Additional Information: Maximum number of tenderers who may be awarded a contract within the framework agreement. The number is a positive integer. (epo:FrameworkAgreementTerm)"@en ;
    skos:editorialNote "Used by eForms BT-113"@en ;
    skos:historyNote "WG Approval 05/02/2019"@en ;
    skos:prefLabel "has Maximum Participants Number"@en .

:hasMaximumShare a owl:DatatypeProperty ;
    rdfs:domain :SubcontractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "The maximum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)"@en ;
    skos:historyNote "WG Approval 17/09/2019 "@en ;
    skos:prefLabel "has Maximum Share"@en .

:hasMaximumTemperature a owl:ObjectProperty ;
    rdfs:domain :TemperatureSpecification ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The highest tolerated temperature."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Maximum Temperature"@en .

:hasMaximumValue a owl:ObjectProperty ;
    rdfs:domain :ItemProperty ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Maximum Value"@en .

:hasMediumTenderPerLots a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "Tenders from medium-sized enterprise. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)"@en ;
    skos:prefLabel "has Medium Tender Per Lots"@en .

:hasMember a owl:ObjectProperty ;
    rdfs:domain :OrganisationGroup ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range org:Organization ;
    skos:prefLabel "has Member"@en .

:hasMinimumMeasure a owl:ObjectProperty ;
    rdfs:domain :DimensionInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Minimum Measure"@en .

:hasMinimumNumberOfCandidates a owl:DatatypeProperty ;
    rdfs:domain :MultipleStageProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "Minimum number of candidates to be invited for the second stage of the procedure. (epo:MultipleStageProcedureTerm)"@en ;
    skos:historyNote "WG Approval 22/08/2019"@en ;
    skos:prefLabel "has Minimum Number Of Candidates"@en .

:hasMinimumQuantityGuaranteedForDelivery a owl:ObjectProperty ;
    rdfs:domain :CatalogueLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The minimum quantity of an item that is guaranteed by the seller to be delivered."@en ;
    skos:prefLabel "has Minimum Quantity Guaranteed For Delivery"@en .

:hasMinimumShare a owl:DatatypeProperty ;
    rdfs:domain :SubcontractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "The minimum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)"@en ;
    skos:historyNote "WG Approval 17/09/2019"@en ;
    skos:prefLabel "has Minimum Share"@en .

:hasMinimumSubcontractorsProposedObligation a owl:DatatypeProperty ;
    rdfs:domain :SubcontractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "The minimum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Minimum Subcontractors Proposed Obligation"@en .

:hasMinimumTemperature a owl:ObjectProperty ;
    rdfs:domain :TemperatureSpecification ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The lowest tolerated temperature."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Minimum Temperature"@en .

:hasMinimumValue a owl:ObjectProperty ;
    rdfs:domain :ItemProperty ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Minimum Value"@en .

:hasNetAmount a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :InvoiceLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Net Amount"@en .

:hasNetMonetaryValue a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :Price ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Net Monetary Value"@en .

:hasNetQuantity a owl:ObjectProperty ;
    rdfs:domain :AbstractItem ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The net quantity of the item that is contained in each consumable unit, excluding any packaging materials."@en ;
    skos:prefLabel "has Net Quantity"@en .

:hasNetVolume a owl:ObjectProperty ;
    rdfs:domain :AbstractContainer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The amount of space that is required without the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Net Volume"@en .

:hasNoNegotiationNecessary a owl:DatatypeProperty ;
    rdfs:domain :MultipleStageProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "The buyer reserves the right to award the contract on the basis of the initial tenders without any further negotiations. Additional information: See Article 29(4) of Directive 2014/24/EU. (epo:MultipleStageProcedureTerm)"@en ;
    skos:prefLabel "has No Negotiation Necessary"@en .

:hasNonAwardedContractNumber a owl:DatatypeProperty ;
    rdfs:domain :LotAwardOutcome ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The number the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)"@en ;
    skos:historyNote "WG Approval 06/09/2022"@en ;
    skos:prefLabel "has Non Awarded Contract Number"@en .

:hasNonAwardedContractTitle a owl:DatatypeProperty ;
    rdfs:domain :LotAwardOutcome ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The title the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)"@en ;
    skos:historyNote "WG Approval 06/09/2022"@en ;
    skos:prefLabel "has Non Awarded Contract Title"@en .

:hasNonEEAReceivedTenders a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The amount of tenders received from economic operators in non-EEA countries. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has Non EEA Received Tenders"@en .

:hasNonEUReceivedTenders a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The amount of tenders received from economic operators in non-EU countries. (epo:SubmissionStatisticalInformation)"@en ;
    skos:prefLabel "has Non EU Received Tenders"@en .

:hasNoticePublicationNumber a owl:DatatypeProperty ;
    rdfs:domain :Notice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The identifier of the published Notice. Additional information: The format of this identifier is XXXXXXXX-YYYY. (epo:Notice)"@en ;
    skos:historyNote "WG approval 26/03/2024"@en ;
    skos:prefLabel "has Notice Publication Number"@en .

:hasNumberOfReviewRequests a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :ReviewRequestSummary ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The number of requests the buyer received to review any of its decisions. (epo:ReviewRequestSummary)"@en ;
    skos:prefLabel "has Number Of Review Requests"@en .

:hasNumberOfTenderersInvited a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "Number of economic operators invited to tender. Additional Information This may be used for single-stage procedures or to indicate the number of candidates invited to tender in multi-stage procedures. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 01/12/2020"@en ;
    skos:prefLabel "has Number Of Tenderers Invited"@en .

:hasNumberOfTendersConcerned a owl:DatatypeProperty ;
    rdfs:domain :InternationalProcurementInstrumentMeasuresInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has Number Of Tenders Concerned"@en .

:hasOJSIssueNumber a owl:DatatypeProperty ;
    rdfs:domain :Notice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The issue identifier of the Supplement to the EU Official Journal. Additional information: The format of this identifier is XX-YYYY. (epo:Notice)"@en ;
    skos:historyNote "WG approval 26/03/2024"@en ;
    skos:prefLabel "has OJS Issue Number"@en .

:hasOpeningDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :OpeningTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time for the opening of tenders. (epo:OpeningTerm)"@en ;
    skos:historyNote "WG Approval 12/03/2019"@en ;
    skos:prefLabel "has Opening Date Time"@en .

:hasOpeningPlace a owl:DatatypeProperty ;
    rdfs:domain :OpeningTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The place (e.g. physical address, URL) where the tenders will be publicly opened. (epo:OpeningTerm)"@en ;
    skos:historyNote "WG Approval 06/03/2025"@en ;
    skos:prefLabel "has Opening Place"@en .

:hasOpeningURL a owl:DatatypeProperty ;
    rdfs:domain :OpeningTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:anyURI ;
    skos:definition "The identifier of the address of the Opening of Tenders. (epo:OpeningTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Opening URL"@en .

:hasOptions a owl:DatatypeProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "The buyer reserves the right (not an obligation) for additional purchases from the contractor (while the contract is valid). (epo:ContractTerm)"@en ;
    skos:prefLabel "has Options"@en .

:hasOrderabableUnitFactorRate a owl:ObjectProperty ;
    rdfs:domain :Price ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:prefLabel "has Orderabable Unit Factor Rate"@en .

:hasOtherCountriesReceivedTenders a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The amount of Tenders received from European Economic Area countries other than that of the Buyer. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Other Countries Received Tenders"@en .

:hasOutstandingQuantity a owl:ObjectProperty ;
    rdfs:domain :DespatchLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The Quantity of non-despatched Goods Items."@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Outstanding Quantity"@en .

:hasOverallCostAwardCriteriaPonderation a owl:DatatypeProperty ;
    rdfs:domain :AwardEvaluationTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "The weighting given to cost. Additional Information: This weighting covers usually all cost criteria against price or quality criteria. (epo:AwardEvaluationTerm)"@en ;
    skos:prefLabel "has Overall Cost Award Criteria Ponderation"@en .

:hasOverallPriceAwardCriteriaPonderation a owl:DatatypeProperty ;
    rdfs:domain :AwardEvaluationTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "The weighting given to price. Additional Information: This weighting covers usually all price criteria against cost or quality criteria. (epo:AwardEvaluationTerm)"@en ;
