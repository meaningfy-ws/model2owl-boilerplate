        :MaskableObject ;
    skos:definition "A number of monetary units specified using a given unit of currency. Additional information: In the pre-award phase of the procurement, all monetary values are considered to exclude VAT based on the Directive 2014/24/EU."@en ;
    skos:historyNote "WG approval 13/04/2021"@en ;
    skos:prefLabel "Monetary Value"@en .

rdf:PlainLiteral a rdfs:Datatype ;
    skos:prefLabel "Plain Literal"@en .

<http://data.europa.eu/a4g/ontology> a owl:Ontology ;
    rdfs:label """This artefact consolidates both the definitions (OWL core) and the restrictions and inference-related specifications (OWL restrictions) of the eProcurement Ontology Core into a single self-contained ontology.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-09-04"^^xsd:date ;
    dcterms:description """This artefact consolidates both the definitions (OWL core) and the restrictions and inference-related specifications (OWL restrictions) of the eProcurement Ontology Core into a single self-contained ontology.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2026-06-29"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "ePO Core full"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from demo_ontology.xml on 2026-06-29" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/latest/index.html>,
        <https://github.com/eprocurementontology/eprocurementontology>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports eli:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "2.1.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology-3.0.1" ;
    owl:versionIRI <http://data.europa.eu/a4g/ontology-3.1.0> ;
    owl:versionInfo "3.1.0" .

