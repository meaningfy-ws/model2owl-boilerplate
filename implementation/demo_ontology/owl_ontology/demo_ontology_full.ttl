    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "agreed By Buyer"@en .

:amendsContract a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :ContractAmendment ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Contract ;
    skos:prefLabel "amends Contract"@en .

:announcesCompletionOfContract a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :CompletionNotice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Contract ;
    skos:prefLabel "announces Completion Of Contract"@en .

