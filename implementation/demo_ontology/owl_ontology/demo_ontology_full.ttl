    skos:definition "The maximum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Subcontractors Proposed Above Obligation"@en .

:hasSuccessiveReduction a owl:DatatypeProperty ;
    rdfs:domain :MultipleStageProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "The number of solutions or tenders will be reduced in iterative evaluations for multiple staged procedures. Additional information: This refers to multiple-stage procedures (included two-stage procedures, at least). Open Procedures can be seen as one-stage procedures. (epo:MultipleStageProcedureTerm)"@en ;
    skos:historyNote "WG Approval 22/08/2019"@en ;
    skos:prefLabel "has Successive Reduction"@en .

:hasTaxInformation a owl:ObjectProperty ;
    rdfs:domain :Contract ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :TaxInformation ;
    skos:prefLabel "has Tax Information"@en .

:hasTenderValidityDuration a owl:ObjectProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Duration ;
    skos:prefLabel "has Tender Validity Duration"@en .

:hasTenderValidityPeriod a owl:ObjectProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Interval ;
    skos:definition "The relation indicating until when a tender instance is applicable."@en ;
    skos:prefLabel "has Tender Validity Period"@en .

:hasThresholdValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain cccev:Constraint ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "The cut-off level for a given concept. Additional Information: This value is given as e.g. a minimum score, a maximum number of tenders with the highest score passing (see codelist at-voc:number-threshold). (cccev:Constraint)"@en ;
    skos:prefLabel "has Threshold Value"@en .

:hasTotalAllowanceAmount a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Allowance Amount"@en .

:hasTotalAwardedValue a owl:ObjectProperty ;
    rdfs:domain :NoticeAwardInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The awarded value of all lots announced in this notice, including options and renewals. Additional information: The values of the individual Lots awarded under a framework agreement and mentioned in this notice are included. The values of the individual lots announced in a CAN are to be traced back and added to provide this value."@en ;
    skos:editorialNote "Used by eForms BT-161"@en ;
    skos:historyNote "WG Approval 03/12/2019"@en ;
    skos:prefLabel "has Total Awarded Value"@en .

:hasTotalChargeAmount a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Charge Amount"@en .

:hasTotalCreditAmount a owl:ObjectProperty ;
    rdfs:domain :RemittanceAdvice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Credit Amount"@en .

:hasTotalDebitAmount a owl:ObjectProperty ;
    rdfs:domain :RemittanceAdvice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Debit Amount"@en .

:hasTotalNumberOfComplainants a owl:DatatypeProperty ;
    rdfs:domain :ReviewRequestSummary ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The number of economic operators that requested the buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC. (epo:ReviewRequestSummary)"@en ;
    skos:editorialNote "Used by eForms BT-712"@en ;
    skos:historyNote "WG Approval 11/04/2019"@en ;
    skos:prefLabel "has Total Number Of Complainants"@en .

:hasTotalPaymentAmount a owl:ObjectProperty ;
    rdfs:domain :RemittanceAdvice ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Total Payment Amount"@en .

:hasTotalQuantity a owl:ObjectProperty ;
    rdfs:domain :Purpose ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The number of units required. Additional Information: The quantity needs to go along with the unit."@en ;
    skos:prefLabel "has Total Quantity"@en .

:hasTotalVehicles a owl:DatatypeProperty ;
    rdfs:domain :CleanVehicleDirectiveInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The number of all vehicles (regardless of whether clean or not) that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)"@en ;
    skos:historyNote "WG Approval 28/07/2020"@en ;
    skos:prefLabel "has Total Vehicles"@en .

:hasTraceID a owl:ObjectProperty ;
    rdfs:domain :GoodsItem ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "The identifier used for tracking the Goods Item. Additional information: An example is the EPC number used in RFID."@en ;
    skos:historyNote "WG Approval 21/09/2023"@en ;
    skos:prefLabel "has Trace ID"@en .

:hasTrackingID a owl:ObjectProperty ;
    rdfs:domain :DeliveryInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:prefLabel "has Tracking ID"@en .

:hasTransportHandlingUnitQuantity a owl:ObjectProperty ;
    rdfs:domain :Consignment ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "Relation indicating the number of the Transport Handling Unit."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Transport Handling Unit Quantity"@en .

:hasUnverifiedTenders a owl:DatatypeProperty ;
    rdfs:domain :SubmissionStatisticalInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "Offers received for which it has not been verified if they are admissible or inadmissible (e.g. because award criteria have been evaluated for all tenders and admissibility is checked only for the winning tender). (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 28/07/2020"@en ;
    skos:prefLabel "has Unverified Tenders"@en .

:hasVehicleID a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :TransportMeans ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "The identifier of the Transport Means."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Vehicle ID"@en .

:hasVehicleSegmentID a owl:ObjectProperty ;
    rdfs:domain :TransportMeans ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "The identifier of a part of the Transport Means."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Vehicle Segment ID"@en .

:hasVersion a owl:DatatypeProperty ;
    rdfs:domain :Document ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "A number that identifies a specific state of a document. (epo:Document)"@en ;
    skos:historyNote "WG approval 18/11/2021"@en ;
    skos:prefLabel "has Version"@en .

:hasWidth a owl:ObjectProperty ;
    rdfs:domain :AbstractContainer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The measurement of the depth. Additional Information: The width is the shorter side between the length and the width."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Width"@en .

:hasWithdrawalDate a owl:DatatypeProperty ;
    rdfs:domain :ReviewDecision ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:date ;
    skos:definition "The date and time when the request for review was withdrawn. (epo:ReviewDecision)"@en ;
    skos:editorialNote "Used by eForms BT-797"@en ;
    skos:prefLabel "has Withdrawal Date"@en .

:hasWithdrawalReason a owl:DatatypeProperty ;
    rdfs:domain :ReviewDecision ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The explanation for withdrawing the request for review. (epo:ReviewDecision)"@en ;
    skos:editorialNote "Used by eForms BT-798"@en ;
    skos:prefLabel "has Withdrawal Reason"@en .

:hasZeroEmissionVehicles a owl:DatatypeProperty ;
    rdfs:domain :CleanVehicleDirectiveInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The number of all zero-emission heavy-duty vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)"@en ;
    skos:historyNote "WG Approval 28/07/2020"@en ;
    skos:prefLabel "has Zero Emission Vehicles"@en .

:indicatesAwardToWinner a owl:ObjectProperty ;
    rdfs:domain :TenderAwardOutcome ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Winner ;
    skos:definition "Reveals the winner to whom the tender award outcome is attributed."@en ;
    skos:prefLabel "indicates Award To Winner"@en .

:indicatesPerformingStaffInformationRequirement a owl:DatatypeProperty ;
    rdfs:domain :ProcurementCriteriaSummary ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Obligation to indicate the names and professional qualifications of the staff assigned to performing the contract. (epo:ProcurementCriteriaSummary)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "indicates Performing Staff Information Requirement"@en .

:involvesProcurementDocument a owl:ObjectProperty ;
    rdfs:domain :AccessTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ProcurementDocument ;
    skos:prefLabel "involves Procurement Document"@en .

:isAccelerated a owl:DatatypeProperty ;
    rdfs:domain :Procedure ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Statement about the fact that the procedure will be reduced due to a state of urgency. Additional Information This modifies the time limit for the receipt of requests to participate or the receipt of tenders. (epo:Procedure)"@en ;
    skos:historyNote "WG Approval 20/08/2019"@en ;
    skos:prefLabel "is Accelerated"@en .

:isAdvancedElectronicSignatureRequired a owl:DatatypeProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Advanced or qualified electronic signature or seal (as defined in Regulation (EU) No 910/2014) is required. The submitted information is required to be signed electronically. Additional Information: Signature can be defined as \"data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. For more details on the meaning and uses of electronic signature you may consult different authoritative sources, a relevant one being for instance the Regulation (EU) 910/2014 on electronic identification and trust services for electronic transactions in the internal market. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 21/07/2020"@en ;
    skos:prefLabel "is Advanced Electronic Signature Required"@en .

:isAppointedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :EvaluationBoard ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :UniqueResponsibleOfTheProcurement ;
    skos:prefLabel "is Appointed By"@en .

:isAwardedByCPB a owl:DatatypeProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Procedure is awarded by a Central Purchasing Body. (epo:ProcedureTerm)"@en ;
    skos:prefLabel "is Awarded By CPB"@en .

:isBeneficialOwnerOf a owl:ObjectProperty ;
    rdfs:domain person:Person ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Business ;
    skos:definition "A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it's beyond the scope for public eProcurement domain."@en ;
    skos:historyNote "WG Approval 14/09/2021"@en ;
    skos:prefLabel "is Beneficial Owner Of"@en .

:isCompetitionTerminated a owl:DatatypeProperty ;
    rdfs:domain :ProcurementProcessInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "No further contracts will be awarded in this procedure. Additional Information: This can be instantiated in the post award phase. PIN for Competition needs to be signaled. This field can be used even if no contracts are awarded in the contract award notice. (epo:ProcurementProcessInformation)"@en ;
    skos:editorialNote "Used by eForms BT-756"@en ;
    skos:prefLabel "is Competition Terminated"@en .

:isContractingEntity a owl:DatatypeProperty ;
    rdfs:domain :Buyer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Role of entities, which: (a) are contracting authorities or public undertakings and which pursue one of the activities referred to in Articles 8 to 14 of the Directive 2014/25/EU. (b) when they are not contracting authorities or public undertakings, have as one of their activities any of the activities referred to in Articles 8 to 14, or any combination thereof and operate on the basis of special or exclusive rights granted by a competent authority of a Member State. Additional Information: The indicator is needed in order to discriminate between those contracts where the Contracting Entity acts as a Contracting Authority undergoing the limits and the rules of Directive 24 and those where it acts as a Contracting Entity, with certain relaxed constraints. For example, the Contracting Entities have different thresholds for the application of Directive 24 if compared with Contracting Authorities. (epo:Buyer)"@en ;
    skos:historyNote "WG Approval 28/04/2020"@en ;
    skos:prefLabel "is Contracting Entity"@en .

:isCoveredByGPA a owl:DatatypeProperty ;
    rdfs:domain :ProcurementElement ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies whether the Agreement on Government Procurement (GPA) applies. Additional information: The GPA aims to establish a multilateral framework of balanced rights and obligations relating to public contracts with a view to achieving the liberalization and expansion of world trade. (epo:ProcurementElement)"@en ;
    skos:editorialNote "Used by eForms BT-115"@en ;
    skos:historyNote "WG Approval 15/10/2019"@en ;
    skos:prefLabel "is Covered By GPA"@en .

:isDPSTerminated a owl:DatatypeProperty ;
    rdfs:domain :ProcurementProcessInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "End of the Dynamic Purchase System (DPS). Additional Information: This property can be used in the contract award notice even if no contracts are awarded. (epo:ProcurementProcessInformation)"@en ;
    skos:historyNote "WG Approval 22/11/2019"@en ;
    skos:prefLabel "is DPS Terminated"@en .

:isDesignContest a owl:DatatypeProperty ;
    rdfs:domain :Procedure ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "A competition which enables the buyer to acquire a plan or design via a jury. Additional information: Design contests have traditionally mostly been used in the fields of town and country planning, architecture and engineering or data processing, other purposes, such as to obtain plans for financial engineering The contest may include or not the award of prizes; (epo:Procedure)"@en ;
    skos:historyNote "WG Approval 04/02/2021"@en ;
    skos:prefLabel "is Design Contest"@en .

:isExecutedByProcurementServiceProvider a owl:ObjectProperty ;
    rdfs:domain :Procedure ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :ProcurementServiceProvider ;
    skos:prefLabel "is Executed By Procurement Service Provider"@en .

:isGuaranteeRequired a owl:DatatypeProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "The submitted information must include a financial commitment to be used in case of default. Additional Information: See the additional information provided in the definition of the 'Guarantee Description' element. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 21/07/2020"@en ;
    skos:prefLabel "is Guarantee Required"@en .

:isJointProcurement a owl:DatatypeProperty ;
    rdfs:domain :Procedure ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Multiple buyers procure together within the same procedure. Addition Information: In case the joint procurement involves buyers from different countries, the national law is specified by the epo:hasCrossBorderLaw in the ProcedureTerm . (epo:Procedure)"@en ;
    skos:prefLabel "is Joint Procurement"@en .

:isJuryDecisionBinding a owl:DatatypeProperty ;
    rdfs:domain :DesignContestRegimeTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether the procuring entity is bound to apply the decision of the jury. (epo:DesignContestRegimeTerm)"@en ;
    skos:prefLabel "is Jury Decision Binding"@en .

:isListedCompany a owl:DatatypeProperty ;
    rdfs:domain :Business ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Public companies listed on a stock exchange and subject to disclosure requirements (either by stock exchange rules or through law or enforceable means), which impose requirements to ensure adequate transparency of beneficial ownership. <u>Additional Information:</u> In eForms this indicator is used when the nationality of beneficial owner is not provided because the Economic Operator is registered in a regulated market that is subject to disclosure requirements consistent with Union law or subject to equivalent international standards which ensure adequate transparency of ownership information. (epo:Business)"@en ;
    skos:historyNote "WG Approval 21/11/2019"@en ;
    skos:prefLabel "is Listed Company"@en .

:isMultipleTenderSubmissionAllowed a owl:DatatypeProperty ;
    rdfs:domain :SubmissionTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Tenderers may submit more than one competing tenders. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 10/10/2019"@en ;
    skos:prefLabel "is Multiple Tender Submission Allowed"@en .

:isNonDisclosureAgreementRequired a owl:DatatypeProperty ;
    rdfs:domain :NonDisclosureAgreementTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "A non-disclosure agreement is needed. Additional information: A non-disclosure agreement is a Contract between different parties which ensures information is not shared with other parties. (epo:NonDisclosureAgreementTerm)"@en ;
    skos:historyNote "WG Approval 26/03/2024"@en ;
    skos:prefLabel "is Non Disclosure Agreement Required"@en .

:isOneLotOnlyAllowed a owl:DatatypeProperty ;
    rdfs:domain :ProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether tenders may be submitted for only one Lot. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 23/08/2022"@en ;
    skos:prefLabel "is One Lot Only Allowed"@en .

:isOwnedByAgent a owl:ObjectProperty ;
    rdfs:domain :System ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range foaf:Agent ;
    owl:inverseOf :ownsSystem ;
    skos:prefLabel "is Owned By Agent"@en .

:isProcurementDocumentChanged a owl:DatatypeProperty ;
    rdfs:domain :ChangeInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "One or more procurement documents have been changed. (epo:ChangeInformation)"@en ;
    skos:editorialNote "Used by eForms BT-718"@en ;
    skos:historyNote "WG Approval 05/11/2019"@en ;
    skos:prefLabel "is Procurement Document Changed"@en .

:isProcurementDocumentRestricted a owl:DatatypeProperty ;
    rdfs:domain :AccessTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "The access to certain procurement documents is restricted. (epo:AccessTerm)"@en ;
    skos:editorialNote "Used by eForms BT-14"@en ;
    skos:historyNote "WG Approval 10/10/2019"@en ;
    skos:prefLabel "is Procurement Document Restricted"@en .

:isRecurrent a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://example.com/link1\">Link 1</a>, <a href=\"https://example.com/link2\">Link 2</a>"@en ;
    rdfs:domain :ProcurementObject ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "The Procurement being notified is likely to be included in another procedure in the foreseeable future. Additional Information: For example, a regularly re-tendered municipal service. This does not include awarding multiple contracts within a single qualification system, framework agreement, or a dynamic purchasing system. (epo:ProcurementObject)"@en ;
    skos:editorialNote "Used by eForms BT-94"@en ;
    skos:historyNote "WG Approval 12/05/2020"@en ;
    skos:prefLabel "is Recurrent"@en .

:isRenewalIndicator a owl:DatatypeProperty ;
    rdfs:domain :ContractTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether the contract is subject to a renewal clause. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "is Renewal Indicator"@en .

:isSecurityClearanceRequired a owl:DatatypeProperty ;
    rdfs:domain :SecurityClearanceTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Security Clearance is needed. (epo:SecurityClearanceTerm)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "is Security Clearance Required"@en .

:isSubcontractingPercentageKnown a owl:DatatypeProperty ;
    rdfs:domain :SubcontractingEstimate ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:prefLabel "is Subcontracting Percentage Known"@en .

:isSubcontractingValueKnown a owl:DatatypeProperty ;
    rdfs:domain :SubcontractingEstimate ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:boolean ;
    skos:prefLabel "is Subcontracting Value Known"@en .

:isSubjectToGrouping a owl:ObjectProperty ;
    rdfs:domain :Tender ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
