    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Duration ;
    skos:definition "Relation indicating a Dynamic Purchase System has an estimated Duration."@en ;
    skos:historyNote "WG Approval 28/11/2024"@en ;
    skos:prefLabel "has Estimated Duration"@en .

:hasEstimatedInvitationToExpressInterestDate a owl:DatatypeProperty ;
    rdfs:domain :MultipleStageProcedureTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:date ;
    skos:definition "The estimated date of dispatch of the invitations to confirm interest. (epo:MultipleStageProcedureTerm)"@en ;
    skos:editorialNote "Used by eForms BT-631"@en ;
    skos:prefLabel "has Estimated Invitation To Express Interest Date"@en .

:hasEstimatedInvitationToTenderDate a owl:DatatypeProperty ;
