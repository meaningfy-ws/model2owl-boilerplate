    skos:definition "The estimated date of dispatch of the invitations to submit tenders in two (or more) stage procedures. (epo:MultipleStageProcedureTerm)"@en ;
    skos:editorialNote "Used by eForms BT-130"@en ;
    skos:historyNote "WG Approval 01/10/2019"@en ;
    skos:prefLabel "has Estimated Invitation To Tender Date"@en .

:hasEstimatedPercentage a owl:DatatypeProperty ;
    rdfs:domain :SubcontractingEstimate ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "The estimated proportion foreseen to be subcontracted. (epo:SubcontractingEstimate)"@en ;
    skos:historyNote "WG Approval 07/01/2020"@en ;
    skos:prefLabel "has Estimated Percentage"@en .

:hasEstimatedTenderInvitationDate a owl:DatatypeProperty ;
    rdfs:domain :ProcessPlanningTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:date ;
    skos:definition "The planned date for the dispatch of the invitations to submit tenders. (epo:ProcessPlanningTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Estimated Tender Invitation Date"@en .

:hasEstimatedTotalSubcontracts a owl:DatatypeProperty ;
