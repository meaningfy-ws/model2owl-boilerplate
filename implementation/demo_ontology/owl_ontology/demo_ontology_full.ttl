            owl:onClass :Winner ;
            owl:onProperty :indicatesAwardToWinner ],
        :ContextualProjection,
        :MaskableObject ;
    skos:definition "Result concerning the Tender attributed by the Awarder."@en ;
    skos:prefLabel "Tender Award Outcome"@en .

:Tenderer a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ExclusionGround ;
            owl:onProperty :substantiatesExclusionGround ],
        :OfferingParty ;
    skos:definition "A Role of an Agent that has submitted a Tender. Additional Information: A Tenderer is an Economic Operator or group of Economic Operators that has submitted a Tender."@en ;
    skos:historyNote "WG approval 05/08/2021"@en ;
    skos:prefLabel "Tenderer"@en .

cccev:InformationRequirement a owl:Class ;
    rdfs:label "Information Requirement"@en ;
    rdfs:comment "Requested data that is to be proven by Evidence."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf cccev:Requirement ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/InformationRequirement\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/InformationRequirement</u></foreign></xref>"@en ;
    skos:prefLabel "Information Requirement"@en ;
    skos:scopeNote "Information Requirements are the most neutral kind of Requirements. They aim to request information in any form, e.g. a person's date of birth or a company's turnover. They represent requests for data that prove one or more facts of the real world in a formal manner, or that leads to the source of such a proof. They can be understood as 'requests for Evidences'. The response to an Information Requirement is an Evidence when the issuer of the response is an authoritative source (e.g. a Civil Registry providing data about a natural person for the provision of public service through the Single Digital Gateway). In other cases, the responses might not be issued by an authoritative source, but the issuer supports the responses with Evidences (or commits to support them timely, e.g. a self-declaration or a declaration of oath). The Information Requirement can require structured data or documents of any form. For structured data, the Requirement can use 'Concepts' to specify the structure and type of the data expected in the response. For both structured and unstructured data, the Information Requirement can indicate the expected Type of Evidence, its format, source, and other properties related to the Evidence."@en .

cccev:PublicEvent a owl:Class ;
    rdfs:label "Public Event"@en ;
    rdfs:comment """Something that happens at a particular place and time,
organised by one or more agents for a particular purpose, and is of interest to a general
 audience. This definition excludes natural events such as earthquakes and volcanic 
eruptions."""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> .

time:TemporalEntity a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:TemporalDuration ;
            owl:onProperty time:hasDuration ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:TemporalDuration ;
            owl:onProperty time:hasTemporalDuration ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ] ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.w3.org/TR/owl-time/#time:TemporalEntity\"><foreign otherprops=\"#0000ff\"><u>https://www.w3.org/TR/owl-time/#time:TemporalEntity</u></foreign></xref>"@en ;
    skos:prefLabel "Temporal Entity"@en .

locn:Geometry a owl:Class ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Geometry\"><foreign otherprops=\"#0000ff\"><u>https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Geometry</u></foreign></xref>"@en ;
    skos:prefLabel "Geometry"@en .

:ContractModificationNotice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :NoticeAwardInformation ;
            owl:onProperty :refersToNoticeAwardInformation ],
        [ a owl:Restriction ;
            owl:onClass :Contract ;
            owl:onProperty :refersToContractToBeModified ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :concernsLot ;
            owl:someValuesFrom :Lot ] .

:LotAwardOutcome a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasNonAwardedContractNumber ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasNonAwardedContractTitle ],
        [ a owl:Restriction ;
            owl:onClass :Lot ;
            owl:onProperty :concernsLot ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasFrameworkAgreementMaximumValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasApproximateFrameworkAgreementValue ],
        :AwardOutcome,
        :MaskableObject ;
    skos:definition "Result concerning the Lot that was attributed by the Awarder."@en ;
    skos:historyNote "WG Approval 19/03/2024"@en ;
    skos:prefLabel "Lot Award Outcome"@en .

:MultipleStageProcedureTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasEstimatedInvitationToTenderDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasQualificationSystemRenewalDescription ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasNoNegotiationNecessary ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasSuccessiveReduction ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasEstimatedInvitationToExpressInterestDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasMaximumNumberOfCandidates ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Duration ;
            owl:onProperty :hasQualificationSystemDuration ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasMinimumNumberOfCandidates ],
        :Term ;
    skos:definition "Conditions and stipulations defining particularities of Procedures carried out in several steps Additional Information: Generally this refers to Procedures where selection is carried out to qualify Tenderers who are then requested to submit the rest of their Tender for evaluation is Restricted Procedure."@en ;
    skos:historyNote "WG Approval 15/04/2021"@en ;
    skos:prefLabel "Multiple Stage Procedure Term"@en .

:Price a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:Interval ;
            owl:onProperty :hasPriceValidity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasQuantityThreshold ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasOrderabableUnitFactorRate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasGrossMonetaryValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasBaseQuantity ],
        [ a owl:Restriction ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasNetMonetaryValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Duration ;
            owl:onProperty :hasExpectedDeliveryTime ] .

:Technique a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasValidityPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasEstimatedValidityPeriod ] ;
    skos:definition "Method used for conducting Procurement Procedures. Several Techniques can be combined in one single Procurement Procedure (e.g. eAuction can be carried out in a Framework Agreement or DPS)."@en ;
    skos:editorialNote "Used by eForms BG-706"@en ;
    skos:historyNote "WG Approval 19/09/2019"@en ;
    skos:prefLabel "Technique"@en .

:concernsLot a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CompletionNotice :ContractLotCompletionInformation :ContractModificationNotice :EvidenceRequest :EvidenceSubmission :LotAwardOutcome :ProcurementProcessInformation :ResultNotice cccev:InformationRequirement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Lot ;
    skos:definition "Relates to Lot."@en ;
    skos:prefLabel "concerns Lot"@en .

dcterms:date a owl:AnnotationProperty,
        owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "Date"@en ;
    dcterms:description "Date may be used to express temporal information at any level of granularity.  Recommended practice is to express the date, date/time, or period of time according to ISO 8601-1 [[ISO 8601-1](https://www.iso.org/iso-8601-date-and-time-format.html)] or a published profile of the ISO standard, such as the W3C Note on Date and Time Formats [[W3CDTF](https://www.w3.org/TR/NOTE-datetime)] or the Extended Date/Time Format Specification [[EDTF](http://www.loc.gov/standards/datetime/)].  If the full date is unknown, month and year (YYYY-MM) or just year (YYYY) may be used. Date ranges may be specified using ISO 8601 period of time specification in which start and end dates are separated by a '/' (slash) character.  Either the start or end date may be missing."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date .

:AbstractContainer a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasNetWeight ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasWidth ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasNetVolume ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasHeight ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasGrossVolume ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasTotalGoodsItemQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasGrossWeight ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasLength ] .

:ChangeInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :relatesToEFormSectionIdentifier ;
            owl:someValuesFrom adms:Identifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasProcurementDocumentChangeDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isProcurementDocumentChanged ],
        [ a owl:Restriction ;
            owl:onClass :Notice ;
            owl:onProperty :refersToPreviousNotice ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Notice ;
            owl:onProperty :concernsNotice ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasAdditionalInformation ],
        :ContextDescription ;
    skos:definition "Alteration to previously provided details."@en ;
    skos:editorialNote "Added hasAdditionalInformation to cover for section VII.2 in F14, since we do not have the Corrigendum notice type anymore in eForms."@en ;
    skos:prefLabel "Change Information"@en .

:ReviewRequest a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasReviewRequestFee ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ReviewRequester ;
            owl:onProperty :specifiesReviewRequester ] ;
    skos:definition "Information about requests to review procedures."@en ;
    skos:historyNote "WG Approval 23/10/2021"@en ;
    skos:prefLabel "Review Request"@en .

:SubcontractTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasMinimumSubcontractorsProposedObligation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasMinimumShare ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :hasSubcontractingInvolved ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasSubcontractorsProposedAboveObligation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasMaximumShare ],
        :Term ;
    skos:definition "A concept to describe the main information regarding the share of parts of the Contract to third parties."@en ;
    skos:prefLabel "Subcontract Term"@en .

:concernsProcedure a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AwardDecisionNotification :CompletionNotice :ContractModificationNotice :ESPDRequest :EvidenceRequest :EvidenceSubmission :ExpressionOfInterest :ProcurementProcessInformation :ResultNotice cccev:InformationRequirement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Procedure ;
    skos:definition "Relates to Procedure."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "concerns Procedure"@en .

cccev:InformationConcept a owl:Class ;
    rdfs:label "Information Concept"@en ;
    rdfs:comment "Piece of information that the Evidence provides or the Requirement needs."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/InformationConcept\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/InformationConcept</u></foreign></xref>"@en ;
    skos:prefLabel "Information Concept"@en ;
    skos:scopeNote "The Information Concept class offers the ability to describe conceptually the Requirements and provided facts in Evidences. In complementarity with the Supported Value class, this is a (first) step towards facilitating the assessment of the requirements in an automated way based on the Evidence provided."@en .

dcam:VocabularyEncodingScheme a owl:Class .

dc:date a owl:AnnotationProperty .

dcterms:description a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "Description"@en ;
    dcterms:description "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "An account of the resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AgentInRole :Document :ElectronicSignature :Fund :LocalLegalBasisInformation :LotGroup :NonDisclosureAgreementTerm :ProcurementElement :SecurityClearanceTerm :SubcontractTerm :SubcontractingEstimate :System :Technique :TenderGroup cccev:Channel cccev:ContactPoint cccev:Evidence cccev:InformationConcept cccev:Requirement ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf dc:description ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:LotGroup) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:ProcurementElement) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:TenderGroup) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:System) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:AgentInRole) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (cpov:ContactPoint) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (cv:Channel) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:NonDisclosureAgreementTerm) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:SecurityClearanceTerm) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:SubcontractTerm) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (cccev:Evidence) External concept defined by <xref scope=\"external\" href=\" https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (cccev:InformationConcept) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (cccev:Requirement) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:Technique) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:SubcontractingEstimate) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:Document) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:ElectronicSignature) External concept defined by <xref scope=\"external\" href=\"https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description\"><foreign otherprops=\"#0000ff\"><u>https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description</u></foreign></xref> (epo:Fund)"@en ;
    skos:prefLabel "description"@en .

:AbstractItem a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasSerialID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasSellerItemID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasManufacturerItemID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasNetQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasBuyerItemID ] .

:CompletionNotice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :NoticeAwardInformation ;
            owl:onProperty :refersToNoticeAwardInformation ],
        [ a owl:Restriction ;
            owl:onClass :Contract ;
            owl:onProperty :announcesCompletionOfContract ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :concernsLot ;
            owl:someValuesFrom :Lot ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:Consignment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasDeclaredStatisticalValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasConsigneeConsignmentID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasGrossWeight ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasGrossVolume ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasDespatcherConsignmentID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasLoadingMeter ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasTransportHandlingUnitQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasNetWeight ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Quantity ;
            owl:onProperty :hasTotalGoodsItemQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ] .

:DirectAwardPrenotificationNotice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :announcesLot ;
            owl:someValuesFrom :Lot ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :NoticeAwardInformation ;
            owl:onProperty :announcesNoticeAwardInformation ],
        [ a owl:Restriction ;
            owl:onProperty :announcesRole ;
            owl:someValuesFrom :AgentInRole ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :announcesProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:specifiesBuyer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Catalogue :Invoice :Order :OrderCancellation :OrderCancellationConfirmation :OrderCancellationRejection :OrderChangeConfirmation :OrderChangeRejection :ReceiptAdvice :RemittanceAdvice :RequestForOffer ) ] ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Buyer ;
    skos:prefLabel "specifies Buyer"@en .

:ContextDescription a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    skos:definition "A description concerning a Procurement Object or a Notice in a specific Situation Context. Additional Information: The description has its own identity (+I) but is dependent (+D) on the concerned Entity. We say that ContextDescription *concerns* an Entity."@en ;
    skos:prefLabel "Context Description"@en .

:ProcurementCriterion a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasFormula ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasAdditionalInformation ],
        cccev:Criterion ;
    skos:definition "A criterion specific to Procurement. Additional Information: This Procurement Criterion can be only Exclusion Ground, Selection Criterion or Award Criterion. Each of these Criteria can contain subcriteria (Criterion class)."@en ;
    skos:historyNote "WG Approval 23/04/2020"@en ;
    skos:prefLabel "Procurement Criterion"@en .

cccev:ContactPoint a owl:Class ;
    rdfs:label "Contact Point"@en ;
    rdfs:comment "Information (e.g. e-mail address, telephone number) of a person or department through which the user can get in touch with."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass locn:Address ;
            owl:onProperty locn:address ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasInternetAddress ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasContactName ] ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://data.europa.eu/m8g/ContactPoint\"><foreign otherprops=\"#0000ff\"><u>http://data.europa.eu/m8g/ContactPoint</u></foreign></xref>"@en ;
    skos:historyNote "WG approval 5/11/2019"@en ;
    skos:prefLabel "Contact Point"@en ;
    skos:scopeNote "Similarly to the Channel class, a Contact Point may have regular opening hours that are then overridden by, for example, public holidays, using the Temporal Entity class."@en,
        "The Core Public Organization Vocabulary defines properties for telephone number, e-mail address and opening hours although it is noteworthy that the class is based on schema.org's <a href=\"http://schema.org/ContactPoint\"> ContactPoint </a> class  that has additional properties that some implementations may find useful."@en .

:Order a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalChargeAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasSellerOrderID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalAllowanceAmount ],
        [ a owl:Restriction ;
            owl:onClass :Buyer ;
            owl:onProperty :specifiesBuyer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasRoundingAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalTaxInclusiveAmount ],
        [ a owl:Restriction ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasAmountDueForPayment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalTaxExclusiveAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasValidityPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Project ;
            owl:onProperty :refersToProject ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasPrepaidAmount ],
        [ a owl:Restriction ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalLineAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:ResultNotice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :refersToRole ;
            owl:someValuesFrom :AgentInRole ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :NoticeAwardInformation ;
            owl:onProperty :announcesNoticeAwardInformation ],
        [ a owl:Restriction ;
            owl:onProperty :concernsLot ;
            owl:someValuesFrom :Lot ] .

:ReviewDecision a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasWithdrawalDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasRemedyValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasWithdrawalReason ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Reviewer ;
            owl:onProperty :specifiesReviewer ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ReviewRequester ;
            owl:onProperty :specifiesReviewRequester ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isWithdrawn ] ;
    skos:definition "Information about Review Decisions."@en ;
    skos:prefLabel "Review Decision"@en .

foaf:Agent a owl:Class ;
    skos:definition "External concept defined by <xref scope=\"external\" href=\"http://xmlns.com/foaf/spec/#term_Agent\"><foreign otherprops=\"#0000ff\"><u>http://xmlns.com/foaf/spec/#term_Agent</u></foreign></xref>"@en ;
    skos:historyNote "WG Approval 28/04/2020"@en ;
    skos:prefLabel "Agent"@en,
        "Pref label for agent"@en .

:AccessTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isProcurementDocumentRestricted ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasRestrictedAccessURL ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty :hasPublicAccessURL ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :OfflineAccessProvider ;
            owl:onProperty :definesOfflineAccessProvider ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasAdditionalInformationDeadline ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ProcurementDocument ;
            owl:onProperty :involvesProcurementDocument ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ProcurementProcedureInformationProvider ;
            owl:onProperty :definesProcurementProcedureInformationProvider ],
        :Term ;
    skos:definition "Conditions and stipulations about where and how to access the Procurement Documents."@en ;
    skos:historyNote "WG Approval 09/03/2021"@en ;
    skos:prefLabel "Access Term"@en .

:AwardOutcome a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasBargainPrice ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasAwardJustification ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasAwardedValue ],
        :ContextualProjection ;
    skos:definition "Result concerning the competition that was attributed by the Awarder."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Award Outcome"@en .

:NoticeAwardInformation a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasApproximateFrameworkAgreementValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasProcurementHighestReceivedTenderValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasMaximumFrameworkAgreementAwardedValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasProcurementLowestReceivedTenderValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :DirectAwardPrenotificationNotice ;
            owl:onProperty :describesDirectAwardPrenotificationNotice ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalAwardedValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ResultNotice ;
            owl:onProperty :describesResultNotice ],
        :ContextDescription ;
    skos:definition "Information about an Award Notice."@en ;
    skos:prefLabel "Notice Award Information"@en .

:ProcedureTerm a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasMaximumLotSubmissionAllowed ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isOneLotOnlyAllowed ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Mediator ;
            owl:onProperty :definesMediator ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :BudgetProvider ;
            owl:onProperty :definesBudgetProvider ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isAwardedByCPB ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasLotAwardCombination ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasMaximumNumberOfLotsToBeAwarded ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isSubmissionForAllLotsRequired ],
        :MaskableObject,
        :Term ;
    skos:definition "Conditions and stipulations defining particularities of the Procedure."@en ;
    skos:historyNote "WG approval 23/11/2018"@en ;
    skos:prefLabel "Procedure Term"@en .

:ProcurementObject a owl:Class ;
    dcterms:references "<a href=\"https://example.com/link1\">Link</a>"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isUsingEUFunds ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasLaunchFrameworkAgreementMaximumValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isRecurrent ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasRecurrenceDescription ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ConcessionEstimate ;
            owl:onProperty :foreseesConcession ],
        :MaskableObject,
        :ProcurementElement ;
    skos:definition "The whole or a division of goods, services or works to be procured. Additional Information: Anything that can specify the procurement content (i.e. goods, services, work) is a Procurement Object. In a sense, such an \"object\" can constitute the \"object of a Contract\". To test whether something is a Procedure Object check if it can have a Purpose and/or CPV classification (<i>The CPV establishes a single classification system for public procurement aimed at standardising the references used by Contracting Authorities and entities to describe the subject of Procurement Contracts.</i>). Note: Procedure, seems to be an exception from this rule. Because it is a conflated term: it carries process properties and \"purpose\" properties."@en ;
    skos:note "This class should be used to represent the whole or a part of goods, services, or works intended for procurement. Each instance can be linked to a Purpose or a CPV classification to specify its content, facilitating standardization and clarity in procurement documentation."@en ;
    skos:prefLabel "Procurement Object"@en,
        "Procurement object (custom label)"@en .

dc:relation a owl:AnnotationProperty .

:AgentInRole a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass foaf:Agent ;
            owl:onProperty :playedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Relative concept that ties an Agent to a part they play in a given Situational Context. Additional information: The classification of roles is based is based on the degree of involvement into the Procurement Process: - Primary (Procurement) Pole is directly involved in the Procurement Process; - Secondary (Procurement sub-) Role is secondary to the Procurement Process - Tertiary (Related) Role is not involved in the Procurement Process."@en ;
    skos:prefLabel "Agent In Role"@en .

:OfferingParty a owl:Class ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subClassOf :AgentInRole ;
    skos:definition "The Role of an Agent that acts on the Economic Operator side during a Procurement Process. Additional information: As per the European Procurement Directives the notion of ï¿½Economic Operatorsï¿½ should be interpreted in a broad manner so as to include any Persons and/or Entities which offer the execution of works, the supply of products or the provision of services on the market, irrespective of the legal form under which they have chosen to operate. Thus, firms, branches, subsidiaries, partnerships, cooperative societies, limited companies, universities, public or private, and other forms of entities than natural Persons should all fall within the notion of Economic Operator, whether or not they are ï¿½Legal Personsï¿½ in all circumstances."@en ;
    skos:prefLabel "Offering Party"@en .

:Invoice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Contract ;
            owl:onProperty :refersToContract ],
        [ a owl:Restriction ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasAmountDueForPayment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Buyer ;
            owl:onProperty :specifiesBuyer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasRoundingAmount ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Project ;
            owl:onProperty :refersToProject ],
        [ a owl:Restriction ;
            owl:onProperty :hasLotReference ;
            owl:someValuesFrom :Lot ],
        [ a owl:Restriction ;
            owl:onProperty :hasTotalTaxInclusiveAmount ;
            owl:someValuesFrom :MonetaryValue ],
        [ a owl:Restriction ;
            owl:onProperty :hasTotalLineAmount ;
            owl:someValuesFrom :MonetaryValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Interval ;
            owl:onProperty :hasInvoicingPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasInvoicedObjectIdentifier ],
        [ a owl:Restriction ;
            owl:onProperty :hasTotalTaxExclusiveAmount ;
            owl:someValuesFrom :MonetaryValue ] .

dcterms:relation a owl:AnnotationProperty,
        owl:NamedIndividual ;
    rdfs:label "Relation"@en ;
    dcterms:description "Recommended practice is to identify the related resource by means of a URI.  If this is not possible or feasible, a string conforming to a formal identification system may be provided."@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:subPropertyOf dc:relation .

time:Duration a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty time:numericDuration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
