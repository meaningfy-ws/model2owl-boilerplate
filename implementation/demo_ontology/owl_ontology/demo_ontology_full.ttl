    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Interval ;
    skos:prefLabel "has Delivery Period"@en .

:hasDescriptionOfPrizes a owl:DatatypeProperty ;
    rdfs:domain :DesignContestRegimeTerm ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Explanatory text about Prizes. (epo:DesignContestRegimeTerm)"@en ;
    skos:historyNote "WG Approval 26/03/2024"@en ;
    skos:prefLabel "has Description Of Prizes"@en .

:hasDespatchPeriod a owl:ObjectProperty ;
