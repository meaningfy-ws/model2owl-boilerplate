    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:definition "The value offered by the Tenderer for a Lot. Additional Information: This value is normally the one awarded for a winning Tender Lot. In case of negotiated procedures the original financial value may be reviewed and the offer updated."@en ;
    skos:editorialNote "Used by eForms BT-720"@en ;
    skos:prefLabel "has Financial Offer Value"@en .

:hasFixedValue a owl:DatatypeProperty ;
