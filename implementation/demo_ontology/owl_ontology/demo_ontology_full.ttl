:hasGroupFrameworkAgreementMaximumValue a owl:ObjectProperty ;
    rdfs:domain :LotGroupAwardInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:editorialNote "Used by eForms BT-156"@en ;
    skos:prefLabel "has Group Framework Agreement Maximum Value"@en .

:hasHeight a owl:ObjectProperty ;
    rdfs:domain :AbstractContainer ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :Quantity ;
    skos:definition "The vertical measurement."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
