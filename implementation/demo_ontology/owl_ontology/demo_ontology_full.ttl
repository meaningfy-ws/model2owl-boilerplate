    skos:editorialNote "Used by eForms BT-543"@en ;
    skos:prefLabel "has Formula"@en .

:hasFrameworkAgreementMaximumValue a owl:ObjectProperty ;
    rdfs:domain :LotAwardOutcome ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
