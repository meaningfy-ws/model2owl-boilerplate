    skos:definition "Formula for obtaining values. Additional Information: The possible values are monetary values, ranking scores, criterion weighting. (epo:ConcessionEstimate)"@en ;
    skos:historyNote "WG Approval 25/05/2018"@en ;
    skos:prefLabel "has Calculation Method"@en .

:hasCatalogueLineValidity a owl:ObjectProperty ;
    rdfs:domain :CatalogueLine ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range time:Interval ;
    skos:definition "The relation indicating until when a Catalogue Line instance is applicable."@en ;
    skos:historyNote "WG Approval 21/09/2023"@en ;
    skos:prefLabel "has Catalogue Line Validity"@en .

:hasCertificationNumber a owl:DatatypeProperty ;
    rdfs:domain :Certificate ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The unique identifier of the certificate. (epo:Certificate)"@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "has Certification Number"@en .

:hasCleanVehicles a owl:DatatypeProperty ;
    rdfs:domain :CleanVehicleDirectiveInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The number of all clean vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)"@en ;
    skos:historyNote "WG Approval 28/07/2020"@en ;
    skos:prefLabel "has Clean Vehicles"@en .

:hasConcessionEstimatedValue a owl:ObjectProperty ;
    rdfs:domain :ConcessionEstimate ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range :MonetaryValue ;
    skos:prefLabel "has Concession Estimated Value"@en .

:hasConfidentialityJustification a owl:DatatypeProperty ;
    rdfs:domain :NonPublishedInformation ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "A narrative explanation of why data is not published. Additional Information: This element is generally used when the non-publication-justification code chosen is \"other\". (epo:NonPublishedInformation)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Confidentiality Justification"@en .

:hasConsigneeConsignmentID a owl:ObjectProperty ;
    rdfs:domain :Consignment ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range adms:Identifier ;
    skos:definition "The identifier of the the Consignment given by the Consignee."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Consignee Consignment ID"@en .

:hasContactName a owl:DatatypeProperty ;
    rdfs:domain cccev:ContactPoint ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "A short text by which a contact is known or referred to. (cpov:ContactPoint)"@en ;
    skos:historyNote "WG Approval: 27/01/2022"@en ;
    skos:prefLabel "has Contact Name"@en .

:hasContractConclusionDate a owl:DatatypeProperty ;
    rdfs:domain :Contract ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    rdfs:range xsd:date ;
    skos:definition "The date the contract was signed by the last signatory party. <u>Additional Information:</u> In exceptional cases contracts may be concluded without signature and therefore another date may be used. The date of contract conclusion is always later than the end of any standstill period. This concept is not to be confused with the date of completion/end of the contract. (epo:Contract)"@en ;
    skos:editorialNote "Used by eForms BT-145"@en ;
    skos:historyNote "WG Approval 09/01/2020"@en ;
    skos:prefLabel "has Contract Conclusion Date"@en .

:hasContractValue a owl:ObjectProperty ;
