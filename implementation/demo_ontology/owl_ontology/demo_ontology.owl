        <skos:prefLabel xml:lang="en">has DPS Scope</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasDebitAmount -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDebitAmount">
