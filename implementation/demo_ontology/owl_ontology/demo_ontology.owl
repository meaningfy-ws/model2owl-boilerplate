        <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Consignee Consignment ID</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasConstraint -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConstraint">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Constraint</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasContactPointInRole -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasContactPointInRole">
