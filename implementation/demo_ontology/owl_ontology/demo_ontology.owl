    <!-- http://data.europa.eu/a4g/ontology#describesProfessionRelevantLaw -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#describesProfessionRelevantLaw">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Explanatory text about the law concerning the profession. (epo:ProfessionalSuitabilitySummary)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">describes Profession Relevant Law</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#describesVerificationMethod -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#describesVerificationMethod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">General explanatory text on the means used to validate the Participation Conditions. (epo:ParticipationConditionsSummary)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">describes Verification Method</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAbnormallyLowTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAbnormallyLowTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Tenders received that were found irregular and non-acceptable due to an abnormally low price or cost. Additional Information The definition implies that abnormally Low Tender Lots are Inadmissible Tender Lots. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Abnormally Low Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAcceleratedProcedureJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAcceleratedProcedureJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The reasons why the procedure is accelerated. Additional Information: A procedure is accelerated to cover needs of extraordinary circumstances ie earthquake relief. (epo:Procedure)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/06/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Accelerated Procedure Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAccessURL -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAccessURL">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Location where the resource can be accessed. (epo:Document)</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 07/04/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Access URL</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAccessibilityDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAccessibilityDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The date at which unpublished data shall be published. (epo:NonPublishedInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 11/06/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Accessibility Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasActivityDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasActivityDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">In the ePO ontology a taxonomy with all activities, based on different classifications (COFOG, UTILITIES, NACE), will be provided. In ePO this field is to be used exclusively to complement the definition attached to the MainActivityCode. However, in eForms there is the code &quot;other&quot; to cover undefined activities. For mapping to this eForms feature one could also use this property. (epo:Buyer)</skos:definition>
        <skos:prefLabel xml:lang="en">has Activity Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAdditionalInformation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAdditionalInformation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Supplementary data about the instance of the concept. (epo:ProcurementElement) Supplementary data about the instance of the concept. (epo:ProcurementCriterion) Supplementary data about the instance of the concept. (epo:Document) Supplementary data about the instance of the concept. (epo:ChangeInformation)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eforms BT-300</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 15/10/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Additional Information</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAdditionalInformationDeadline -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAdditionalInformationDeadline">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The time limit for requesting further information. Additional information: This is generally used to indicate the deadline for Economic Operators to request further information of the procedure before the submission deadline. (epo:AccessTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-13</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 09/06/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Additional Information Deadline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAddressURL -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAddressURL">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The resource identifier for a Channel. (cv:Channel)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Address URL</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAlias -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAlias">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Acronym or alternative name of the Agent. (foaf:Agent)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 25/03/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Alias</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAmountValue -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAmountValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The numeric value of the amount, including decimals. (epo:MonetaryValue)</skos:definition>
        <skos:prefLabel xml:lang="en">has Amount Value</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardCriteriaEvaluationFormula -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriteriaEvaluationFormula">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion. (epo:AwardEvaluationTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-543</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Award Criteria Evaluation Formula</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardCriteriaOrderJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriteriaOrderJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The justification for only indicating the award criteria&apos;s order of importance, not their weighing. (epo:AwardEvaluationTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-733</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Award Criteria Order Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardCriteriaStatedInProcurementDocuments -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriteriaStatedInProcurementDocuments">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The Award Criteria are provided in the Procurement Documents. (epo:AwardCriterion)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Award Criteria Stated In Procurement Documents</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardDateScheduled -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardDateScheduled">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Planned date for the award decision. (epo:ProcessPlanningTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Award Date Scheduled</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardDecisionDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardDecisionDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The official date of the award decision. (epo:AwardDecision)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-1451</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 09/01/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Award Decision Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Description of the reason behind an award or non-award of a given Tender. Additional information: This is generally used when the non award justification code is set to &quot;Other&quot; and when the Lot is awarded. It may highlight the justification of the non-award of a Tender with regard to awarded Tenders. (epo:AwardOutcome)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 25/02/2025</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Award Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardRank -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardRank">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The position of the tender (i.e. whether the tender ended up first, second, third, etc.) in a design contest, some framework agreements with multiple winners (e.g. cascades) or an innovation partnership. (epo:TenderAwardOutcome)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-171</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Award Rank</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBuyerCategoryDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerCategoryDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A classification of buyers participating in a framework agreement. Additional Information: Buyers that can use the Framework Agreement not mentioned by name. For example, the classification &quot;all hospitals in the Tuscany region&quot; is used instead of naming each individual buyer. (epo:FrameworkAgreementTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-111</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 06/05/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Buyer Category Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBuyerLegalTypeDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerLegalTypeDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Self-explanatory text about the Buyer Legal Type. Additional information: This field is used when the Buyer Legal Type is not available in the controlled list at-voc:buyer-legal-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future. (org:Organization)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Buyer Legal Type Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBuyerProfile -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerProfile">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Website address where the buyer publishes information on its procurement procedures and general information. (epo:Buyer)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-508</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG approval 04/05/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Buyer Profile</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCalculationMethod -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCalculationMethod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Formula for obtaining values. Additional Information: The possible values are monetary values, ranking scores, criterion weighting. (epo:ConcessionEstimate)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 25/05/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Calculation Method</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCertificationNumber -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCertificationNumber">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The unique identifier of the certificate. (epo:Certificate)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Certification Number</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasChangeDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasChangeDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Explanatory text about the instance of the concept. (epo:ChangeInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 30/09/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Change Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasChangeReasonDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasChangeReasonDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Explanatory text about why the element is altered. (epo:ChangeInformation)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-762</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Change Reason Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCleanVehicles -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCleanVehicles">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number of all clean vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Clean Vehicles</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasConditionVerificationMethod -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConditionVerificationMethod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Means used to validate the qualification requirements. (epo:QualificationCriteriaSummary)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Condition Verification Method</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasConfidentialityJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConfidentialityJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A narrative explanation of why data is not published. Additional Information: This element is generally used when the non-publication-justification code chosen is &quot;other&quot;. (epo:NonPublishedInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Confidentiality Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasContactName -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasContactName">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A short text by which a contact is known or referred to. (cpov:ContactPoint)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval: 27/01/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Contact Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasContractConclusionDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasContractConclusionDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The date the contract was signed by the last signatory party. &lt;u&gt;Additional Information:&lt;/u&gt; In exceptional cases contracts may be concluded without signature and therefore another date may be used. The date of contract conclusion is always later than the end of any standstill period. This concept is not to be confused with the date of completion/end of the contract. (epo:Contract)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-145</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 09/01/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Contract Conclusion Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCrossBorderLaw -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCrossBorderLaw">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The applicable law when buyers from different countries procure together within one procurement procedure. (epo:ProcedureTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-09</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Cross Border Law</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCurrencyCodeListAgencyID -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCurrencyCodeListAgencyID">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Identifier of the agency that maintains the currency code list used. (epo:MonetaryValue)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 13/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Currency Code List Agency ID</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCurrencyCodeListAgencyName -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCurrencyCodeListAgencyName">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Name of the agency that maintains the currency code list used. (epo:MonetaryValue)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 13/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Currency Code List Agency Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCurrencyCodeListID -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCurrencyCodeListID">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Concept scheme URI used for the currency code list. (epo:MonetaryValue)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 13/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Currency Code List ID</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasDeadline -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDeadline">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The time limit by which the security clearance must be submitted to the buyer. (epo:SecurityClearanceTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Deadline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasDescriptionOfPrizes -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDescriptionOfPrizes">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Explanatory text about Prizes. (epo:DesignContestRegimeTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Description Of Prizes</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasDispatchDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDispatchDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Date and time of transmission of a record to an Organization. (epo:Document)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 31/08/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Dispatch Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasDurationExtensionJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDurationExtensionJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The explanation of the reason why the framework agreement has an extended duration. Additional Information: The justification for exceptional cases when the duration of the framework agreement exceeds the legal limits. Four years in the case of the general procurement Directive, seven years in the case of the defence Directive, and eight years in the case of the sectoral Directive. (epo:FrameworkAgreementTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-109</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 26/09/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Duration Extension Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEAuctionURL -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEAuctionURL">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The internet address of the electronic auction. (epo:SubmissionTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-123</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has E Auction URL</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEEAReceivedTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEEAReceivedTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of tenders received from economic operators in other EEA countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has EEA Received Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEInvoicing -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEInvoicing">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Electronic means will be used for invoicing in the post-award process. Additional Information: This attribute is used for standard form mappings. (epo:ContractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/09/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has E Invoicing</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEOrdering -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEOrdering">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Electronic means will be used for requesting and purchasing in the post-award process. (epo:ContractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/09/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has E Ordering</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEPayment -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEPayment">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Electronic means must be used for paying. (epo:ContractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has E Payment</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasESenderDispatchDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasESenderDispatchDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The date and time the notice was transmitted electronically by the eSender to the Publications Office of the European Union. Additional Information: Typically, eSenders include national Official Journals, Buyers sending a large number of electronic Notices, public or private bodies acting on behalf of Buyers and eProcurement software developers. (epo:Notice)</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 20/06/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has E Sender Dispatch Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEUReceivedTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEUReceivedTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of tenders received from economic operators in other EU countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:prefLabel xml:lang="en">has EU Received Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasElectronicSubmission -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicSubmission">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Transmission of tenders is possible by electronic means of communication. (epo:Tender)</skos:definition>
        <skos:prefLabel xml:lang="en">has Electronic Submission</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasElectronicTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Electronic Tender Lots received. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Electronic Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasElementReference -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElementReference">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Reference to the class instance in the current notice. (epo:ReviewInformation)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-13716, eForms BT-786, eForms BT-1501</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Element Reference</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEntryIntoForceDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEntryIntoForceDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The date on which the contract enters into force. Additional information: This is generally the date on which the fulfillment of the contract begins. (epo:Contract)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 05/11/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Entry Into Force Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedContractNoticePublicationDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedContractNoticePublicationDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Foreseen date for publication of Contract Notice. (epo:ProcessPlanningTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-127</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Estimated Contract Notice Publication Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedInvitationToExpressInterestDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedInvitationToExpressInterestDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The estimated date of dispatch of the invitations to confirm interest. (epo:MultipleStageProcedureTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-631</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Estimated Invitation To Express Interest Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedInvitationToTenderDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedInvitationToTenderDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The estimated date of dispatch of the invitations to submit tenders in two (or more) stage procedures. (epo:MultipleStageProcedureTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-130</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 01/10/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Estimated Invitation To Tender Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedPercentage -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedPercentage">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The estimated proportion foreseen to be subcontracted. (epo:SubcontractingEstimate)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 07/01/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Estimated Percentage</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedTenderInvitationDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedTenderInvitationDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The planned date for the dispatch of the invitations to submit tenders. (epo:ProcessPlanningTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Estimated Tender Invitation Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedTotalSubcontracts -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedTotalSubcontracts">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The estimated amount of work to be subcontracted in the contract resulting from the lot. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Estimated Total Subcontracts</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasExtension -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasExtension">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Extension</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFax -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFax">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The fax number used to reach a person or an organisation. (cpov:ContactPoint)</skos:definition>
        <skos:prefLabel xml:lang="en">has Fax</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFixedValue -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFixedValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:editorialNote xml:lang="en">Used by eForms BT-541, eForms BT-5422</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Fixed Value</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFollowupContract -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFollowupContract">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Any subsequent service contract will be awarded to the winner or, in the case of a design contest, winners. (epo:DesignContestRegimeTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 29/08/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Followup Contract</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFollowupContractInformation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFollowupContractInformation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Further information about follow-up contracts, prizes and payments (for example non-monetary prizes, payments given for participation). (epo:DesignContestRegimeTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 03/09/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Followup Contract Information</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFormNumber -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFormNumber">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number of the form used to create the Standard Form Notice and not an eForms Notice. (epo:Notice)</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Form Number</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFormula -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFormula">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion. (epo:ProcurementCriterion)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-543</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Formula</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasGroupLotEvaluationMethod -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGroupLotEvaluationMethod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Description of how lots and groups of lots are evaluated against one another in the procedure. (epo:ProcedureTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Group Lot Evaluation Method</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasGroupType -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGroupType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Form of collaboration agreement between organisations. Additional Information: This is not a legal type; not to be mistaken with epo:hasLegalFormType which may also be used for Organisation Groups. (epo:OrganisationGroup)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Group Type</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasGuaranteeDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGuaranteeDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information on the financial commitment required from the economic operator. Additional Information: 1. This information may include the amount and the way of delivering of the guarantee 2. The financial commitment may be retained by the buyer in the case the tenderer withdraws the submitted information (i.e. tender, expression of interest and request for participation, but not request for clarifications) before the award of the contract or does not sign the contract. 3. Usual modalities are bonds, cheques, loans, other. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 21/07/20</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Guarantee Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasInadmissibleTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInadmissibleTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Tenders received that cannot be awarded due to non-compliance to procurement document requirements or having an abnormally low price or cost. &lt;u&gt;Additional Information: &lt;/u&gt; Non-compliance with a Procurement Document requirements include exclusion grounds, selection criteria and submission deadline, etc. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Inadmissible Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasInternetAddress -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInternetAddress">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The main web page used by the instance of the concept. (org:Organization) The main web page used by the instance of the concept. (cpov:ContactPoint)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 01/06/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Internet Address</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">An explanation about the reasons for using the concept. (epo:DirectAwardTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 05/11/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLateSubmissionInformationDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLateSubmissionInformationDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A narrative text explaining the content of the economic operator information that can be submitted late. Additional Information This does not apply to requests for clarifications. (epo:SubmissionTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Late Submission Information Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLegalBasisDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalBasisDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Explanatory text about the legal basis. (epo:ProcurementElement)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Legal Basis Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLegalFormRequirement -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalFormRequirement">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The legal form to be taken by a Contractor. Additional Information: Generally, this is defined to cover the case where an Organisation Group is involved. Note that the codelist provided at national level should be used. (epo:ContractTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Legal Form Requirement</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLegalFormType -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalFormType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The classification of an Organisation according to legislation. Additional Information: Generally, this is defined for Tenderers who want to submit as an Organisation Group. Note that the codelist provided at national level should be used. (org:Organization)</skos:definition>
        <skos:prefLabel xml:lang="en">has Legal Form Type</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLegalName -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalName">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The officially registered name of an organisation. (org:Organization)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 10/01/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Legal Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLotAwardCombination -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLotAwardCombination">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The contracting authority reserves the right to award contracts combining lots or groups of lots. Additional Information: This property contains information about the Lots concerned. This property is required by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 23/08/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Lot Award Combination</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMainActivityDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMainActivityDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Self-explanatory text about the Main Activity . Additional information: This field is used when the Main Activity is not available in the controlled list at-voc:main-activity-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future. (org:Organization)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Main Activity Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMainFeature -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMainFeature">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Main features of the procedure and information about where the full rules for the procedure can be found. Additional Information: This information should be given when the procedure is not one of those mentioned in the procurement directives. This can be the case for example for concessions, for social and other specific services, and in case of voluntary publication of procurement procedures below the EU procurement thresholds. (epo:Procedure)</skos:definition>
        <skos:prefLabel xml:lang="en">has Main Feature</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMaskableProperty -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaskableProperty">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Maskable Property</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMaximumLotSubmissionAllowed -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumLotSubmissionAllowed">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The total number of lots for which one Tenderer can submit Tenders. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Maximum Lot Submission Allowed</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMaximumNumberOfCandidates -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfCandidates">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Maximum number of candidates to be invited for the second stage of the procedure. (epo:MultipleStageProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Maximum Number Of Candidates</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMaximumNumberOfLotsToBeAwarded -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfLotsToBeAwarded">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The maximum number of lots for which contract(s) can be awarded to one tenderer. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Maximum Number Of Lots To Be Awarded</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMaximumNumberOfRenewals -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfRenewals">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The maximum number of times the contract can be renewed. Additional Information By renewing, the buyer reserves the right (i.e. not an obligation) to renew the contract (i.e. extend its duration) without a new procurement procedure. For example, a contract may be valid for one year and the buyer may keep a possibility to renew it (e.g. once, twice) for another three months, if he is content with the services he received. PLEASE REVIEW THIS DEFINITION AGAIN WITH THE WORKING GROUP. It was originally taken from eForms. (epo:ContractTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Maximum Number Of Renewals</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMaximumParticipantsNumber -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumParticipantsNumber">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The maximum number of participants in the framework agreement. Additional Information: Maximum number of tenderers who may be awarded a contract within the framework agreement. The number is a positive integer. (epo:FrameworkAgreementTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-113</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 05/02/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Maximum Participants Number</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMaximumShare -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumShare">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The maximum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 17/09/2019 </skos:historyNote>
        <skos:prefLabel xml:lang="en">has Maximum Share</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMediumTenderPerLots -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMediumTenderPerLots">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Tenders from medium-sized enterprise. &lt;u&gt;Additional Information:&lt;/u&gt; See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:prefLabel xml:lang="en">has Medium Tender Per Lots</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMinimumNumberOfCandidates -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumNumberOfCandidates">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Minimum number of candidates to be invited for the second stage of the procedure. (epo:MultipleStageProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Minimum Number Of Candidates</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMinimumShare -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumShare">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The minimum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 17/09/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Minimum Share</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMinimumSubcontractorsProposedObligation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumSubcontractorsProposedObligation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The minimum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Minimum Subcontractors Proposed Obligation</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNationalProcedureRules -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNationalProcedureRules">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The resource identifier where the information about the national rules applicable to the procedure can be found. (epo:ProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has National Procedure Rules</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNoNegotiationNecessary -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNoNegotiationNecessary">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The buyer reserves the right to award the contract on the basis of the initial tenders without any further negotiations. Additional information: See Article 29(4) of Directive 2014/24/EU. (epo:MultipleStageProcedureTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has No Negotiation Necessary</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNonAccessibilityCriterionJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonAccessibilityCriterionJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Reason for not applying accessibility criteria. (epo:SocialProcurement)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-755</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 05/03/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Non Accessibility Criterion Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNonAwardedContractNumber -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonAwardedContractNumber">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Non Awarded Contract Number</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNonAwardedContractTitle -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonAwardedContractTitle">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The title the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Non Awarded Contract Title</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNonEEAReceivedTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonEEAReceivedTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of tenders received from economic operators in non-EEA countries. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Non EEA Received Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNonEUReceivedTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonEUReceivedTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of tenders received from economic operators in non-EU countries. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:prefLabel xml:lang="en">has Non EU Received Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNonElectronicSubmissionDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonElectronicSubmissionDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Textual explanation of how non-electronic information is to be presented. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Non Electronic Submission Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNoticePublicationNumber -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNoticePublicationNumber">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The identifier of the published Notice. Additional information: The format of this identifier is XXXXXXXX-YYYY. (epo:Notice)</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Notice Publication Number</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNumberOfReviewRequests -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNumberOfReviewRequests">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number of requests the buyer received to review any of its decisions. (epo:ReviewRequestSummary)</skos:definition>
        <skos:prefLabel xml:lang="en">has Number Of Review Requests</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNumberOfTenderersInvited -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNumberOfTenderersInvited">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Number of economic operators invited to tender. Additional Information This may be used for single-stage procedures or to indicate the number of candidates invited to tender in multi-stage procedures. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 01/12/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Number Of Tenderers Invited</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasNumberOfTendersConcerned -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNumberOfTendersConcerned">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Number Of Tenders Concerned</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOJSIssueNumber -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOJSIssueNumber">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The issue identifier of the Supplement to the EU Official Journal. Additional information: The format of this identifier is XX-YYYY. (epo:Notice)</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has OJS Issue Number</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOpeningDateTime -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningDateTime">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Date and time for the opening of tenders. (epo:OpeningTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/03/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Opening Date Time</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOpeningDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Further information about the opening of tenders. Additional Information For example, who may participate in the opening and whether any authorization is needed. (epo:OpeningTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/03/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Opening Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOpeningPlace -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningPlace">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The place (e.g. physical address, URL) where the tenders will be publicly opened. (epo:OpeningTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 06/03/2025</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Opening Place</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOpeningURL -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningURL">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The identifier of the address of the Opening of Tenders. (epo:OpeningTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Opening URL</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOptions -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOptions">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The buyer reserves the right (not an obligation) for additional purchases from the contractor (while the contract is valid). (epo:ContractTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Options</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOptionsDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOptionsDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The motivation and details about additional purchases that the buyer may undertake while the contract is valid. (epo:ContractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/04/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Options Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOtherCountriesReceivedTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOtherCountriesReceivedTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of Tenders received from European Economic Area countries other than that of the Buyer. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Other Countries Received Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOverallCostAwardCriteriaPonderation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOverallCostAwardCriteriaPonderation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The weighting given to cost. Additional Information: This weighting covers usually all cost criteria against price or quality criteria. (epo:AwardEvaluationTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Overall Cost Award Criteria Ponderation</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOverallPriceAwardCriteriaPonderation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOverallPriceAwardCriteriaPonderation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The weighting given to price. Additional Information: This weighting covers usually all price criteria against cost or quality criteria. (epo:AwardEvaluationTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Overall Price Award Criteria Ponderation</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasOverallQualityAwardCriteriaPonderation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOverallQualityAwardCriteriaPonderation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The weighting given to quality. Additional Information: This weighting covers usually all quality criteria against price or cost criteria. (epo:AwardEvaluationTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Overall Quality Award Criteria Ponderation</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasParticipationPayment -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasParticipationPayment">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Details on payments to participants (epo:DesignContestRegimeTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Participation Payment</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasPaymentArrangement -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentArrangement">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information about financial clauses that will govern some economic aspects of the execution of the contract. Additional Information: These clauses usually refer to financial and payment provisions. This type of information should be structured instead of a free text in order to reuse it an ideal world. Unfortunately this is an information that in the real life no one is willing to provide pro-actively. WG Pending of discussion with eForms (epo:ContractTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Payment Arrangement</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasPaymentValueDiscrepancyJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentValueDiscrepancyJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Justification for the actual value being different to the value in the initial Contract. (epo:ContractLotCompletionInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Payment Value Discrepancy Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasPerformanceConditions -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPerformanceConditions">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The particular conditions and additional information related to the execution of the contract. Additional Information: For example, specific information about the place of performance, intermediary deliverables, compensation for damages, intellectual property rights. (epo:ContractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 15/01/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Performance Conditions</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasPlaceOfPerformanceAdditionalInformation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPlaceOfPerformanceAdditionalInformation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Further details on the location of the execution of the contract. (epo:ContractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 30/07/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Place Of Performance Additional Information</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasPrizeRank -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPrizeRank">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The position of the prize (e.g. first place, second place) in a design contest list of prizes. (epo:Prize)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 29/08/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Prize Rank</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasProcurementDocumentChangeDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasProcurementDocumentChangeDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The date and time of the change. (epo:ChangeInformation)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-719</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 5/11/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Procurement Document Change Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasPublicAccessURL -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPublicAccessURL">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Web page where the procurement documents can be downloaded. (epo:AccessTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-15</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 09/03/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Public Access URL</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasPublicInterestExceptionJustification -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPublicInterestExceptionJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Public Interest Exception Justification</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasPublicationDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPublicationDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Date of formal public issuance of the document. (epo:Document)</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 20/06/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Publication Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasQualificationCondition -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationCondition">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Requirements to be fulfilled by tenders in view of their qualification. (epo:QualificationCriteriaSummary)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Qualification Condition</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasQualificationCriteriaStatedInESPDRequest -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationCriteriaStatedInESPDRequest">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Qualification Criteria Stated In ESPD Request</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasQualificationCriteriaStatedInNotice -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationCriteriaStatedInNotice">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Qualification Criteria Stated In Notice</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasQualificationCriteriaStatedInProcurementDocuments -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationCriteriaStatedInProcurementDocuments">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Qualification Criteria Stated In Procurement Documents</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasQualificationSystemRenewalDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationSystemRenewalDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Explanation of how a Qualification System is re-established. Additional information: A Qualification System qualifies an economic operator to take part in a tendering process. Usually, in such cases the economic operator passes the Exclusion Grounds and Selection Criteria. (epo:MultipleStageProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Qualification System Renewal Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasQuantityValue -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQuantityValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The numeric value of the quantity, including decimals. (epo:Quantity)</skos:definition>
        <skos:prefLabel xml:lang="en">has Quantity Value</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceiptDeadline -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptDeadline">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The time limit for receiving submissions. Additional Information This is the deadline by which the buyer must receive submissions (e.g. tenders, requests to participate, clarifications, etc.) and is not the time at which the information is submitted by the economic operator. This attribute should be used for standard forms mappings. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Receipt Deadline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceiptExpressionDeadline -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptExpressionDeadline">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Time limit for receipt of expressions of interest. Pending of review by the WG (epo:SubmissionTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">has Receipt Expression Deadline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceiptParticipationRequestDeadline -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptParticipationRequestDeadline">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The time limit until which requests to participate can be received. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Receipt Participation Request Deadline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceiptPreliminaryMarketConsultationDeadline -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptPreliminaryMarketConsultationDeadline">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The time limit until which answers to the Preliminary Market Consultation can be received. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Receipt Preliminary Market Consultation Deadline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceiptTenderDeadline -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptTenderDeadline">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The time limit until which the Tenders can be received. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Receipt Tender Deadline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceivedMicroTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedMicroTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of tenders received from a micro enterprise. &lt;u&gt;Additional Information:&lt;/u&gt; See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:prefLabel xml:lang="en">has Received Micro Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceivedParticipationRequests -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedParticipationRequests">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of applications to participate from economic operators. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Received Participation Requests</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceivedSmallTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedSmallTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Tenders from small enterprise. &lt;u&gt;Additional Information:&lt;/u&gt; See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:prefLabel xml:lang="en">has Received Small Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceivedTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The total amount of tenders received. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Received Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReceptionDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceptionDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Date when a record is acknowledged by an Organization. (epo:Document)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/05/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Reception Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasRecurrenceDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRecurrenceDescription">
        <dct:references xml:lang="en">&lt;a href=&quot;https://example.com/link1&quot;&gt;Link 1&lt;/a&gt;</dct:references>
        <cfg:usage xml:lang="en">Recommended</cfg:usage>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Any additional information about the recurrence of the Procurement. Additional Information: For example estimated timing of the Procedure. (epo:ProcurementObject)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-95</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 16/01/2019</skos:historyNote>
        <skos:note xml:lang="en">Provides a concise, human-readable description of the legal basis (statute, regulation, or contractual provision) that justifies an entity&apos;s obligations or permissions, and include a reference identifier.</skos:note>
        <skos:prefLabel xml:lang="en">has Recurrence Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReferenceURI -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReferenceURI">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A reference to where the label specification (norms, expectations, standards and policies) can be found. (epo:CertificationLabel)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Reference URI</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasRenewalDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRenewalDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Any other information about the renewal(s). (epo:ContractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 16/04/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Renewal Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasRestrictedAccessURL -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRestrictedAccessURL">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The internet address with information on accessing the restricted (part of the) procurement document. (epo:AccessTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-615</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Restricted Access URL</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReviewDeadline -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewDeadline">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The time limit for review procedures. (epo:ReviewTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Review Deadline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReviewDeadlineInformation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewDeadlineInformation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The description of the time limits for review procedures. (epo:ReviewTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 01/10/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Review Deadline Information</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReviewIrregularityCount -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewIrregularityCount">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number of requests for a given irregularity. (epo:ReviewIrregularitySummary)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-635</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Review Irregularity Count</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasReviewProcedure -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewProcedure">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The description of the method used to request the verification that the procedure has been carried out correctly. (epo:ReviewTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Review Procedure</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSMEReceivedTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSMEReceivedTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of tenders received from micro, small and medium-sized enterprises. &lt;u&gt;Additional Information:&lt;/u&gt; See Commission Recommendation 2003/361/EC. The ReceivedSMETenderLots is used when the size of the company is not exactly known. (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 05/03/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has SME Received Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSMEReceivedTendersExcludingSubcontractors -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSMEReceivedTendersExcludingSubcontractors">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has SME Received Tenders Excluding Subcontractors</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasScheme -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasScheme">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The name of the identification scheme. (adms:Identifier)</skos:definition>
        <skos:prefLabel xml:lang="en">has Scheme</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSchemeVersion -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSchemeVersion">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The version of the identification scheme. (adms:Identifier)</skos:definition>
        <skos:prefLabel xml:lang="en">has Scheme Version</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSelectionCriteriaStatedInProcurementDocuments -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSelectionCriteriaStatedInProcurementDocuments">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The Selection Criteria are present in the Procurement Documents. (epo:SelectionCriteriaSummary)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Selection Criteria Stated In Procurement Documents</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasServiceReservedToParticularProfession -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasServiceReservedToParticularProfession">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Execution of the contract is limited to a particular profession. (epo:ProfessionalSuitabilitySummary)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Service Reserved To Particular Profession</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasStrategicProcurementDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasStrategicProcurementDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Self-explanatory text about a concept. (epo:StrategicProcurement)</skos:definition>
        <skos:prefLabel xml:lang="en">has Strategic Procurement Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSubcontractingInvolved -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractingInvolved">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">List of Subcontractors and the subject matter they cover are required. Additional Information: The tenderer will ned to supply this information in the tender. (epo:SubcontractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/02/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Subcontracting Involved</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSubcontractorsProposedAboveObligation -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractorsProposedAboveObligation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The maximum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Subcontractors Proposed Above Obligation</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSubjectMatter -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubjectMatter">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Description of the share of the contract that is to be subcontracted. Additional infromation: This can be an aggregate of several subcontracts. (epo:SubcontractingEstimate)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Subject Matter</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSubmissionURL -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubmissionURL">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:editorialNote xml:lang="en">Used by eForms BT-18, eForms BT-509</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Submission URL</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasSuccessiveReduction -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSuccessiveReduction">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number of solutions or tenders will be reduced in iterative evaluations for multiple staged procedures. Additional information: This refers to multiple-stage procedures (included two-stage procedures, at least). Open Procedures can be seen as one-stage procedures. (epo:MultipleStageProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Successive Reduction</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasThresholdValue -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasThresholdValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The cut-off level for a given concept. Additional Information: This value is given as e.g. a minimum score, a maximum number of tenders with the highest score passing (see codelist at-voc:number-threshold). (cccev:Constraint)</skos:definition>
        <skos:prefLabel xml:lang="en">has Threshold Value</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasTotalNumberOfComplainants -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalNumberOfComplainants">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number of economic operators that requested the buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC. (epo:ReviewRequestSummary)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-712</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 11/04/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Total Number Of Complainants</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasTotalVehicles -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalVehicles">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number of all vehicles (regardless of whether clean or not) that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Total Vehicles</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasURL -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasURL">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (cccev:Evidence) The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (epo:Fund)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 30/09/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has URL</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasUnitDescription -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnitDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A narrative explanation defining the units of items being counted Additional information: This could be for example individual items or pack or two. (epo:Quantity)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Unit Description</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasUnverifiedTenders -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnverifiedTenders">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Offers received for which it has not been verified if they are admissible or inadmissible (e.g. because award criteria have been evaluated for all tenders and admissibility is checked only for the winning tender). (epo:SubmissionStatisticalInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Unverified Tenders</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasVersion -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasVersion">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A number that identifies a specific state of a document. (epo:Document)</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 18/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Version</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasWithdrawalDate -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasWithdrawalDate">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The date and time when the request for review was withdrawn. (epo:ReviewDecision)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-797</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Withdrawal Date</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasWithdrawalReason -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasWithdrawalReason">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The explanation for withdrawing the request for review. (epo:ReviewDecision)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-798</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Withdrawal Reason</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasZeroEmissionVehicles -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasZeroEmissionVehicles">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The number of all zero-emission heavy-duty vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Zero Emission Vehicles</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#indicatesPerformingStaffInformationRequirement -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#indicatesPerformingStaffInformationRequirement">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Obligation to indicate the names and professional qualifications of the staff assigned to performing the contract. (epo:ProcurementCriteriaSummary)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">indicates Performing Staff Information Requirement</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isAccelerated -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isAccelerated">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Statement about the fact that the procedure will be reduced due to a state of urgency. Additional Information This modifies the time limit for the receipt of requests to participate or the receipt of tenders. (epo:Procedure)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 20/08/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Accelerated</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isAdvancedElectronicSignatureRequired -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isAdvancedElectronicSignatureRequired">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Advanced or qualified electronic signature or seal (as defined in Regulation (EU) No 910/2014) is required. The submitted information is required to be signed electronically. Additional Information: Signature can be defined as &quot;data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. For more details on the meaning and uses of electronic signature you may consult different authoritative sources, a relevant one being for instance the Regulation (EU) 910/2014 on electronic identification and trust services for electronic transactions in the internal market. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Advanced Electronic Signature Required</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isAwardedByCPB -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isAwardedByCPB">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Procedure is awarded by a Central Purchasing Body. (epo:ProcedureTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">is Awarded By CPB</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isCompetitionTerminated -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isCompetitionTerminated">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">No further contracts will be awarded in this procedure. Additional Information: This can be instantiated in the post award phase. PIN for Competition needs to be signaled. This field can be used even if no contracts are awarded in the contract award notice. (epo:ProcurementProcessInformation)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-756</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is Competition Terminated</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isContractingEntity -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isContractingEntity">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of entities, which: (a) are contracting authorities or public undertakings and which pursue one of the activities referred to in Articles 8 to 14 of the Directive 2014/25/EU. (b) when they are not contracting authorities or public undertakings, have as one of their activities any of the activities referred to in Articles 8 to 14, or any combination thereof and operate on the basis of special or exclusive rights granted by a competent authority of a Member State. Additional Information: The indicator is needed in order to discriminate between those contracts where the Contracting Entity acts as a Contracting Authority undergoing the limits and the rules of Directive 24 and those where it acts as a Contracting Entity, with certain relaxed constraints. For example, the Contracting Entities have different thresholds for the application of Directive 24 if compared with Contracting Authorities. (epo:Buyer)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Contracting Entity</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isCoveredByGPA -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isCoveredByGPA">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Specifies whether the Agreement on Government Procurement (GPA) applies. Additional information: The GPA aims to establish a multilateral framework of balanced rights and obligations relating to public contracts with a view to achieving the liberalization and expansion of world trade. (epo:ProcurementElement)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-115</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 15/10/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Covered By GPA</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isDPSTerminated -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isDPSTerminated">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">End of the Dynamic Purchase System (DPS). Additional Information: This property can be used in the contract award notice even if no contracts are awarded. (epo:ProcurementProcessInformation)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 22/11/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">is DPS Terminated</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isDesignContest -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isDesignContest">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A competition which enables the buyer to acquire a plan or design via a jury. Additional information: Design contests have traditionally mostly been used in the fields of town and country planning, architecture and engineering or data processing, other purposes, such as to obtain plans for financial engineering The contest may include or not the award of prizes; (epo:Procedure)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 04/02/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Design Contest</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isGuaranteeRequired -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isGuaranteeRequired">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The submitted information must include a financial commitment to be used in case of default. Additional Information: See the additional information provided in the definition of the &apos;Guarantee Description&apos; element. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Guarantee Required</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isJointProcurement -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isJointProcurement">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Multiple buyers procure together within the same procedure. Addition Information: In case the joint procurement involves buyers from different countries, the national law is specified by the epo:hasCrossBorderLaw in the ProcedureTerm . (epo:Procedure)</skos:definition>
        <skos:prefLabel xml:lang="en">is Joint Procurement</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isJuryDecisionBinding -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isJuryDecisionBinding">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Indicates whether the procuring entity is bound to apply the decision of the jury. (epo:DesignContestRegimeTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">is Jury Decision Binding</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isListedCompany -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isListedCompany">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Public companies listed on a stock exchange and subject to disclosure requirements (either by stock exchange rules or through law or enforceable means), which impose requirements to ensure adequate transparency of beneficial ownership. &lt;u&gt;Additional Information:&lt;/u&gt; In eForms this indicator is used when the nationality of beneficial owner is not provided because the Economic Operator is registered in a regulated market that is subject to disclosure requirements consistent with Union law or subject to equivalent international standards which ensure adequate transparency of ownership information. (epo:Business)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 21/11/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Listed Company</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isMultipleTenderSubmissionAllowed -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isMultipleTenderSubmissionAllowed">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Tenderers may submit more than one competing tenders. (epo:SubmissionTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 10/10/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Multiple Tender Submission Allowed</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isNonDisclosureAgreementRequired -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isNonDisclosureAgreementRequired">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A non-disclosure agreement is needed. Additional information: A non-disclosure agreement is a Contract between different parties which ensures information is not shared with other parties. (epo:NonDisclosureAgreementTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Non Disclosure Agreement Required</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isOneLotOnlyAllowed -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isOneLotOnlyAllowed">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Indicates whether tenders may be submitted for only one Lot. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 23/08/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">is One Lot Only Allowed</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isProcurementDocumentChanged -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isProcurementDocumentChanged">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">One or more procurement documents have been changed. (epo:ChangeInformation)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-718</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 05/11/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Procurement Document Changed</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isProcurementDocumentRestricted -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isProcurementDocumentRestricted">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The access to certain procurement documents is restricted. (epo:AccessTerm)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-14</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 10/10/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Procurement Document Restricted</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isRecurrent -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isRecurrent">
        <dct:references xml:lang="en">&lt;a href=&quot;https://example.com/link1&quot;&gt;Link 1&lt;/a&gt;, &lt;a href=&quot;https://example.com/link2&quot;&gt;Link 2&lt;/a&gt;</dct:references>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The Procurement being notified is likely to be included in another procedure in the foreseeable future. Additional Information: For example, a regularly re-tendered municipal service. This does not include awarding multiple contracts within a single qualification system, framework agreement, or a dynamic purchasing system. (epo:ProcurementObject)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-94</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 12/05/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Recurrent</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isRenewalIndicator -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isRenewalIndicator">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Indicates whether the contract is subject to a renewal clause. (epo:ContractTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Renewal Indicator</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isSMESuitable -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSMESuitable">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The procurement is suitable for small and medium enterprises (SMEs). (epo:LotGroup) The procurement is suitable for small and medium enterprises (SMEs). (epo:ProcurementElement)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 15/10/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">is SME Suitable</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isSecurityClearanceRequired -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSecurityClearanceRequired">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Security Clearance is needed. (epo:SecurityClearanceTerm)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Security Clearance Required</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isSubcontractingPercentageKnown -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubcontractingPercentageKnown">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">is Subcontracting Percentage Known</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isSubcontractingValueKnown -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubcontractingValueKnown">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">is Subcontracting Value Known</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isSubmissionForAllLotsRequired -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubmissionForAllLotsRequired">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Indicates whether tenders must be submitted for all Lots. (epo:ProcedureTerm)</skos:definition>
        <skos:prefLabel xml:lang="en">is Submission For All Lots Required</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isToBeRelaunched -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isToBeRelaunched">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Indicator of whether the procurement object is to be relaunched. Additional information: This can be instantiated in the post award phase. (epo:ProcurementProcessInformation)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-634</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 18/01/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">is To Be Relaunched</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isUsedForCandidateRestriction -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isUsedForCandidateRestriction">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The criterion will be used to select the candidates to be invited for the second stage of a multistage procedure. Additional Information: This property is only used if a maximum number of candidates was foreseen in the procedure. (epo:SelectionCriterion)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-40</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is Used For Candidate Restriction</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isUsingEUFunds -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isUsingEUFunds">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The procurement foresees funding by the Union. Additional Information: The funding may cover the whole procurement or part of the procurement. For example the European Structural and Investment Funds or grants awarded by the European Union. (epo:ProcurementObject)</skos:definition>
        <skos:prefLabel xml:lang="en">is Using EU Funds</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isVariant -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isVariant">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Alternative solution to fulfil the buyer&apos;s needs as opposed to solutions indicated in the procurement documents. Additional Information: The permission to offer variants is only allowed if specified in a Contract Notice or a Prior Information Notice that used as a means for calling for a competition. The buyer lays out minimum requirements in the procurement documents that must be respected by tenderers submitting variants. (epo:Tender)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 29/05/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">is Variant</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#isWithdrawn -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isWithdrawn">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The review request was withdrawn. (epo:ReviewDecision)</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-796</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is Withdrawn</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#usesCleanVehicleDirective -->

    <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#usesCleanVehicleDirective">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The procurement falls within the scope of the European Parliament and Council 2009/33/EC (Clean Vehicles Directive ï¿½ CVD). (epo:GreenProcurement)</skos:definition>
        <skos:prefLabel xml:lang="en">uses Clean Vehicle Directive</skos:prefLabel>
    </owl:DatatypeProperty>
    


