    <!-- http://data.europa.eu/a4g/ontology#hasESubmissionPermission -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasESubmissionPermission">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The requirements as to what extent electronic submission is allowed.</skos:definition>
        <skos:prefLabel xml:lang="en">has E Submission Permission</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasElectronicDigest -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicDigest">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Electronic Digest</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasElectronicSignature -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicSignature">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Electronic Signature</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEndpointIdentifier -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEndpointIdentifier">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Endpoint Identifier</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEnergyEfficiencyLabel -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEnergyEfficiencyLabel">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Energy Efficiency Label</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedBuyerConcessionRevenue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedBuyerConcessionRevenue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The expected payments made by the buyer to the economic operator awarded the concession that are not directly related to the use of the concession. &lt;u&gt;Additional Information:&lt;/u&gt; For example the public buyer pays a yearly fee to provide a ticketing solution to the public. The fee the public pays for every ticket sold through the solution is not included in this estimation but in the estimation of the user concession revenue.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-160</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 07/01/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Estimated Buyer Concession Revenue</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedDeliveryPeriod -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedDeliveryPeriod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The forecasted time period given by the Despatcher to provide the goods and services.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Estimated Delivery Period</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedDuration -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedDuration">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Relation indicating a Dynamic Purchase System has an estimated Duration.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/11/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Estimated Duration</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedUserConcessionRevenue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedUserConcessionRevenue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The estimated revenue coming from the use of the concession. Additional Information: Revenues are for example fees and fines. For example, the fees and fines coming from the cars using a motorway.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-162</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Estimated User Concession Revenue</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedValidityPeriod -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedValidityPeriod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Estimated Validity Period</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasEstimatedValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A forecast of the value of the procurement before competition. Additional Information: Different cases of estimated values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. The forecast is calculated by the buyer and covers all revenues whether coming from the buyer or third parties. See for example recital (19), Article 5 of Directive 2014/24/EU and other articles from the rest of Directives about procurement. In the case of framework agreements and dynamic purchasing systems this refers to the maximum estimated value.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-27, can be used for BT-157</skos:editorialNote>
        <skos:editorialNote xml:lang="en">Used by eForms BT-27,eForms BT-157</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 05/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Estimated Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasExclusionGroundType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasExclusionGroundType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Exclusion Ground Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasExpectedDeliveryTime -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasExpectedDeliveryTime">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The expected amount of time between the order and delivery of an item.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Expected Delivery Time</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFinancialOfferValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFinancialOfferValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The value offered by the Tenderer for a Lot. Additional Information: This value is normally the one awarded for a winning Tender Lot. In case of negotiated procedures the original financial value may be reviewed and the offer updated.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-720</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Financial Offer Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFixedValueType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFixedValueType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The method to interpret the fixed value as pertaining to a total or unit.</skos:definition>
        <skos:prefLabel xml:lang="en">has Fixed Value Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFormType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFormType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A categorisation of the steps in which the Notice is used.</skos:definition>
        <skos:prefLabel xml:lang="en">has Form Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFrameworkAgreementMaximumValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFrameworkAgreementMaximumValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Framework Agreement Maximum Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFrameworkAgreementType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFrameworkAgreementType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The form of framework agreement used in a procurement procedure. Addition information: A concept to distinguish the different types of framework agreement, which are: 1. Framework agreement without reopening of competition, 2. Framework agreement with reopening of competition, or 3. Framework agreement partly without reopening of competition.</skos:definition>
        <skos:prefLabel xml:lang="en">has Framework Agreement Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasFundProgramme -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFundProgramme">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Fund Programme</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasGrossMonetaryValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGrossMonetaryValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Gross Monetary Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasGrossVolume -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGrossVolume">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The amount of space that is required including the packaging.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Gross Volume</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasGrossWeight -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGrossWeight">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The total mass of goods including the packaging.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Gross Weight</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasGroupFrameworkAgreementMaximumValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGroupFrameworkAgreementMaximumValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:editorialNote xml:lang="en">Used by eForms BT-156</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Group Framework Agreement Maximum Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasHazardousClassID -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasHazardousClassID">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Specification of the hazardous nature of an item according to a classification schema. Provides detail of the classification and nature of a hazardous item.</skos:definition>
        <skos:prefLabel xml:lang="en">has Hazardous Class ID</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasHeight -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasHeight">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The vertical measurement.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Height</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasHighestReceivedTenderValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasHighestReceivedTenderValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Amount of the Tender with the highest value. Additional Information The value must correspond to an admissible tender. For example, tenders compliant with the procurement document requirements, not having an abnormally low price or cost, etc.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Highest Received Tender Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasInternalIdentifier -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInternalIdentifier">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:editorialNote xml:lang="en">Used by eForms BT-22</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has Internal Identifier</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasInternationalProcurementInstrumentExceptionInformation -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInternationalProcurementInstrumentExceptionInformation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has International Procurement Instrument Exception Information</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasInvoiceLineObjectIdentifier -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInvoiceLineObjectIdentifier">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">An identifier for an object on which the invoice line is based, given by the Seller. Additional Information: It may be a subscription number, telephone number, meter point etc., as applicable.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/06/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Invoice Line Object Identifier</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasInvoiceLinePeriod -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInvoiceLinePeriod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Invoice Line Period</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasInvoicedObjectIdentifier -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInvoicedObjectIdentifier">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">An identifier for an object on which the invoice is based, given by the Seller.</skos:definition>
        <skos:prefLabel xml:lang="en">has Invoiced Object Identifier</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasInvoicingPeriod -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInvoicingPeriod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Invoicing Period</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasIrregularityType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasIrregularityType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Irregularity Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasItemClassificationIdentifier -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemClassificationIdentifier">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Item Classification Identifier</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasItemConsumption -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemConsumption">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Item Consumption</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasItemConsumptionSavings -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemConsumptionSavings">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Item Consumption Savings</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasItemCountryOfOrigin -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemCountryOfOrigin">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The source country of the product or service. Additional Information: The country of origin can be provided by the buyer as a requirement or by the tenderer information of the item to be provided. The codelist to be used is at-voc:country which is available at http://publications.europa.eu/resource/dataset/country</skos:definition>
        <skos:prefLabel xml:lang="en">has Item Country Of Origin</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasItemStandardID -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemStandardID">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The general identifier assigned to the concept based on a standard scheme.​ Additional information: For example the GTIN scheme (Global Trade Item Number).</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Item Standard ID</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasJuryMember -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasJuryMember">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">An agent involved in an evaluation board.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 14/09/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Jury Member</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLabelType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLabelType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The label type such environmental, quality, social etc.</skos:definition>
        <skos:prefLabel xml:lang="en">has Label Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLanguage -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLanguage">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Language in which the submitted information is to be expressed.</skos:definition>
        <skos:prefLabel xml:lang="en">has Language</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLateSubmissionPermission -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLateSubmissionPermission">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Whether economic operator-related information can be supplemented even after the submission deadline. Additional Information This is specific to the information on the economic operator and not the actual offer. This does not apply to the requests for clarification.</skos:definition>
        <skos:prefLabel xml:lang="en">has Late Submission Permission</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLaunchFrameworkAgreementMaximumValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLaunchFrameworkAgreementMaximumValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Launch Framework Agreement Maximum Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLegalBasis -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalBasis">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The legal basis under which the procurement procedure takes place. Additional Information: For example European Directives or Regulations, national laws etc. The recommended code list is the example for the legal basis at the European level.</skos:definition>
        <skos:prefLabel xml:lang="en">has Legal Basis</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLegalIdentifier -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalIdentifier">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Legal Identifier</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLength -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLength">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The horizontal measurement. Additional Information: The length is the longer side between the length and the width.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Length</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLoadingMeter -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLoadingMeter">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The area of the Consignment in meters divided by the width of the truck, which is considered to be 2.4 meters.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Loading Meter</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLotReference -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLotReference">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Lot Reference</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasLowestReceivedTenderValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLowestReceivedTenderValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Amount of the Tender with the lowest value. Additional Information The value must correspond to an admissible tender. For example, tenders compliant with the procurement document requirements, not having an abnormally low price or cost, etc.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Lowest Received Tender Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMainActivity -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMainActivity">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The principal sectoral area in which an organisation operates. Additional information: The activities associated with buyers are derived from the top level of the Classification of the functions of the government (COFOG) from the United Nations Statistics Division. The activities associated with buyer are derived from sectors explicitly falling within the sectoral directive (2014/25/EU Art. 8 - Art. 14).</skos:definition>
        <skos:prefLabel xml:lang="en">has Main Activity</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasMainClassification -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMainClassification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Main Classification</skos:prefLabel>
    </owl:ObjectProperty>
    


