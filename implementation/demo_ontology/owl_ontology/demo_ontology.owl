        <skos:prefLabel xml:lang="en">has Delivery Period</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasDespatchPeriod -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchPeriod">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
