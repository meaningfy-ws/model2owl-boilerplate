        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Is related to a Document.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 06/10/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Associated Document</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardCriterionType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriterionType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Category of award criterion.</skos:definition>
        <skos:prefLabel xml:lang="en">has Award Criterion Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardStatus -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardStatus">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Indicates whether the lot is awarded, not awarded or still open.</skos:definition>
        <skos:prefLabel xml:lang="en">has Award Status</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasAwardedValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardedValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The value of the procurement provided by the Award Decision. Additional Information: Different cases of awarded values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. In the case of framework agreements and dynamic purchasing systems this refers to the maximum awarded value.</skos:definition>
        <skos:editorialNote xml:lang="en">Used in F18 and other standard forms.</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 10/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Awarded Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBackorderQuantity -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBackorderQuantity">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Backorder Quantity</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBalanceAmount -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBalanceAmount">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Balance Amount</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBankingIdentifier -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBankingIdentifier">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">An unique banking reference identifier of the Payee or Seller, assigned by the Payee or Seller bank.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Banking Identifier</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBargainPrice -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBargainPrice">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The value of procured supplies that have used a particularly advantageous opportunity available for a very short time at a value considerably lower than normal market prices.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 23/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Bargain Price</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBaseQuantity -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBaseQuantity">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The quantity at which the net monetary value applies.</skos:definition>
        <skos:prefLabel xml:lang="en">has Base Quantity</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBatchID -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBatchID">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The identifier assigned to a specific batch of the produced Item.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Batch ID</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBeneficialOwner -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBeneficialOwner">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it&apos;s beyond the scope for public eProcurement domain.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 14/09/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Beneficial Owner</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBroadPlaceOfPerformance -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBroadPlaceOfPerformance">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Geopolitical zone where the contract can be executed. Additional Information Used for setting restrictions that cannot be established with one country code or a geographical zone identifier (like NUTS), because they have a broader scope (geographical, economic, political, other).</skos:definition>
        <skos:prefLabel xml:lang="en">has Broad Place Of Performance</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBusinessSize -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBusinessSize">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The category of the business depending on number of employees and turnover. Additional information: See Commission Recommendation of 6 May 2003 concerning the definition of micro, small and medium-sized enterprises.</skos:definition>
        <skos:prefLabel xml:lang="en">has Business Size</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBuyerItemID -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerItemID">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The general identifier assigned to the concept as defined by the Buyer.​</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Buyer Item ID</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasBuyerLegalType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerLegalType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A category that indicates the right of an Organisation to play the role of a buyer. Additional Information: The category also effects the rules that the buyer has to abide to within the public procurement procedure.</skos:definition>
        <skos:prefLabel xml:lang="en">has Buyer Legal Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCalculationBasedOn -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCalculationBasedOn">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Calculation Based On</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCatalogueLineValidity -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCatalogueLineValidity">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The relation indicating until when a Catalogue Line instance is applicable.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 21/09/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Catalogue Line Validity</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasCertification -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCertification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Relation to the proof of conformance.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 30/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Certification</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasChangeJustification -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasChangeJustification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Code explaining the change.</skos:definition>
        <skos:prefLabel xml:lang="en">has Change Justification</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasConcessionEstimatedValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConcessionEstimatedValue">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Concession Estimated Value</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasConfirmedIrregularityType -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConfirmedIrregularityType">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">has Confirmed Irregularity Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasConsigneeConsignmentID -->

