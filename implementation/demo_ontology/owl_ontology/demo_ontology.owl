        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://xmlns.com/foaf/spec/#term_Person&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://xmlns.com/foaf/spec/#term_Person&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
