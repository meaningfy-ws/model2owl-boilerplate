        <skos:prefLabel xml:lang="en">schema Agency</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/locn#addressArea -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/locn#addressArea">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.addressarea&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.addressarea&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (locn:Address)</skos:definition>
        <skos:prefLabel xml:lang="en">address Area</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/locn#fullAddress -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/locn#fullAddress">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.fulladdress&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.fulladdress&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (locn:Address)</skos:definition>
        <skos:prefLabel xml:lang="en">full Address</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/locn#geographicName -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/locn#geographicName">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Location.geographicname&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Location.geographicname&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (dct:Location)</skos:definition>
        <skos:prefLabel xml:lang="en">geographic Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/locn#locatorDesignator -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/locn#locatorDesignator">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.haslocatordesignator&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.haslocatordesignator&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (locn:Address)</skos:definition>
        <skos:prefLabel xml:lang="en">locator Designator</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/locn#locatorName -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/locn#locatorName">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.locatorname&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.locatorname&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (locn:Address)</skos:definition>
        <skos:prefLabel xml:lang="en">locator Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/locn#postCode -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/locn#postCode">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.postcode&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.postcode&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (locn:Address)</skos:definition>
        <skos:prefLabel xml:lang="en">post Code</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/locn#postName -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/locn#postName">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.postname&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.postname&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (locn:Address)</skos:definition>
        <skos:prefLabel xml:lang="en">post Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/locn#thoroughfare -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/locn#thoroughfare">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.thoroughfare&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address.thoroughfare&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (locn:Address)</skos:definition>
        <skos:prefLabel xml:lang="en">thoroughfare</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/person#birthName -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/person#birthName">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Person-Vocabulary/releases/2.1.1/#Person.birthname&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Person-Vocabulary/releases/2.1.1/#Person.birthname&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (person:Person)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">birth Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/person#patronymicName -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/person#patronymicName">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;https://semiceu.github.io/Core-Person-Vocabulary/releases/2.1.1/#Person.patronymicname&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/Core-Person-Vocabulary/releases/2.1.1/#Person.patronymicname&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (person:Person)</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">patronymic Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/familyName -->

    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/familyName">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://xmlns.com/foaf/spec/#term_familyName&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://xmlns.com/foaf/spec/#term_familyName&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (person:Person)</skos:definition>
        <skos:prefLabel xml:lang="en">family Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/givenName -->

    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/givenName">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://xmlns.com/foaf/spec/#term_givenName&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://xmlns.com/foaf/spec/#term_givenName&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (person:Person)</skos:definition>
        <skos:prefLabel xml:lang="en">given Name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/name -->

    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/name">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://xmlns.com/foaf/spec/#term_name&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://xmlns.com/foaf/spec/#term_name&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (person:Person)</skos:definition>
        <skos:prefLabel xml:lang="en">name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://data.europa.eu/a4g/ontology#AccessTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AccessTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations about where and how to access the Procurement Documents.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 09/03/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Access Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AcquiringCentralPurchasingBody -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AcquiringCentralPurchasingBody">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#CentralPurchasingBody"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of an Agent procuring activities conducted on a permanent basis in the form of the acquisition of supplies and/or services intended for other Buyers. Additional Information: In Public Procurement the Role of Acquiring Central Purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Acquiring Central Purchasing Body</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AcquiringParty -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AcquiringParty">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AgentInRole"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The Role of an Agent that acts on the buying side of a Procurement Process.</skos:definition>
        <skos:prefLabel xml:lang="en">Acquiring Party</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AdHocChannel -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AdHocChannel">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Channel"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Web page where tools and devices for electronic communication that are not generally available can be downloaded free of charge.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-724</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 10/01/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Ad Hoc Channel</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AgentInRole -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AgentInRole">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Relative concept that ties an Agent to a part they play in a given Situational Context. Additional information: The classification of roles is based is based on the degree of involvement into the Procurement Process: - Primary (Procurement) Pole is directly involved in the Procurement Process; - Secondary (Procurement sub-) Role is secondary to the Procurement Process - Tertiary (Related) Role is not involved in the Procurement Process.</skos:definition>
        <skos:prefLabel xml:lang="en">Agent In Role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AuxiliaryParty -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AuxiliaryParty">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AgentInRole"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of an Agent who may be mentioned in the information exchanged during the Procurement Process but who does not play an active part in it.</skos:definition>
        <skos:prefLabel xml:lang="en">Auxiliary Party</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AwardCriteriaSummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardCriteriaSummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the Award Criteria.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Award Criteria Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AwardCriterion -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardCriterion">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriterion"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Criterion that describes a Requirement that the Tender needs to resolve and on which the Tender is evaluated and ranked.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 05/11/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Award Criterion</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AwardDecision -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardDecision">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Resolution of the Buyer as to the result of the Procurement Procedure.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 14/11/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Award Decision</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AwardEvaluationTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardEvaluationTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#EvaluationTerm"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the evaluation of Award Criteria.</skos:definition>
        <skos:prefLabel xml:lang="en">Award Evaluation Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AwardOutcome -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardOutcome">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextualProjection"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Result concerning the competition that was attributed by the Awarder.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Award Outcome</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Awarder -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Awarder">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent that signs the Award Decision. Additional information: BT-08 can be Awarding CBP; BG-03 is the Buyer. But Awarding CPB is not the same as the Buyer; the organisations may differ for these roles. Having the Awarder Role allows us to specify which Organisation is involved in the Award Decision.</skos:definition>
        <skos:prefLabel xml:lang="en">Awarder</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#AwardingCentralPurchasingBody -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardingCentralPurchasingBody">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#CentralPurchasingBody"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of an Agent procuring activities conducted on a permanent basis in the form of the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for other Buyers. Additional Information: In Public Procurement the Role of Awarding Central purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Awarding Central Purchasing Body</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#BudgetProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#BudgetProvider">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A role of an agent whose Budget is used to pay for the Contract.</skos:definition>
        <skos:prefLabel xml:lang="en">Budget Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Business -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Business">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A private law company registered in a national registry.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">Business</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Buyer -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Buyer">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent that awards a Contract and/or purchases items. Additional information: In Public Procurement the Role of Buyer is carried out by the following types of Organisation: Contracting Authority, Contracting Entity, a defense Contractor, an international Organisation, or an organisation awarding a Contract subsidized by a Contracting Authority. In Pre-Award, the Buyer generally awards the Contract, however future purchasers may be foreseen. In Post-Award the buyer generally refers to the purchaser of items.</skos:definition>
        <skos:prefLabel xml:lang="en">Buyer</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Candidate -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Candidate">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The Role of an Agent that has sought an invitation or has been invited to take part in a restricted Procedure, in a competitive Procedure with negotiation, in a negotiated Procedure without prior publication, in a competitive dialogue or in an innovation partnership.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Candidate</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#CatalogueProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CatalogueProvider">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent compiling and supplying a Catalogue. Additional Information: The Catalogue Provider Role is usually played by the Agent that acts as a Seller, or by another Agent that acts on behalf of the Seller.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/01/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Catalogue Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#CatalogueReceiver -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CatalogueReceiver">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent processing a Catalogue. Additional Information: The Catalogue Receiver may not only receive it but also validate it, process it, etc. The Catalogue Receiver role is usually played by the agent that acts as a Buyer, or by another Agent that acts on behalf of the Buyer.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/01/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Catalogue Receiver</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#CentralPurchasingBody -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CentralPurchasingBody">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Buyer"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of an Agent that provides centralised purchasing activities and, possibly, ancillary purchasing activities for other Buyers. Additional Information: In Public Procurement the Role of Central Purchasing Body is carried out by a Contracting Authority for other Contracting Authorities. Contracting Authority procuring activities conducted on a permanent basis, in one of the following forms:[...](b) the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for Contracting Authorities;</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Central Purchasing Body</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Certificate -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Certificate">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Evidence"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Proof of conformance of the instance of the concept to a defined set of criteria. Additional Information: Certificates provide assurance of credibility, trust, and transparency in the procurement process.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 16/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Certificate</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#CertificationLabel -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CertificationLabel">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/InformationConcept"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Concept that stands for a set of norms, expectations, standards and policies. Additional Information: Such standards may relate to social, ethical and quality etc.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 26/07/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">Certification Label</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Certifier -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Certifier">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The role of an agent who issues a certificate. Additional Information: The certifier is responsible for verifying and confirming the conformance of the instance of the concept to a defined set of criteria.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 16/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Certifier</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ChangeInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ChangeInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Alteration to previously provided details.</skos:definition>
        <skos:editorialNote xml:lang="en">Added hasAdditionalInformation to cover for section VII.2 in F14, since we do not have the Corrigendum notice type anymore in eForms.</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Change Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#CleanVehicleDirectiveInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CleanVehicleDirectiveInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information related to clean vehicles legislation. Additional information: In the European Union, the legislation concerned is the European Parliament and Council 2009/33/EC (Clean Vehicles Directive ï¿½ CVD).</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 07/05/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Clean Vehicle Directive Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ConcessionContract -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ConcessionContract">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Contract between one or more Buyers and one or more Economic Operators giving the right to the Economic Operators to exploit the rights foreseen in the Contract which may include the receipt of Payments.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 24/05/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">Concession Contract</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ConcessionEstimate -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ConcessionEstimate">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Estimate"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Approximation concerning the foreseen Concession Contract.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Concession Estimate</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ContextDescription -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ContextDescription">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A description concerning a Procurement Object or a Notice in a specific Situation Context. Additional Information: The description has its own identity (+I) but is dependent (+D) on the concerned Entity. We say that ContextDescription *concerns* an Entity.</skos:definition>
        <skos:prefLabel xml:lang="en">Context Description</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ContextualProjection -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ContextualProjection">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Projection of an Entity and all of its properties that hold in a given Situation Context. Additional Information: The contextual projection does not have its own identity (-I), is dependent (+D) on the described Entity, and is anti-rigid (~R) We say that ContextualProjection *describes* an Entity. Adaptation of ContextSlices pattern encoding a 4D view. http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices</skos:definition>
        <skos:prefLabel xml:lang="en">Contextual Projection</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Contract -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Contract">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A voluntary, deliberate, and legally binding agreement between two or more competent parties.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Contract</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ContractLotCompletionInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ContractLotCompletionInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information related to a given Lot at the end of the procurement.</skos:definition>
        <skos:prefLabel xml:lang="en">Contract Lot Completion Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ContractTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ContractTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the Post Award Phase.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Contract Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Contractor -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Contractor">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The Role of an Agent that has signed a Contract with a Buyer.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 08/11/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">Contractor</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#DesignContestRegimeTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#DesignContestRegimeTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of a Design Contest.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 04/02/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Design Contest Regime Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#DirectAwardTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#DirectAwardTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the award of a Contract without prior publication. Addtional Information: Direct award may refer to a previous Procedure and/or specific Lot(s). It may also refer to other justified situations whereby there is no previous Procedure. See Directive 2014/24/EU Article 32.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 22/11/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Direct Award Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#DirectContract -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#DirectContract">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Contract resulting from Lot Award Outcome. Additional information: A Framework Agreement is not a Direct Contract.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Direct Contract</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Document -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Document">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A set of interrelated Business Information representing the Business facts and associated metadata. The information may be conveyed in any language, medium or form, including textual, numerical, graphic, cartographic, audio-visual forms, etc.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 23/05/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Document</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Documentation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Documentation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Documentation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#DynamicPurchaseSystemTechnique -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#DynamicPurchaseSystemTechnique">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Technique"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Technique that allows the selection of Candidates throughout the Procedure via the Qualification Criteria, followed by individual Mini-Competitions for the Award of Purchase Contracts.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 23/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Dynamic Purchase System Technique</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#EAuctionTechnique -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EAuctionTechnique">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Technique"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A repetitive Technique in which new Prices, revised downwards, and/or new values concerning certain elements of Tenders are bid on-line.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-767</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG approval 20/07/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">E Auction Technique</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#EconomicStandingSummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EconomicStandingSummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the financial viability of the economic operator.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Economic Standing Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ElectronicSignature -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ElectronicSignature">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. Additional information: The definition comes from REGULATION (EU) No 910/2014.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Electronic Signature</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#EmploymentDocumentation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EmploymentDocumentation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Documentation"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Employment Documentation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#EmploymentInformationProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EmploymentInformationProvider">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for providing information concerning the general regulatory framework for employment protection and working conditions.</skos:definition>
        <skos:prefLabel xml:lang="en">Employment Information Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#EnergyEfficiencyInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EnergyEfficiencyInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Energy Efficiency Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#EnvironmentalDocumentation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EnvironmentalDocumentation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Documentation"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Environmental Documentation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#EnvironmentalProtectionInformationProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EnvironmentalProtectionInformationProvider">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for providing information concerning the general regulatory framework for Environmental Protection.</skos:definition>
        <skos:prefLabel xml:lang="en">Environmental Protection Information Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Estimate -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Estimate">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">An approximate calculation or a judgement of the value, number, Quantity or extent of something.</skos:definition>
        <skos:prefLabel xml:lang="en">Estimate</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#EvaluationTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EvaluationTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the Tender evaluation.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Evaluation Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ExclusionGround -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ExclusionGround">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriterion"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Criterion that describes a legal Requirement to be met by the Economic Operator to be a Candidate in the Procurement.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BG-701</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 31/10/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Exclusion Ground</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ExclusionGroundsSummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ExclusionGroundsSummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the Exclusion Grounds.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Exclusion Grounds Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ExpressionOfInterest -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ExpressionOfInterest">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Document presenting an Economic Operator&apos;s Request to be considered for Procedures covering a specific domain.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 13/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Expression Of Interest</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#FrameworkAgreement -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#FrameworkAgreement">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">An agreement between one or more Contracting Authorities and one or more Economic Operators. Additional Information: When a Framework Agreement is concerned, the FA will result from LotAwardOutcome which describes a Lot which specifies the both the Qualification and Award Criteria.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 18/05/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Framework Agreement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#FrameworkAgreementTechnique -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#FrameworkAgreementTechnique">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Technique"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Technique that establishes the terms governing Contracts to be awarded during a given Period, in particular with regard to Price and, where appropriate, the Quantity envisaged.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 18/05/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Framework Agreement Technique</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#FrameworkAgreementTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#FrameworkAgreementTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities in a Framework Agreement.</skos:definition>
        <skos:prefLabel xml:lang="en">Framework Agreement Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Fund -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Fund">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A financial resource used to support the Procurement. Additional Information: In the context of EU, Funds can be divided into programmes, actions and projects. Examples of EU funds are: the European Structural and Investment Funds, European Social Fund (ESF), the Connecting Europe Facility (CEF) programme, or the ISA2 programme and its actions (e.g. Action 2016.05 European Public Procurement Initiative, which supports the eProcurement Ontology under sub-action 3). Funds may change between the lot and the contract, for example in the case of an emergency crisis, a contract may be financed by a budget that was not foreseen in the call.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 14/05/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Fund</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#GreenProcurement -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#GreenProcurement">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StrategicProcurement"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Approach whereby Buyers seek to procure with a reduced Environmental Impact. Additional Information: The approach may apply to the complete life cycle. The reduced Environmental Impact is in comparison to goods, services and works with the same primary function that would otherwise be procured. Tightly related are article 68 - Life-cycle costing and article 67 - most economically advantageous Tender (see GPP handbook) https://ec.europa.eu/environment/gpp/pdf/Buying-Green-Handbook-3rd-Edition.pdf An instance of the class GreenProcurement is represented in eForms with the code &quot;env-imp&quot; defined in the codelist Strategic-Procurement.Paragraphs) https://ec.europa.eu/environment/gpp/pdf/Buying-Green-Handbook-3rd-Edition.pdf</skos:definition>
        <skos:prefLabel xml:lang="en">Green Procurement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#InnovativeProcurement -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#InnovativeProcurement">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StrategicProcurement"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Approach whereby Buyers seek to procure an innovative work, supply or service. Additional Information: ï¿½innovationï¿½ means the implementation of a new or significantly improved product, service or process, including but not limited to production, building or construction processes, a new marketing method, or a new organizational method in business practices, workplace Organisation or external relations inter alia with the purpose of helping to solve societal challenges or to support the Europe 2020 strategy for smart, sustainable and inclusive growth; See: Directive 2014/24 Articles: 2, 26 (3), 31, 67 (2.a)</skos:definition>
        <skos:prefLabel xml:lang="en">Innovative Procurement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#InternationalProcurementInstrumentMeasuresInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#InternationalProcurementInstrumentMeasuresInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">International Procurement Instrument Measures Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#JuryMember -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#JuryMember">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of an Agent who evaluates a design contest.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Jury Member</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#LeadBuyer -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#LeadBuyer">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Buyer"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent who is a Buyer and takes the administrative lead of the Procedure.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 22/11/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">Lead Buyer</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#LocalLegalBasisInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#LocalLegalBasisInformation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Local Legal Basis Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Lot -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Lot">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A qualitative, quantitative or strategic subdivision of the goods, services or works to be procured, allowing the award of one or more Contracts.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 12/09/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Lot</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#LotAwardOutcome -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#LotAwardOutcome">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AwardOutcome"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Result concerning the Lot that was attributed by the Awarder.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Lot Award Outcome</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#LotGroup -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#LotGroup">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Combination of several Lots to conduct comparative assessment of the Tenders. Additional Information: The comparative assessment may refer to the Selection Criteria, Award and Value that apply to several Lots. Pending of discussion with eForms Member States may provide that, where more than one lot may be awarded to the same tenderer, contracting authorities may award contracts combining several or all lots where they have specified in the contract notice or in the invitation to confirm interest that they reserve the possibility of doing so and indicate the lots or groups of lots that may be combined.</skos:definition>
        <skos:prefLabel xml:lang="en">Lot Group</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#LotGroupAwardInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#LotGroupAwardInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Award information related to a given Group of Lots.</skos:definition>
        <skos:prefLabel xml:lang="en">Lot Group Award Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#MaskableObject -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#MaskableObject">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:editorialNote xml:lang="en">See &quot;maskable object hierarchy&quot; diagram</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Maskable Object</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Mediator -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Mediator">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent that attempts to resolve a dispute between different Agents and come to an agreement.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 20/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Mediator</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#MiniCompetitionAwardOutcome -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#MiniCompetitionAwardOutcome">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AwardOutcome"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Result concerning the mini-competition that was attributed by the Awarder. Additional Information: The mini-competition is the process where multiple winners or candidates of previous stages of a procedure bid for a specific procurement. It is typically used in framework agreements where the suppliers have already been pre-selected, and the mini competition is used to determine which supplier is best suited for a particular project or contract. It is also used in a Dynamic Purchasing System where the suppliers come from a list of Candidates.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Mini Competition Award Outcome</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#MonetaryValue -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#MonetaryValue">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A number of monetary units specified using a given unit of currency. Additional information: In the pre-award phase of the procurement, all monetary values are considered to exclude VAT based on the Directive 2014/24/EU.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 13/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Monetary Value</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#MultipleStageProcedureTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#MultipleStageProcedureTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of Procedures carried out in several steps Additional Information: Generally this refers to Procedures where selection is carried out to qualify Tenderers who are then requested to submit the rest of their Tender for evaluation is Restricted Procedure.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 15/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Multiple Stage Procedure Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#NonDisclosureAgreementTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#NonDisclosureAgreementTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations about a non-disclosure agreement. Additional information: A non-disclosure agreement is a Contract between different parties which ensures information is not shared with other parties.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Non Disclosure Agreement Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#NonPublishedInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#NonPublishedInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information about fields not published in this Notice. Additional Information: The non-published information may become available at a later date and may differ from one element to another within a given Document. Examples of fields that may not be immediately published are Winner, Tender and Procedure Lot Result, etc., e.g. for security reasons.</skos:definition>
        <skos:prefLabel xml:lang="en">Non Published Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Notice -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Notice">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Document published by the Buyer about market opportunities and results.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 23/05/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Notice</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#NoticeAwardInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#NoticeAwardInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information about an Award Notice.</skos:definition>
        <skos:prefLabel xml:lang="en">Notice Award Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Offer -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Offer">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Document providing the Monetary Value and the details to fulfill the Requirements set out in the Procurement Documents or Request for Offer. Additional information: A quotation is considered to be an Offer in the eProcurement Ontology.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 09/02/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Offer</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#OfferIssuer -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OfferIssuer">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The Role of an Agent that distributes an Offer.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 09/02/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Offer Issuer</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#OfferingParty -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OfferingParty">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AgentInRole"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The Role of an Agent that acts on the Economic Operator side during a Procurement Process. Additional information: As per the European Procurement Directives the notion of ï¿½Economic Operatorsï¿½ should be interpreted in a broad manner so as to include any Persons and/or Entities which offer the execution of works, the supply of products or the provision of services on the market, irrespective of the legal form under which they have chosen to operate. Thus, firms, branches, subsidiaries, partnerships, cooperative societies, limited companies, universities, public or private, and other forms of entities than natural Persons should all fall within the notion of Economic Operator, whether or not they are ï¿½Legal Personsï¿½ in all circumstances.</skos:definition>
        <skos:prefLabel xml:lang="en">Offering Party</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#OfflineAccessProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OfflineAccessProvider">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for providing offline access to the Procurement Documents.</skos:definition>
        <skos:prefLabel xml:lang="en">Offline Access Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#OpeningTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OpeningTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the opening of Tenders. Additional Information: The opening of Tenders is the event when Tenders are made accessible for evaluation, it is generally the same date and time for all Tenders.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 15/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Opening Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#OrganisationGroup -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OrganisationGroup">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Agreed collaboration of several Organisations. Additional Information: This concept has been created to fulfill the need to represent a grouping of Organisations that is not necessarily registered i.e, consortia.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 15/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Organisation Group</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#OriginatorRequest -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OriginatorRequest">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Document in which the Originator describes his needs.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 09/02/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Originator Request</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ParticipationCondition -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationCondition">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriterion"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Criterion that describes a Requirement to take part in a procurement.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Participation Condition</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ParticipationConditionsSummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationConditionsSummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the Participation Conditions.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Participation Conditions Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ParticipationRequestProcessor -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationRequestProcessor">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for processing Requests To Participate.</skos:definition>
        <skos:prefLabel xml:lang="en">Participation Request Processor</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ParticipationRequestReceiver -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationRequestReceiver">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for receiving Requests To Participate.</skos:definition>
        <skos:prefLabel xml:lang="en">Participation Request Receiver</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ParticipationRequestTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationRequestTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of requesting participation in a Procedure.</skos:definition>
        <skos:prefLabel xml:lang="en">Participation Request Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#PaymentExecutor -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PaymentExecutor">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for executing the Payment.</skos:definition>
        <skos:prefLabel xml:lang="en">Payment Executor</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#PlannedProcurement -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PlannedProcurement">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Planned Procurement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#PlannedProcurementPart -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PlannedProcurementPart">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A subdivision of a Planned Procurement that may later become one or more Lots or a self-standing Procedure. A Lot or a Procedure can also cover one or more parts of the Planned Procurement.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 20/06/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Planned Procurement Part</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Prize -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Prize">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A reward given in a Contest.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval: 15/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Prize</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Procedure -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Procedure">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A legally defined set of administrative activities conducted to conclude one or more Contracts. Additional Information The Procedure is categorised in the law according to different rules determining whether the Procedure is Open, Restricted, Negotiated with or without publicity, etc. (see Procedure Type).</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 20/08/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Procedure</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcedureTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcedureTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the Procedure.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Procedure Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcessPlanningTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcessPlanningTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the unfolding of the Procurement Process.</skos:definition>
        <skos:prefLabel xml:lang="en">Process Planning Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the Procurement Criteria.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Procurement Criteria Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcurementCriterion -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementCriterion">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Criterion"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A criterion specific to Procurement. Additional Information: This Procurement Criterion can be only Exclusion Ground, Selection Criterion or Award Criterion. Each of these Criteria can contain subcriteria (Criterion class).</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 23/04/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">Procurement Criterion</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcurementDocument -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementDocument">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Document produced or referred to by the Buyer to describe or determine elements of the Procurement. Additional information: Procurement Documents are to be accessible since the date of publication of the Contract Notice or the prior information Notice when used as a call for competition. Examples of Procurement Documents are Technical Specifications, the Descriptive Document, proposed conditions of Contract, formats for the presentation of Documents by Candidates and Tenderers, information on generally applicable obligations. Other Documents related to the Procedure such as Notices are not considered to be Procurement Documents.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 23/05/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Procurement Document</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcurementElement -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementElement">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Gathering class for critical/central elements in the Procurement Process. TODO: add definition Additional information: Alias: ProcurementComponent</skos:definition>
        <skos:prefLabel xml:lang="en">Procurement Element</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcurementObject -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementObject">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
        <dct:references xml:lang="en">&lt;a href=&quot;https://example.com/link1&quot;&gt;Link&lt;/a&gt;</dct:references>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The whole or a division of goods, services or works to be procured. Additional Information: Anything that can specify the procurement content (i.e. goods, services, work) is a Procurement Object. In a sense, such an &quot;object&quot; can constitute the &quot;object of a Contract&quot;. To test whether something is a Procedure Object check if it can have a Purpose and/or CPV classification (&lt;i&gt;The CPV establishes a single classification system for public procurement aimed at standardising the references used by Contracting Authorities and entities to describe the subject of Procurement Contracts.&lt;/i&gt;). Note: Procedure, seems to be an exception from this rule. Because it is a conflated term: it carries process properties and &quot;purpose&quot; properties.</skos:definition>
        <skos:note xml:lang="en">This class should be used to represent the whole or a part of goods, services, or works intended for procurement. Each instance can be linked to a Purpose or a CPV classification to specify its content, facilitating standardization and clarity in procurement documentation.</skos:note>
        <skos:prefLabel xml:lang="en">Procurement Object</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Procurement object (custom label)</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcurementProcedureInformationProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementProcedureInformationProvider">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for providing additional information about the Procurement Procedure.</skos:definition>
        <skos:prefLabel xml:lang="en">Procurement Procedure Information Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcurementProcessInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementProcessInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information about the temporal unfolding or succession of Procurement Objects.</skos:definition>
        <skos:prefLabel xml:lang="en">Procurement Process Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProcurementServiceProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementServiceProvider">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <dct:source xml:lang="en">Directive 2014/24/EU, Article 2, paragraphs 17 and 15.</dct:source>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of a public or private body which offers ancillary purchasing activities on the market. Additional information: &quot;Ancillary Purchasing Activities&quot; means activities consisting in the provision of support to purchasing activities, in particular in the following forms: (a) technical infrastructure enabling Contracting Authorities to award Public Contracts or to conclude Framework Agreements for works, supplies or services; (b) advice on the conduct or design of public Procurement Procedures; (c) preparation and management of Procurement Procedures on behalf and for the account of the Contracting Authority concerned; This would be equivalent to the concept of &apos;ProcuringEntity&apos; in OCDS: &apos;The Entity managing the Procurement, which may be different from the Buyer who is paying / using the items being procured&apos;.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 24/03/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">Procurement Service Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ProfessionalSuitabilitySummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProfessionalSuitabilitySummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the professional ability required for the economic operator to execute the contract.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Professional Suitability Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Project -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Project">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A collaborative enterprise that is carefully planned to achieve a particular aim.</skos:definition>
        <skos:prefLabel xml:lang="en">Project</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#PurchaseContract -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PurchaseContract">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Contract resulting from using a Dynamic Purchasing System Technique or Framework Agreement Technique.</skos:definition>
        <skos:prefLabel xml:lang="en">Purchase Contract</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Purpose -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Purpose">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">The description of the objectives related to a Procurement. Additional information: The description of the objectives includes the Subject Matter and Quantities. The quantification of the objectives related to a procurement. To be re-reviewed by the WG the soonest. (WG to be discussed, this was pointed out on the 09/04/2019 14:38:25 WG Meeting) The old definition read as follows: The description of the objectives related to a procurement.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 05/12/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Purpose</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the Qualification Criteria.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Qualification Criteria Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#QualificationCriterion -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#QualificationCriterion">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriterion"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Criterion used in the first stage of procurement.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Qualification Criterion</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Quantity -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Quantity">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A counted number of non-monetary units possibly including fractions.</skos:definition>
        <skos:prefLabel xml:lang="en">Quantity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReliedUponEntity -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReliedUponEntity">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Economic Operator (who is not a Subcontractor) on which the Tenderer relies upon, to meet Selection Criteria.</skos:definition>
        <skos:prefLabel xml:lang="en">Relied Upon Entity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReviewDecision -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewDecision">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information about Review Decisions.</skos:definition>
        <skos:prefLabel xml:lang="en">Review Decision</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReviewInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewInformation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Review Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReviewIrregularitySummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewIrregularitySummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StatisticalInformation"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the number and type of requests the Buyer received to review any of its decisions (e.g. the Technical Specifications, Award Decision).</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Review Irregularity Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReviewProcedureInformationProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewProcedureInformationProvider">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent who is providing more information on the time limits for review Procedures.</skos:definition>
        <skos:prefLabel xml:lang="en">Review Procedure Information Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReviewRequest -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewRequest">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information about requests to review procedures.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 23/10/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Review Request</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReviewRequestSummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewRequestSummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StatisticalInformation"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the requests received by the Buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC, and about the complainants that submitted the requests.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Review Request Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReviewRequester -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewRequester">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of an Agent who requests the review of a (Procurement) Procedure.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 23/10/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Review Requester</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#ReviewTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the review.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Review Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Reviewer -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Reviewer">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Role of an Agent who investigates the overall correctness of a Procurement Procedure, producing a related report. Additional Information: Any Organisation or Person may request a review of a Procurement Procedure.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 20/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Reviewer</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SecurityClearanceTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SecurityClearanceTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations about the status requested of individuals allowing them access to classified information (state or organisational secrets) or to restricted areas, after completion of a thorough background check.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BT-578, eForms BT-78, eForms BT-732</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 20/06/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Security Clearance Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SelectedCandidateList -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SelectedCandidateList">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Record of Candidates admitted to take part in award phases of procurements.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Selected Candidate List</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the Selection Criteria.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Selection Criteria Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SelectionCriterion -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SelectionCriterion">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriterion"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Criterion that describes a capacity Requirement that the Economic Operator needs to fulfill to participate in the procurement. Additional Information: Selection criteria may relate to: (a) suitability to pursue the professional activity; (b) economic and financial standing; (c) technical and professional ability</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 31/10/2018</skos:historyNote>
        <skos:prefLabel xml:lang="en">Selection Criterion</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SelectionEvaluationTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SelectionEvaluationTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#EvaluationTerm"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the evaluation of Selection Criteria.</skos:definition>
        <skos:prefLabel xml:lang="en">Selection Evaluation Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SocialProcurement -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SocialProcurement">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StrategicProcurement"/>
        <dct:source xml:lang="en">Buying Social - A Guide to Taking Account of Social Considerations in Public Procurement (Publications Office of the European Union, 2011) https://op.europa.eu/en/publication-detail/-/publication/cb70c481-0e29-4040-9be2-c408cddf081f/language-en
</dct:source>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Approach whereby Buyers seek to procure by fulfilling social objectives. Additional Information: Socially Responsible Public Procurement (SRPP) - ï¿½SRPPï¿½ means Procurement Operations that take into account one or more of the following social considerations: employment opportunities, decent work, compliance with social and labour rights, social inclusion (including persons with disabilities), equal opportunities, accessibility design for all, taking account of sustainability criteria, including ethical trade issues and wider voluntary compliance with corporate social responsibility (CSR), while observing the principles enshrined in the Treaty for the European Union (TFEU) and the Procurement Directives. See Article 18 and Annex X Directive 2014/24.</skos:definition>
        <skos:prefLabel xml:lang="en">Social Procurement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SpecificationInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SpecificationInformation">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Specification Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#StatisticalInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#StatisticalInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Statistical data on the Procedure and the Lot. Additional Information At the present time Procurement Procedures are not fully electronic. At a later date, information on the Tenders received could be inferred by the data in the eProcurement System. Therefore this class is temporal and should cease to exist in fully electronic Procurement. The need for its presence responds also to the alignment with the Regulation (EU) 2019/1780 (eForms). Attention will have to be paid in the future to possible inconsistencies derived from data placed in other classes and data held in the Statistical Information class; e.g. the TenderEvaluation class (see eEvaluation diagram) has the attribute admissibileTender indicator, which in case of being false, may enter in contradiction with the highest or lowest Tender value for that very same inadmissible Tender.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Statistical Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#StrategicProcurement -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#StrategicProcurement">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Public Procurement that contributes to achieving pressing policy goals. Additional Information: Specific strategic goals could be, for example, Environmental Protection, innovation, job creation and the development of small and medium enterprises. The subclasses are given by the choices in BT-06 Strategic Procurement. Based on https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0411 (see paragraph on &quot;background information&quot;.</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BG-713</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 10/03/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">Strategic Procurement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SubcontractTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SubcontractTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A concept to describe the main information regarding the share of parts of the Contract to third parties.</skos:definition>
        <skos:prefLabel xml:lang="en">Subcontract Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SubcontractingEstimate -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SubcontractingEstimate">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Estimate"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Approximation concerning the foreseen Subcontracting.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Subcontracting Estimate</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Subcontractor -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Subcontractor">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent that has an agreement to perform part or all of the obligations of another Agents&apos;s Contract. Additional information For some Procedures, the Subcontractor signs as well the Contract between the Buyer and the Contractor. At tendering time, entities relied upon by the Economic Operators can be Subcontractors or not. When modelling ESPD we will analyze whether we need or not a Role named &quot;relied upon&quot;.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Subcontractor</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SubmissionStatisticalInformation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SubmissionStatisticalInformation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StatisticalInformation"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Statistical information about submissions on a given competition, either at Lot level or Mini-Competition level.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Submission Statistical Information</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#SubmissionTerm -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SubmissionTerm">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Conditions and stipulations defining particularities of submitting Documents to the Buyer. Additional Information: These Documents can be Tenders, Request To Participate and expressions of interest.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 14/07/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">Submission Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#System -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#System">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Software application used for performing Procurement activities.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">System</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#TaxDocumentation -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TaxDocumentation">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Documentation"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Tax Documentation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#TaxInformationProvider -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TaxInformationProvider">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for providing information concerning the general regulatory framework for taxes.</skos:definition>
        <skos:prefLabel xml:lang="en">Tax Information Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#TechnicalAbilitySummary -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TechnicalAbilitySummary">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Overview of the expertise required for the economic operator to execute the contract.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">Technical Ability Summary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#TechnicalSpecification -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TechnicalSpecification">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A set of documented Requirements applicable to the object of the Procurement. Additional Information: A specification often includes technical standards.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 20/04/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Technical Specification</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Technique -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Technique">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Method used for conducting Procurement Procedures. Several Techniques can be combined in one single Procurement Procedure (e.g. eAuction can be carried out in a Framework Agreement or DPS).</skos:definition>
        <skos:editorialNote xml:lang="en">Used by eForms BG-706</skos:editorialNote>
        <skos:historyNote xml:lang="en">WG Approval 19/09/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Technique</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Tender -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Tender">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Information submitted by the Economic Operator to specify its Offer regarding a specific Lot, in response to the call for Tender.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 03/05/2022</skos:historyNote>
        <skos:prefLabel xml:lang="en">Tender</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#TenderAwardOutcome -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderAwardOutcome">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextualProjection"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Result concerning the Tender attributed by the Awarder.</skos:definition>
        <skos:prefLabel xml:lang="en">Tender Award Outcome</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#TenderGroup -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderGroup">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">Specific Offer in response to a Lot Group. Additional Information: This class is generally used to provide the Monetary Value in response to a Lot Group.</skos:definition>
        <skos:prefLabel xml:lang="en">Tender Group</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#TenderProcessor -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderProcessor">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for processing Tenders.</skos:definition>
        <skos:prefLabel xml:lang="en">Tender Processor</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#TenderReceiver -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderReceiver">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent responsible for receiving Tenders.</skos:definition>
        <skos:prefLabel xml:lang="en">Tender Receiver</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Tenderer -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Tenderer">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent that has submitted a Tender. Additional Information: A Tenderer is an Economic Operator or group of Economic Operators that has submitted a Tender.</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Tenderer</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Term -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Term">
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A governing condition or stipulation.</skos:definition>
        <skos:prefLabel xml:lang="en">Term</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#UniqueResponsibleOfTheProcurement -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#UniqueResponsibleOfTheProcurement">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:prefLabel xml:lang="en">Unique Responsible Of The Procurement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/a4g/ontology#Winner -->

    <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Winner">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <skos:definition xml:lang="en">A Role of an Agent to whom a Lot is awarded.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 26/10/2021</skos:historyNote>
        <skos:prefLabel xml:lang="en">Winner</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/Channel -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/Channel">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/Channel&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/Channel&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; Additional Information Software solutions and electronic devices for communication and exchange of information between Buyers and economic Operators. Lots may use ad-hoc electronic means of communication that are not generally available such as specific solutions for secure and dedicated communication or non-standard eCatalogues. See also Directive recitals 53 to 56.</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 14/02/2023</skos:historyNote>
        <skos:prefLabel xml:lang="en">Channel</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/Constraint -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/Constraint">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/Constraint&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/Constraint&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
        <skos:prefLabel xml:lang="en">Constraint</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/ContactPoint -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/ContactPoint">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/ContactPoint&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/ContactPoint&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
        <skos:historyNote xml:lang="en">WG approval 5/11/2019</skos:historyNote>
        <skos:prefLabel xml:lang="en">Contact Point</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/Criterion -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/Criterion">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/Criterion&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/Criterion&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
        <skos:prefLabel xml:lang="en">Criterion</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/Evidence -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/Evidence">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/Evidence&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/Evidence&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
        <skos:prefLabel xml:lang="en">Evidence</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/InformationConcept -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/InformationConcept">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/InformationConcept&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/InformationConcept&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
        <skos:prefLabel xml:lang="en">Information Concept</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/InformationRequirement -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/InformationRequirement">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Requirement"/>
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/InformationRequirement&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/InformationRequirement&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
        <skos:prefLabel xml:lang="en">Information Requirement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/PublicOrganisation -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/PublicOrganisation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/PublicOrganisation&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/PublicOrganisation&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
        <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
        <skos:prefLabel xml:lang="en">Public Organisation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://data.europa.eu/m8g/Requirement -->

    <owl:Class rdf:about="http://data.europa.eu/m8g/Requirement">
        <skos:definition xml:lang="en">External concept defined by &lt;xref scope=&quot;external&quot; href=&quot;http://data.europa.eu/m8g/Requirement&quot;&gt;&lt;foreign otherprops=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/Requirement&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; Additional Information: To stay consistent to how identification is realised in the eProcurement ontology, we switch to using `adms:identifier` instead of `dct:identifier` as per CCCEV specification.</skos:definition>
        <skos:prefLabel xml:lang="en">Requirement</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.org/dc/dcam/VocabularyEncodingScheme -->

    <owl:Class rdf:about="http://purl.org/dc/dcam/VocabularyEncodingScheme"/>
    


    <!-- http://purl.org/dc/terms/Agent -->

    <owl:Class rdf:about="http://purl.org/dc/terms/Agent"/>
    


    <!-- http://purl.org/dc/terms/AgentClass -->

    <owl:Class rdf:about="http://purl.org/dc/terms/AgentClass">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    </owl:Class>
    


