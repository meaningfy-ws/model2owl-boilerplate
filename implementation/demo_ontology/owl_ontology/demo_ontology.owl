        <skos:definition xml:lang="en">Subject of the acquisition.</skos:definition>
        <skos:prefLabel xml:lang="en">has Contract Nature Type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasContractValue -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasContractValue">
