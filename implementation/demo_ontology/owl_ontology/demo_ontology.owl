        <skos:historyNote xml:lang="en">WG Approval 16/07/2024</skos:historyNote>
        <skos:prefLabel xml:lang="en">has Despatch Period</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://data.europa.eu/a4g/ontology#hasDespatchedQuantity -->

    <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchedQuantity">
