  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/award-criterion-type">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <owl:equivalentClass rdf:nodeID="N45636532267e4fbfa2812ef8e84aa0b5"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">This table provides the list of rules to be taken into account for the Award Decisions within the in public Procurement Procedures. The initial values are those foreseen in the public procurement directives of 2014 (Directives 2014/23/EU, 2014/24/EU and 2014/25/EU).</skos:definition>
    <skos:prefLabel xml:lang="en">award-criterion-type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/other-place-service">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
