    <skos:prefLabel xml:lang="en">full Address</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/m8g/bias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Criterion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">Parameter used to adjust the evaluation of the Criterion.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
    <rdfs:label xml:lang="en">bias</rdfs:label>
    <skos:definition xml:lang="en">External concept defined by &lt;xref scope="external" href="http://data.europa.eu/m8g/bias"&gt;&lt;foreign otherprops="#0000ff"&gt;&lt;u&gt;http://data.europa.eu/m8g/bias&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; (cccev:Criterion)</skos:definition>
    <skos:prefLabel xml:lang="en">bias</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The bias parameter tries to correct a systematic error. For example in procurement, a home bias corresponds to the "presence of local preferences distorting international specialisation and resource allocation". When quantified, this systematic error can be removed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTenderValidityPeriod">
