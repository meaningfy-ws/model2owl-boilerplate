  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/rights">
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/rights"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-01-14</dcterms:issued>
    <dcam:rangeIncludes rdf:resource="http://purl.org/dc/terms/RightsStatement"/>
    <dcterms:description xml:lang="en">Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights.  Recommended practice is to refer to a rights statement with a URI.  If this is not possible or feasible, a literal value (name, label, or short text) may be provided.</dcterms:description>
    <rdfs:comment xml:lang="en">Information about rights held in and over the resource.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
    <rdfs:label xml:lang="en">Rights</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/m8g/crs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/locn#Geometry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:comment xml:lang="en">An identifier for the coordinate reference system.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
    <rdfs:label xml:lang="en">crs</rdfs:label>
    <skos:scopeNote xml:lang="en">Can be a coordinate-based local, regional or global system used to locate geographical entities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfCandidates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#MultipleStageProcedureTerm"/>
