  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesDecisionFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#QualificationDecisionInformation"/>
