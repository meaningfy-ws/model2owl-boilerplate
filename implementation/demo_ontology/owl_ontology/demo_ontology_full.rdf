  <rdf:Description rdf:about="http://data.europa.eu/m8g/hasEvidenceTypeList">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://data.europa.eu/m8g/Requirement"/>
    <rdfs:range rdf:resource="http://data.europa.eu/m8g/EvidenceTypeList"/>
    <rdfs:comment xml:lang="en">Evidence Type List that specifies the Evidence Types that are needed to meet the Requirement.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
    <rdfs:label xml:lang="en">has evidence type list</rdfs:label>
    <skos:definition xml:lang="en">External concept defined by &lt;xref scope="external" href="http://data.europa.eu/m8g/hasEvidenceTypeList"&gt;&lt;foreign otherprops="#0000ff"&gt;&lt;u&gt;http://data.europa.eu/m8g/hasEvidenceTypeList&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt; Additional Information: One or several Lists of Evidence Types can support a Requirement. At least one of them must be satisfied by the response to the Requirement.</skos:definition>
    <skos:prefLabel xml:lang="en">has Evidence Type List</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One or several Lists of Evidence Types can support a Requirement. At least  one of them must be satisfied by the response to the Requirement.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/m8g/Constraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Requirement"/>
    <rdfs:subClassOf rdf:nodeID="Ned21d378301e438c8070c5164444eab1"/>
    <rdfs:comment xml:lang="en">Limitation applied to an Information Concept.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
    <rdfs:label xml:lang="en">Constraint</rdfs:label>
    <skos:definition xml:lang="en">External concept defined by &lt;xref scope="external" href="http://data.europa.eu/m8g/Constraint"&gt;&lt;foreign otherprops="#0000ff"&gt;&lt;u&gt;http://data.europa.eu/m8g/Constraint&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
    <skos:prefLabel xml:lang="en">Constraint</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Constraints are requirements in themselves, since they impose prerequisites which influence the definition, use and/or fulfilment of the requirement. They represent hard conditions such as minimum or maximum expressions which can be used to evaluate pieces of information, the required age, income, involvement in activities, etc. An example from the eProcurement domain is a threshold as the minimum turnover required by the buying organisation to select the candidates. Note that CCCEV does not provide any specific guidance on when which kind of Requirement should be used. Users of this vocabulary should make decisions on this topic in their specific context.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumParticipantsNumber">
