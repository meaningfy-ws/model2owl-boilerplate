  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology-3.1.0"/>
    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/locn"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/person"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-04</dcterms:created>
    <dcterms:description xml:lang="en">This artefact consolidates both the definitions (OWL core) and the restrictions and inference-related specifications (OWL restrictions) of the eProcurement Ontology Core into a single self-contained ontology.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-29</dcterms:issued>
    <dcterms:license>CC BY 4.0</dcterms:license>
    <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
    <dcterms:title xml:lang="en">ePO Core full</dcterms:title>
    <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
    <rdfs:comment>This version is automatically generated from demo_ontology.xml on 2026-06-29</rdfs:comment>
    <rdfs:label xml:lang="en">This artefact consolidates both the definitions (OWL core) and the restrictions and inference-related specifications (OWL restrictions) of the eProcurement Ontology Core into a single self-contained ontology.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency.</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/EPO/latest/index.html"/>
    <rdfs:seeAlso rdf:resource="https://github.com/eprocurementontology/eprocurementontology"/>
    <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
    <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
    <owl:incompatibleWith>2.1.0</owl:incompatibleWith>
    <owl:priorVersion>http://data.europa.eu/a4g/ontology-3.0.1</owl:priorVersion>
    <owl:versionInfo>3.1.0</owl:versionInfo>
  </rdf:Description>
