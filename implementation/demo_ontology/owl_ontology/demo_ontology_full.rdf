  <rdf:Description rdf:about="http://purl.org/dc/terms/subject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/subject"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-01-14</dcterms:issued>
    <dcterms:description xml:lang="en">Recommended practice is to refer to the subject with a URI. If this is not possible or feasible, a literal value that identifies the subject may be provided. Both should preferably refer to a subject in a controlled vocabulary.</dcterms:description>
    <rdfs:comment xml:lang="en">A topic of the resource.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
    <rdfs:label xml:lang="en">Subject</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractorsProposedAboveObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#SubcontractTerm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Subcontractors Proposed Above Obligation</skos:prefLabel>
  </rdf:Description>
