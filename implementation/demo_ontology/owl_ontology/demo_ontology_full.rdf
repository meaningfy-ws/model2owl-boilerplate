  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/environmental-impact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <owl:equivalentClass rdf:nodeID="Nce2a1b48a0d1442197c0b1a63adebc45"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">This table provides the information about whether a Procurement includes a process to procure goods, services and works with a reduced Environmental Impact throughout their life cycle.</skos:definition>
    <skos:prefLabel xml:lang="en">environmental-impact</skos:prefLabel>
  </rdf:Description>
