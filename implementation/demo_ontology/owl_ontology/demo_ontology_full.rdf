    <skos:definition xml:lang="en">A counted number of non-monetary units possibly including fractions.</skos:definition>
    <skos:prefLabel xml:lang="en">Quantity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesOrganisationFinancialCapability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://data.europa.eu/a4g/ontology#OrganisationInformationSummary"/>
