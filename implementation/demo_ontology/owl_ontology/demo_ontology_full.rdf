    <rdfs:label xml:lang="en">has concept</rdfs:label>
    <skos:definition xml:lang="en">External concept defined by &lt;xref scope="external" href="http://data.europa.eu/m8g/hasConcept"&gt;&lt;foreign otherprops="#0000ff"&gt;&lt;u&gt;http://data.europa.eu/m8g/hasConcept&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
