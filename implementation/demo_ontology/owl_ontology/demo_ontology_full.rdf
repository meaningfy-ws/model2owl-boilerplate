    <skos:prefLabel xml:lang="en">form-type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc3ea9259eb0243dda2476b843e9423d8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/locn#geographicName"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
