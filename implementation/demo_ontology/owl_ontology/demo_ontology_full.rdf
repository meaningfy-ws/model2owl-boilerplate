    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
    <rdfs:label xml:lang="en">gender</rdfs:label>
    <skos:scopeNote xml:lang="en">The gender of an individual should be recorded using a controlled vocabulary that is appropriate for the specific context. In some cases, the chromosomal or physical state of an individual will be more important than the gender that they express, in others the reverse will be true. What is always important is that the controlled vocabulary used to describe an individual's gender is stated explicitly.</skos:scopeNote>
  </rdf:Description>
