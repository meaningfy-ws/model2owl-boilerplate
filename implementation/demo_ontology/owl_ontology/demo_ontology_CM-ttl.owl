<http://data.europa.eu/nuts/code/CZ> a owl:NamedIndividual ;
    skos:inScheme <http://data.europa.eu/nuts> ;
    skos:topConceptOf <http://data.europa.eu/nuts> .

<http://data.europa.eu/nuts/code/DE> a owl:NamedIndividual ;
