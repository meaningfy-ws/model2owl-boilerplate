        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-hasChangeReasonDescription"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-hasProcurementDocumentChangeDate"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-isProcurementDocumentChanged"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-refersToPreviousNotice"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-relatesToEFormSectionIdentifier"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#ChangeInformation"/>
    </owl:NamedIndividual>
    


