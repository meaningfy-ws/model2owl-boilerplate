        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#MonetaryValue"/>
        <sh:description>The highest received tender value for the procurement. Additional Information: This corresponds to section II.1.7.3. according to Regulation (EU) 2015/1986.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has procurement highest received tender value</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasProcurementHighestReceivedTenderValue"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasProcurementHighestReceivedTenderValue&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasProcurementHighestReceivedTenderValue&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
