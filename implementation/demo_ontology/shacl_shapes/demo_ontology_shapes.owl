&lt;ul&gt;
&lt;li&gt;- 1980-09-16^^xs:date&lt;/li&gt;
&lt;li&gt;- 1980-09^^xs:gYearMonth&lt;/li&gt;
&lt;li&gt;- 1980^^xs:gYear&lt;/li&gt;
&lt;/ul&gt;</skos:scopeNote>
    </rdf:Description>
