        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-NoticeAwardInformation-epo-describesResultNotice"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-NoticeAwardInformation-epo-hasApproximateFrameworkAgreementValue"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-NoticeAwardInformation-epo-hasMaximumFrameworkAgreementAwardedValue"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-NoticeAwardInformation-epo-hasProcurementHighestReceivedTenderValue"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-NoticeAwardInformation-epo-hasProcurementLowestReceivedTenderValue"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-NoticeAwardInformation-epo-hasTotalAwardedValue"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#NoticeAwardInformation"/>
