        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasTenderValidityPeriod"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasVariantPermission"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-isAdvancedElectronicSignatureRequired"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-isGuaranteeRequired"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-isMultipleTenderSubmissionAllowed"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#SubmissionTerm"/>
