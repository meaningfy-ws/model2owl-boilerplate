    <rdf:Description rdf:about="http://data.europa.eu/m8g/birthDate">
        <rdfs:comment xml:lang="en">The point in time on which the Person was born.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/m8g"/>
        <rdfs:label xml:lang="en">date of birth</rdfs:label>
        <skos:scopeNote xml:lang="en">The date of birth could be expressed as date, gYearMonth or gYear, example:
&lt;ul&gt;
&lt;li&gt;- 1980-09-16^^xs:date&lt;/li&gt;
&lt;li&gt;- 1980-09^^xs:gYearMonth&lt;/li&gt;
&lt;li&gt;- 1980^^xs:gYear&lt;/li&gt;
&lt;/ul&gt;</skos:scopeNote>
    </rdf:Description>
    <rdf:Description rdf:about="http://data.europa.eu/m8g/deathDate">
