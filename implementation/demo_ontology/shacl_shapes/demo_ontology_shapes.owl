    <rdf:Description rdf:about="http://purl.org/dc/terms/subject">
        <dct:description xml:lang="en">Recommended practice is to refer to the subject with a URI. If this is not possible or feasible, a literal value that identifies the subject may be provided. Both should preferably refer to a subject in a controlled vocabulary.</dct:description>
