    <!-- http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPartShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPartShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>A subdivision of a Planned Procurement that may later become one or more Lots or a self-standing Procedure. A Lot or a Procedure can also cover one or more parts of the Planned Procurement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Planned Procurement Part</rdfs:label>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPart-epo-foreseesProcurementObject"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPart-epo-foreseesTechnique"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPart-epo-hasPlannedDuration"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPart-epo-hasPlannedPeriod"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#PlannedProcurementPart"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementShape -->

