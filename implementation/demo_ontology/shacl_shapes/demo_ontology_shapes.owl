        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#definesPaymentExecutor&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#definesPaymentExecutor&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


