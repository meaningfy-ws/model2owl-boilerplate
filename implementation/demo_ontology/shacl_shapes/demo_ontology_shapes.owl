        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#canProvideNonDiscriminatoryEvidence"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#canProvideNonDiscriminatoryEvidence&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#canProvideNonDiscriminatoryEvidence&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#org-Organization-epo-exposesChannel -->

