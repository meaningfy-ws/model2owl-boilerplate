        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <sh:description>The date and time of the change.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has procurement document change date</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasProcurementDocumentChangeDate"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-isProcurementDocumentChanged -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-isProcurementDocumentChanged">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <sh:description>One or more procurement documents have been changed.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Is procurement document changed</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#isProcurementDocumentChanged"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-refersToPreviousNotice -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-refersToPreviousNotice">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Notice"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name>Refers to previous notice</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#refersToPreviousNotice"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#refersToPreviousNotice&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#refersToPreviousNotice&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


