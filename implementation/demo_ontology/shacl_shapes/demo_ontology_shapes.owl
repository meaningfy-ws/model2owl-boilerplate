        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasSourceSpecificationCustomisation"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasSourceSpecificationCustomisation&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasSourceSpecificationCustomisation&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


