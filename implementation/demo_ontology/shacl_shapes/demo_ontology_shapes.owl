    <!-- http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasCleanVehicles -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasCleanVehicles">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <sh:description>The number of all clean vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has clean vehicles</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasCleanVehicles"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasTotalVehicles -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasTotalVehicles">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <sh:description>The number of all vehicles (regardless of whether clean or not) that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has total vehicles</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasTotalVehicles"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasZeroEmissionVehicles -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasZeroEmissionVehicles">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <sh:description>The number of all zero-emission heavy-duty vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has zero emission vehicles</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasZeroEmissionVehicles"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-specifiesCleanVehicleDirectiveContractType -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-specifiesCleanVehicleDirectiveContractType">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Specifies clean vehicle directive contract type</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#specifiesCleanVehicleDirectiveContractType"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-specifiesCleanVehicleDirectiveVehicleCategory -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-specifiesCleanVehicleDirectiveVehicleCategory">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Specifies clean vehicle directive vehicle category</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#specifiesCleanVehicleDirectiveVehicleCategory"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformationShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformationShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>Information related to clean vehicles legislation. Additional information: In the European Union, the legislation concerned is the European Parliament and Council 2009/33/EC (Clean Vehicles Directive ï¿½ CVD).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Clean Vehicle Directive Information</rdfs:label>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-concernsGreenProcurement"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasCleanVehicles"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasTotalVehicles"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasZeroEmissionVehicles"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-specifiesCleanVehicleDirectiveContractType"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-specifiesCleanVehicleDirectiveVehicleCategory"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#CleanVehicleDirectiveInformation"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ConcessionContract-epo-resultsFromLotAwardOutcome -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ConcessionContract-epo-resultsFromLotAwardOutcome">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#LotAwardOutcome"/>
        <sh:description>Relation to indicate that a given type of Contract is a consequence of a given LotAwardOutcome.</sh:description>
        <sh:name>Results from lot award outcome</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#resultsFromLotAwardOutcome"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#resultsFromLotAwardOutcome&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#resultsFromLotAwardOutcome&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ConcessionContractShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ConcessionContractShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>A Contract between one or more Buyers and one or more Economic Operators giving the right to the Economic Operators to exploit the rights foreseen in the Contract which may include the receipt of Payments.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Concession Contract</rdfs:label>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ConcessionContract-epo-resultsFromLotAwardOutcome"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#ConcessionContract"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasCalculationMethod -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasCalculationMethod">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:description>Formula for obtaining values. Additional Information: The possible values are monetary values, ranking scores, criterion weighting.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has calculation method</sh:name>
        <sh:or>
            <rdf:Description/>
        </sh:or>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasCalculationMethod"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasConcessionEstimatedValue -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasConcessionEstimatedValue">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#MonetaryValue"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has concession estimated value</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasConcessionEstimatedValue"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasConcessionEstimatedValue&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasConcessionEstimatedValue&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasEstimatedBuyerConcessionRevenue -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasEstimatedBuyerConcessionRevenue">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#MonetaryValue"/>
        <sh:description>The expected payments made by the buyer to the economic operator awarded the concession that are not directly related to the use of the concession. &lt;u&gt;Additional Information:&lt;/u&gt; For example the public buyer pays a yearly fee to provide a ticketing solution to the public. The fee the public pays for every ticket sold through the solution is not included in this estimation but in the estimation of the user concession revenue.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has estimated buyer concession revenue</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasEstimatedBuyerConcessionRevenue"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasEstimatedBuyerConcessionRevenue&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasEstimatedBuyerConcessionRevenue&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasEstimatedUserConcessionRevenue -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasEstimatedUserConcessionRevenue">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#MonetaryValue"/>
        <sh:description>The estimated revenue coming from the use of the concession. Additional Information: Revenues are for example fees and fines. For example, the fees and fines coming from the cars using a motorway.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has estimated user concession revenue</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasEstimatedUserConcessionRevenue"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasEstimatedUserConcessionRevenue&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasEstimatedUserConcessionRevenue&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimateShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimateShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>Approximation concerning the foreseen Concession Contract.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Concession Estimate</rdfs:label>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasCalculationMethod"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasConcessionEstimatedValue"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasEstimatedBuyerConcessionRevenue"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ConcessionEstimate-epo-hasEstimatedUserConcessionRevenue"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#ConcessionEstimate"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ContextDescriptionShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ContextDescriptionShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>A description concerning a Procurement Object or a Notice in a specific Situation Context. Additional Information: The description has its own identity (+I) but is dependent (+D) on the concerned Entity. We say that ContextDescription *concerns* an Entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Context Description</rdfs:label>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ContextualProjectionShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ContextualProjectionShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>Projection of an Entity and all of its properties that hold in a given Situation Context. Additional Information: The contextual projection does not have its own identity (-I), is dependent (+D) on the described Entity, and is anti-rigid (~R) We say that ContextualProjection *describes* an Entity. Adaptation of ContextSlices pattern encoding a 4D view. http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Contextual Projection</rdfs:label>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#ContextualProjection"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Contract-epo-bindsBuyer -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Contract-epo-bindsBuyer">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Buyer"/>
        <sh:description>Provides legal constraint on the Buyer.</sh:description>
        <sh:name>Binds buyer</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#bindsBuyer"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#bindsBuyer&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#bindsBuyer&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Contract-epo-bindsContractor -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Contract-epo-bindsContractor">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Contractor"/>
        <sh:description>Provides legal constraint on the Contractor.</sh:description>
        <sh:name>Binds contractor</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#bindsContractor"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#bindsContractor&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#bindsContractor&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasContractConclusionDate -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasContractConclusionDate">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <sh:description>The date the contract was signed by the last signatory party. &lt;u&gt;Additional Information:&lt;/u&gt; In exceptional cases contracts may be concluded without signature and therefore another date may be used. The date of contract conclusion is always later than the end of any standstill period. This concept is not to be confused with the date of completion/end of the contract.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has contract conclusion date</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasContractConclusionDate"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasContractValue -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasContractValue">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#MonetaryValue"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has contract value</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasContractValue"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasContractValue&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasContractValue&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasEntryIntoForceDate -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasEntryIntoForceDate">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <sh:description>The date on which the contract enters into force. Additional information: This is generally the date on which the fulfillment of the contract begins.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has entry into force date</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasEntryIntoForceDate"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasLotReference -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasLotReference">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Lot"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name>Has lot reference</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasLotReference"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasLotReference&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasLotReference&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasPurpose -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Contract-epo-hasPurpose">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
