    <!-- http://data.europa.eu/a4g/data-shape#epo-ParticipationRequestTerm-epo-definesParticipationRequestProcessor -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ParticipationRequestTerm-epo-definesParticipationRequestProcessor">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#ParticipationRequestProcessor"/>
        <sh:description>Relation indicating a ParticipationRequestTerm has a ParticipationRequestProcessor.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Defines participation request processor</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#definesParticipationRequestProcessor"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#definesParticipationRequestProcessor&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#definesParticipationRequestProcessor&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


