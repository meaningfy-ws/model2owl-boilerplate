    <!-- http://data.europa.eu/a4g/data-shape#epo-ParticipationConditionsSummary-epo-hasReservedProcurement -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ParticipationConditionsSummary-epo-hasReservedProcurement">
