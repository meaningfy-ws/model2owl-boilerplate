    <!-- http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPart-epo-foreseesProcurementObject -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPart-epo-foreseesProcurementObject">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementObject"/>
        <sh:description>Relation indicating the instance of a Procurement Object that is planned. Additional Information: The properties of the Procurement Object that is foreseen should be read as foreseen properties. For example, Procedure isSMESuitable should be read as Procedure foreseesToBeSMESuitable. For example, Procedure isFundedBy should be read as Procedure foreseesToBeFundedBy.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Foresees procurement object</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#foreseesProcurementObject"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#foreseesProcurementObject&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#foreseesProcurementObject&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-PlannedProcurementPart-epo-foreseesTechnique -->

