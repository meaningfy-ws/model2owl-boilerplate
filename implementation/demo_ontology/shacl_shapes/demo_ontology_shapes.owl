        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasChangeJustification"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-hasChangeReasonDescription -->

