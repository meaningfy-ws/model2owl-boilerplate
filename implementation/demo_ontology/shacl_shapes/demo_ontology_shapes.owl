        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasNonElectronicSubmissionDescription"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasNonElectronicSubmissionJustification"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasReceiptDeadline"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasReceiptExpressionDeadline"/>
