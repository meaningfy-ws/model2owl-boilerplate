        <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-04</dct:created>
        <dct:description xml:lang="en">This artefact provides the generic datashape specifications for the eProcurement Ontology Core.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency.</dct:description>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-25</dct:issued>
        <dct:license>CC BY 4.0</dct:license>
        <dct:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dct:publisher>
        <dct:title xml:lang="en">ePO Core shapes</dct:title>
        <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
        <rdfs:comment>This version is automatically generated from demo_ontology.xml on 2026-06-25</rdfs:comment>
        <rdfs:label xml:lang="en">This artefact provides the generic datashape specifications for the eProcurement Ontology Core.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency.</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/EPO/latest/index.html"/>
        <rdfs:seeAlso rdf:resource="https://github.com/eprocurementontology/eprocurementontology"/>
        <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
        <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
        <owl:incompatibleWith>2.1.0</owl:incompatibleWith>
        <owl:priorVersion>http://data.europa.eu/a4g/data-shape#core-shape-3.0.1</owl:priorVersion>
        <owl:versionInfo>3.1.0</owl:versionInfo>
    </owl:Ontology>
    


