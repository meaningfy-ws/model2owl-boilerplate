    <!-- http://data.europa.eu/a4g/data-shape#epo-ChangeInformationShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ChangeInformationShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>Added hasAdditionalInformation to cover for section VII.2 in F14, since we do not have the Corrigendum notice type anymore in eForms.</rdfs:comment>
        <rdfs:comment>Alteration to previously provided details.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Change Information</rdfs:label>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-concernsNotice"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-hasAdditionalInformation"/>
