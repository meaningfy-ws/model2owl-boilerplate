        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasReceiptPreliminaryMarketConsultationDeadline"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasReceiptTenderDeadline"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasSubmissionURL"/>
