        <sh:description>The amount of Tenders received from European Economic Area countries other than that of the Buyer.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has other countries received tenders</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasOtherCountriesReceivedTenders"/>
    </owl:NamedIndividual>
    


