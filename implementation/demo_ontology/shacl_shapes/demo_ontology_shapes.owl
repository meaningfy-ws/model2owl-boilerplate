        <sh:name>Has reserved procurement</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasReservedProcurement"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ParticipationConditionShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ParticipationConditionShape">
