        <sh:name>Is SME suitable</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#isSMESuitable"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-LotGroup-epo-isSubjectToTerm -->

