        <rdfs:label>Planned Procurement</rdfs:label>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#PlannedProcurement"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Prize-epo-hasPrizeRank -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Prize-epo-hasPrizeRank">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <sh:description>The position of the prize (e.g. first place, second place) in a design contest list of prizes.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has prize rank</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasPrizeRank"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Prize-epo-hasPrizeValue -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Prize-epo-hasPrizeValue">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#MonetaryValue"/>
        <sh:description>The monetary value of a prize, if any, for the winner (or runners-up) of the design contest.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has prize value</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasPrizeValue"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasPrizeValue&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasPrizeValue&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-PrizeShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-PrizeShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>A reward given in a Contest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Prize</rdfs:label>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Prize-epo-hasPrizeRank"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Prize-epo-hasPrizeValue"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#Prize"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasAcceleratedProcedureJustification -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasAcceleratedProcedureJustification">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:description>The reasons why the procedure is accelerated. Additional Information: A procedure is accelerated to cover needs of extraordinary circumstances ie earthquake relief.</sh:description>
        <sh:name>Has accelerated procedure justification</sh:name>
        <sh:or>
            <rdf:Description/>
        </sh:or>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasAcceleratedProcedureJustification"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasMainFeature -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasMainFeature">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:description>Main features of the procedure and information about where the full rules for the procedure can be found. Additional Information: This information should be given when the procedure is not one of those mentioned in the procurement directives. This can be the case for example for concessions, for social and other specific services, and in case of voluntary publication of procurement procedures below the EU procurement thresholds.</sh:description>
        <sh:name>Has main feature</sh:name>
        <sh:or>
            <rdf:Description/>
        </sh:or>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasMainFeature"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasProcedureType -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasProcedureType">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description>Identification of the Procedure used.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has procedure type</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasProcedureType"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasProcurementScopeDividedIntoLot -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasProcurementScopeDividedIntoLot">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Lot"/>
        <sh:description>Defines Lot.</sh:description>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name>Has procurement scope divided into lot</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasProcurementScopeDividedIntoLot"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasProcurementScopeDividedIntoLot&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasProcurementScopeDividedIntoLot&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-involvesBuyer -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-involvesBuyer">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Buyer"/>
        <sh:name>Involves buyer</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#involvesBuyer"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#involvesBuyer&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#involvesBuyer&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isAccelerated -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isAccelerated">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <sh:description>Statement about the fact that the procedure will be reduced due to a state of urgency. Additional Information This modifies the time limit for the receipt of requests to participate or the receipt of tenders.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Is accelerated</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#isAccelerated"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isDesignContest -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isDesignContest">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <sh:description>A competition which enables the buyer to acquire a plan or design via a jury. Additional information: Design contests have traditionally mostly been used in the fields of town and country planning, architecture and engineering or data processing, other purposes, such as to obtain plans for financial engineering The contest may include or not the award of prizes;</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Is design contest</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#isDesignContest"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isExecutedByProcurementServiceProvider -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isExecutedByProcurementServiceProvider">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementServiceProvider"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Is executed by procurement service provider</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#isExecutedByProcurementServiceProvider"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#isExecutedByProcurementServiceProvider&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#isExecutedByProcurementServiceProvider&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isJointProcurement -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isJointProcurement">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <sh:description>Multiple buyers procure together within the same procedure. Addition Information: In case the joint procurement involves buyers from different countries, the national law is specified by the epo:hasCrossBorderLaw in the ProcedureTerm .</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Is joint procurement</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#isJointProcurement"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isResponsibilityOfBuyer -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isResponsibilityOfBuyer">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Buyer"/>
        <sh:description>Additional Information: In case there are multiple buyers, it may be the case that one or more buyers are in charge of the procedure.</sh:description>
        <sh:name>Is responsibility of buyer</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#isResponsibilityOfBuyer"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#isResponsibilityOfBuyer&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#isResponsibilityOfBuyer&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-specifiesProcurementCriteriaSummary -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-specifiesProcurementCriteriaSummary">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary"/>
        <sh:name>Specifies procurement criteria summary</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#specifiesProcurementCriteriaSummary"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#specifiesProcurementCriteriaSummary&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#specifiesProcurementCriteriaSummary&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ProcedureShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ProcedureShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>A legally defined set of administrative activities conducted to conclude one or more Contracts. Additional Information The Procedure is categorised in the law according to different rules determining whether the Procedure is Open, Restricted, Negotiated with or without publicity, etc. (see Procedure Type).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Procedure</rdfs:label>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasAcceleratedProcedureJustification"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasMainFeature"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasProcedureType"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-hasProcurementScopeDividedIntoLot"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-involvesBuyer"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isAccelerated"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isDesignContest"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isExecutedByProcurementServiceProvider"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isJointProcurement"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-isResponsibilityOfBuyer"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-Procedure-epo-specifiesProcurementCriteriaSummary"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#Procedure"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ProcedureTerm-epo-definesBudgetProvider -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ProcedureTerm-epo-definesBudgetProvider">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#BudgetProvider"/>
        <sh:description>Relation indicating a ProcedureTerm has a BudgetProvider.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Defines budget provider</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#definesBudgetProvider"/>
        <sh:sparql>
