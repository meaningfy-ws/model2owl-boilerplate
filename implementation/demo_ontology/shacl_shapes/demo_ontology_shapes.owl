            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#concernsNotice&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#concernsNotice&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


