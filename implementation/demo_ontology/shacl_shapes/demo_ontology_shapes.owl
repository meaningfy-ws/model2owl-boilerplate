    <rdf:Description rdf:about="http://purl.org/dc/terms/source">
        <dct:description xml:lang="en">This property is intended to be used with non-literal values. The described resource may be derived from the related resource in whole or in part. Best practice is to identify the related resource by means of a URI or a string conforming to a formal identification system.</dct:description>
