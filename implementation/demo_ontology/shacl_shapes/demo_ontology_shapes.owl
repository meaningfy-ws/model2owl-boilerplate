        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <sh:description>External concept defined by &lt;a href=&quot;$inet://https://www.w3.org/TR/owl-time/#time:hasBeginning&quot;&gt;&lt;font color=&quot;#0000ff&quot;&gt;&lt;u&gt;https://www.w3.org/TR/owl-time/#time:hasBeginning&lt;/u&gt;&lt;/font&gt;&lt;/a&gt;</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has beginning</sh:name>
        <sh:path rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://www.w3.org/2006/time#hasBeginning&gt; ?that . ?that &lt;http://www.w3.org/2006/time#hasBeginning&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


