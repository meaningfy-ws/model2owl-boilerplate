        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-FrameworkAgreementTerm-epo-hasFrameworkAgreementType"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-FrameworkAgreementTerm-epo-hasMaximumParticipantsNumber"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#FrameworkAgreementTerm"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Fund-adms-identifier -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-Fund-adms-identifier">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/ns/adms#Identifier"/>
        <sh:description>External concept defined by &lt;a href=&quot;$inet://https://semiceu.github.io/ADMS/releases/2.00/#identifier&quot;&gt;&lt;font color=&quot;#0000ff&quot;&gt;&lt;u&gt;https://semiceu.github.io/ADMS/releases/2.00/#identifier&lt;/u&gt;&lt;/font&gt;&lt;/a&gt;</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Identifier</sh:name>
        <sh:path rdf:resource="http://www.w3.org/ns/adms#identifier"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://www.w3.org/ns/adms#identifier&gt; ?that . ?that &lt;http://www.w3.org/ns/adms#identifier&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-Fund-dct-description -->

