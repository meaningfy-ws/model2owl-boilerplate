        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ParticipationConditionsSummary-epo-describesVerificationMethod"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ParticipationConditionsSummary-epo-hasReservedProcurement"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#ParticipationConditionsSummary"/>
