    <!-- http://data.europa.eu/a4g/data-shape#org-Organization-epo-foreseesSubcontractor -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#org-Organization-epo-foreseesSubcontractor">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Subcontractor"/>
        <sh:description>Relation indicating that an Organization plans to have a Subcontractor. Additional information: In eForms, in a Result Notice, the foreseen Subcontractors in a Tender are associated to the Organization that proposes the Subcontractors. The Subcontractor is associated to the Organization, rather than the Tenderer, so that, in the case of multiple Organizations being a Tenderer, it is clear to which Organization the proposed Subcontractor is associated.</sh:description>
        <sh:name>Foresees subcontractor</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#foreseesSubcontractor"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#foreseesSubcontractor&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#foreseesSubcontractor&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#org-Organization-epo-hasBuyerLegalType -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#org-Organization-epo-hasBuyerLegalType">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description>A category that indicates the right of an Organisation to play the role of a buyer. Additional Information: The category also effects the rules that the buyer has to abide to within the public procurement procedure.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has buyer legal type</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasBuyerLegalType"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#org-Organization-epo-hasBuyerLegalTypeDescription -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#org-Organization-epo-hasBuyerLegalTypeDescription">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:description>Self-explanatory text about the Buyer Legal Type. Additional information: This field is used when the Buyer Legal Type is not available in the controlled list at-voc:buyer-legal-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has buyer legal type description</sh:name>
        <sh:or>
            <rdf:Description/>
        </sh:or>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasBuyerLegalTypeDescription"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#org-Organization-epo-hasInternetAddress -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#org-Organization-epo-hasInternetAddress">
