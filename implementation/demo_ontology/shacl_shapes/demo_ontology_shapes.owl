    <!-- http://data.europa.eu/a4g/data-shape#org-Organization-cv-registeredAddress -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#org-Organization-cv-registeredAddress">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/ns/locn#Address"/>
        <sh:description>External concept defined by &lt;a href=&quot;$inet://http://data.europa.eu/m8g/registeredAddress&quot;&gt;&lt;font color=&quot;#0000ff&quot;&gt;&lt;u&gt;http://data.europa.eu/m8g/registeredAddress&lt;/u&gt;&lt;/font&gt;&lt;/a&gt;</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Registered address</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/m8g/registeredAddress"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/m8g/registeredAddress&gt; ?that . ?that &lt;http://data.europa.eu/m8g/registeredAddress&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#org-Organization-epo-canProvideEvidence -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#org-Organization-epo-canProvideEvidence">
