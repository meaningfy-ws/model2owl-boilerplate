        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description>Explanation as to whether a procurement may be reserved for the participation of certain types of organisation.</sh:description>
        <sh:name>Has reserved procurement</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasReservedProcurement"/>
