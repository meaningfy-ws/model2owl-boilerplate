    <!-- http://data.europa.eu/a4g/data-shape#epo-AgentInRoleShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-AgentInRoleShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:comment>Relative concept that ties an Agent to a part they play in a given Situational Context. Additional information: The classification of roles is based is based on the degree of involvement into the Procurement Process: - Primary (Procurement) Pole is directly involved in the Procurement Process; - Secondary (Procurement sub-) Role is secondary to the Procurement Process - Tertiary (Related) Role is not involved in the Procurement Process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <rdfs:label>Agent In Role</rdfs:label>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-AgentInRole-dct-description"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-AgentInRole-dct-title"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-AgentInRole-epo-contextualisedBy"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-AgentInRole-epo-exposesChannel"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-AgentInRole-epo-hasContactPointInRole"/>
        <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-AgentInRole-epo-playedBy"/>
        <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#AgentInRole"/>
    </owl:NamedIndividual>
    


