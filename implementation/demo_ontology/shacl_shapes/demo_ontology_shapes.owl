        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#definesTenderProcessor"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#definesTenderProcessor&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#definesTenderProcessor&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


