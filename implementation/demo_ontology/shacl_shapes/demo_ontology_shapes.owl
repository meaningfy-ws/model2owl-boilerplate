            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasTenderValidityDuration&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasTenderValidityDuration&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


