    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ParticipationRequestTerm-epo-definesParticipationRequestReceiver">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#ParticipationRequestReceiver"/>
        <sh:description>Relation indicating a ParticipationRequestTerm has a ParticipationRequestReceiver.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Defines participation request receiver</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#definesParticipationRequestReceiver"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#definesParticipationRequestReceiver&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#definesParticipationRequestReceiver&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ParticipationRequestTermShape -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ParticipationRequestTermShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
