                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#hasPlannedPeriod&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#hasPlannedPeriod&gt; ?this .}</sh:select>
            </rdf:Description>
