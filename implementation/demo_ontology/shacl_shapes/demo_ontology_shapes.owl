        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description>The extent to which electronic catalogues may be used in tenders.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has E catalogue permission</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasECataloguePermission"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasESubmissionPermission -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasESubmissionPermission">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description>The requirements as to what extent electronic submission is allowed.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has E submission permission</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasESubmissionPermission"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasGuaranteeDescription -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasGuaranteeDescription">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:description>Information on the financial commitment required from the economic operator. Additional Information: 1. This information may include the amount and the way of delivering of the guarantee 2. The financial commitment may be retained by the buyer in the case the tenderer withdraws the submitted information (i.e. tender, expression of interest and request for participation, but not request for clarifications) before the award of the contract or does not sign the contract. 3. Usual modalities are bonds, cheques, loans, other.</sh:description>
        <sh:name>Has guarantee description</sh:name>
        <sh:or>
            <rdf:Description/>
        </sh:or>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasGuaranteeDescription"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasLanguage -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasLanguage">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description>Language in which the submitted information is to be expressed.</sh:description>
        <sh:name>Has language</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasLanguage"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasLateSubmissionInformationDescription -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasLateSubmissionInformationDescription">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:description>A narrative text explaining the content of the economic operator information that can be submitted late. Additional Information This does not apply to requests for clarifications.</sh:description>
        <sh:name>Has late submission information description</sh:name>
        <sh:or>
            <rdf:Description/>
        </sh:or>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasLateSubmissionInformationDescription"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasLateSubmissionPermission -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasLateSubmissionPermission">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description>Whether economic operator-related information can be supplemented even after the submission deadline. Additional Information This is specific to the information on the economic operator and not the actual offer. This does not apply to the requests for clarification.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:name>Has late submission permission</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasLateSubmissionPermission"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasNonElectronicSubmissionDescription -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasNonElectronicSubmissionDescription">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
        <sh:description>Textual explanation of how non-electronic information is to be presented.</sh:description>
        <sh:name>Has non electronic submission description</sh:name>
        <sh:or>
            <rdf:Description/>
        </sh:or>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasNonElectronicSubmissionDescription"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasNonElectronicSubmissionJustification -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-SubmissionTerm-epo-hasNonElectronicSubmissionJustification">
