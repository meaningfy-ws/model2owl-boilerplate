            <rdf:Description/>
        </sh:or>
        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasChangeReasonDescription"/>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-hasProcurementDocumentChangeDate -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#epo-ChangeInformation-epo-hasProcurementDocumentChangeDate">
