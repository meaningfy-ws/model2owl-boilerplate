        <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#canProvideEvidence"/>
        <sh:sparql>
            <rdf:Description>
                <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#canProvideEvidence&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#canProvideEvidence&gt; ?this .}</sh:select>
            </rdf:Description>
        </sh:sparql>
    </owl:NamedIndividual>
    


    <!-- http://data.europa.eu/a4g/data-shape#org-Organization-epo-canProvideNonDiscriminatoryEvidence -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/a4g/data-shape#org-Organization-epo-canProvideNonDiscriminatoryEvidence">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
