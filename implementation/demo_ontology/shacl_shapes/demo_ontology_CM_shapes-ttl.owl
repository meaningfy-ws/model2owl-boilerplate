    sh:name "has Currency Code List Agency Name" ;
    sh:or [ ] ;
    sh:path :hasCurrencyCodeListAgencyName .

core-shape:epo-MonetaryValue-epo-hasCurrencyCodeListID a owl:NamedIndividual,
        sh:PropertyShape ;
