    sh:name "has Followup Contract Information" ;
    sh:or [ ] ;
    sh:path :hasFollowupContractInformation .

core-shape:epo-DesignContestRegimeTerm-epo-hasParticipationPayment a owl:NamedIndividual,
        sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
    sh:description "Details on payments to participants WG Approval 09/11/2021" ;
    sh:maxCount 1 ;
    sh:name "has Participation Payment" ;
    sh:or [ ] ;
    sh:path :hasParticipationPayment .

