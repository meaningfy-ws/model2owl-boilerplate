    sh:name "is Subject To Lot Specific Term" ;
    sh:path :isSubjectToLotSpecificTerm ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSubjectToLotSpecificTerm> ?that . ?that <http://data.europa.eu/a4g/ontology#isSubjectToLotSpecificTerm> ?this .}" ] .

core-shape:epo-Lot-epo-specifiesProcurementCriterion a owl:NamedIndividual,
