    sh:maxCount 1 ;
    sh:name "has Followup Contract" ;
    sh:path :hasFollowupContract .

core-shape:epo-DesignContestRegimeTerm-epo-hasFollowupContractInformation a owl:NamedIndividual,
        sh:PropertyShape ;
    rdfs:isDefinedBy core-shape:core-shape ;
