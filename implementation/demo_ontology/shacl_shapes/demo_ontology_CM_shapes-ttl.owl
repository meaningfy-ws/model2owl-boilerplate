    sh:name "has Currency Code List Agency ID" ;
    sh:or [ ] ;
    sh:path :hasCurrencyCodeListAgencyID .

core-shape:epo-MonetaryValue-epo-hasCurrencyCodeListAgencyName a owl:NamedIndividual,
